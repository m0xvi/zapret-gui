<UserControl x:Class="ZapretGui.Views.MonitoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly" Padding="0,0,4,24">
    <Grid Margin="24,20,20,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource DisplayText}" Text="Мониторинг" />
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Проверяет ресурсы в фоне и объясняет, что именно не работает: провайдер, сервер или стратегия" />
            </StackPanel>
            <WrapPanel Grid.Column="1" MaxWidth="340" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource PrimaryButton}" Content="Проверить сейчас" Command="{Binding CheckAllCommand}"
                        ToolTip="Проверить все включённые ресурсы без остановки обхода" />
                <Button Style="{StaticResource SecondaryButton}" Content="Определить причину" Margin="8,0,0,0"
                        Command="{Binding DiagnoseCommand}"
                        ToolTip="Сравнить ресурс без обхода и с текущей стратегией. Обход будет кратко перезапущен." />
                <Border Style="{StaticResource BusySpinner}" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,16,0,12">
            <Border CornerRadius="10" Padding="14,11"
                    Background="{Binding MessageKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <Border CornerRadius="10" Padding="14,11" Margin="0,8,0,0"
                    Background="{DynamicResource ElevatedBrush}"
                    Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProgressText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProgressPercentText}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ThinProgress}"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                 IsIndeterminate="False" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="14,11" Margin="0,8,0,0"
                    Background="{Binding DiagnosisKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding DiagnosisVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding DiagnosisText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,4,8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionText}" Text="РЕСУРСЫ" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding LastCheckText}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="＋ Ресурс" Padding="8,3" FontSize="11"
                                    Command="{Binding AddResourceCommand}" ToolTip="Добавить ресурс в мониторинг" />
                            <Button Style="{StaticResource GhostButton}" Content="↗ В обход" Padding="8,3" FontSize="11" Margin="6,0,0,0"
                                    Command="{Binding AddToBypassListCommand}" ToolTip="Добавить домен в обход (list-general-user.txt)" />
                        </WrapPanel>
                    </Grid>
                    <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding Targets}"
                             SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" Background="Transparent"
                             ItemContainerStyle="{StaticResource CompactRowItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                                              ToolTip="Включить ресурс в фоновую проверку" />
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding Url}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                            Command="{Binding DataContext.RemoveResourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                            ToolTip="Убрать пользовательский ресурс из мониторинга" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Дублирующие блоки удалены 24.09 — управление ресурсами теперь в шапке, результаты показываются внутри строки ресурса, ссылки ведут на единый инструмент Проверка -->
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource DimText}" FontSize="11" Opacity="0.7" Text="Результаты теперь справа от ресурса (в том же списке выше)." VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Content="Единый инструмент — Проверка →" Padding="8,3" FontSize="11" Margin="8,0,0,0"
                        Command="{Binding OpenUnifiedCheckCommand}" ToolTip="Перейти к единому инструменту проверки (Экспресс/DPI/DeepCheck)" />
            </StackPanel>
        </StackPanel>
            <!-- Нижний отступ для свободного места снизу -->
        <Border Height="12" Opacity="0" />
    </Grid>
    </ScrollViewer>
</UserControl>
