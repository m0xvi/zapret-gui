<UserControl x:Class="ZapretGui.Views.DeepCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly" Padding="0,0,4,0">
        <StackPanel Margin="24,20,20,26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Глубокая проверка" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Полный профиль конкретной сети: Windows, движок, DNS, TCP, TLS, DPI, метрики и все стратегии." TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource PrimaryButton}" Content="Запустить глубокую проверку"
                            Command="{Binding RunCommand}"
                            ToolTip="Проверить условия, параметры, сеть и все стратегии с видимым прогрессом" />
                    <Button Style="{StaticResource DangerButton}" Content="Остановить" Margin="8,0,0,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource GhostButton}" Content="Экспорт JSON" Margin="8,0,0,0"
                            Command="{Binding ExportCommand}"
                            ToolTip="Сохранить измерения, рекомендации и ограничения провайдера без секретов" />
                </WrapPanel>
            </Grid>

            <Border CornerRadius="10" Padding="14,11" Margin="0,16,0,0"
                    Background="{Binding SummaryKey, Converter={StaticResource SoftSeverityBrush}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Summary}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding LastCheckText}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding SavedReportText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,0" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource DimText}" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProgressPercentText}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding ProgressValue}" Maximum="100"
                                 IsIndeterminate="{Binding ProgressIndeterminate}" Height="7" Margin="0,8,0,0"
                                 Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="14,11" Margin="0,10,0,0"
                    Background="{Binding SummaryKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="ПАРАМЕТРЫ ПРОБЫ" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Пользовательский HTTPS-узел необязателен. Если поле пустое, проверяется внешний набор контрольных узлов. Их операторы не являются вашим интернет-провайдером." TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DimText}" Text="Пользовательский HTTPS-хост" Margin="0,10,0,0" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding CustomHost, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,0" ToolTip="Например, https://example.com или собственный HTTPS-хост" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="ПРОВАЙДЕР И ОГРАНИЧЕНИЯ" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProviderContext}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding ProviderLimitations}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ЛОКАЛЬНЫЕ ПРИЗНАКИ" />
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding NetworkObservation}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding AutomaticActionText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding HasMetrics, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="МЕТРИКИ ИЗМЕРЕНИЙ" />
                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Divider}" Padding="0,8,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Value}" Foreground="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding Details}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding HasGeneratedCandidate, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="АВТОКОНСТРУКТОР ПОД ЭТУ СЕТЬ" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding GeneratedCandidateName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding GeneratedCandidateSummary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding CandidateGenerationText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DimText}" Text="Признаки: " Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding GeneratedCandidateFeatures}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DimText}" Text="Параметры-кандидата:" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding GeneratedCandidateArgs}" TextWrapping="Wrap" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Сохранить кандидат"
                            Margin="0,10,0,0" HorizontalAlignment="Left"
                            Command="{Binding SaveGeneratedCandidateCommand}"
                            ToolTip="Сохранить кандидат отдельно от оригинальных стратегий; даже проверенный вариант не запускается без отдельного подтверждения" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="РЕКОМЕНДАЦИИ И АВТОНАСТРОЙКА" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding RecommendedStrategyText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding RecommendedStrategyArgs}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding RecommendedStrategyArgs, Converter={StaticResource StringToVis}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Применить найденную стратегию"
                            Margin="0,10,0,0" HorizontalAlignment="Left"
                            Command="{Binding ApplyRecommendationCommand}"
                            Visibility="{Binding RecommendationCanBeApplied, Converter={StaticResource BoolToVis}}"
                            ToolTip="Запустить только стратегию с подтверждённым полным успехом; безопасный режим блокирует действие" />
                    <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Divider}" Padding="0,8,0,8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Details}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding ActionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="ПОЛНЫЙ СПИСОК УСЛОВИЙ И ОГРАНИЧЕНИЙ" />
                    <ItemsControl ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top"
                                            Background="{Binding StatusKey, Converter={StaticResource SoftSeverityBrush}}">
                                        <TextBlock Text="{Binding Icon}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <WrapPanel>
                                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                                <TextBlock Style="{StaticResource DimText}" Text="{Binding Category}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Details}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding Recommendation}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   Visibility="{Binding Recommendation, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
