<UserControl x:Class="ZapretGui.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка раздела -->
        <Grid Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}" FontSize="22"
                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource DisplayText}" Text="Zapret GUI" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                           Text="Графический интерфейс для zapret-discord-youtube." />
            </StackPanel>
            <WrapPanel Grid.Column="2" Style="{StaticResource PageActions}">
                <Button Style="{StaticResource PageActionGhost}" Content="← Настройки"
                        Click="BackToSettings_Click" ToolTip="Вернуться в Настройки" />
            </WrapPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="0,4,0,0">
            <StackPanel Style="{StaticResource PageContent}">

                <Border Style="{StaticResource PageCardFirst}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="ЧТО ДЕЛАЕТ ПРИЛОЖЕНИЕ" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Запускает обход (winws.exe) теми же стратегиями, что и .bat-файлы сборки." />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Ставит обход службой Windows с автозапуском, сам проверяет и ставит обновления движка, сохраняя списки." />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Управляет игровым фильтром, режимами ipset, списками и файлом hosts." />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Проверяет ресурсы и конфликты — VPN, прокси, службы, драйвер WinDivert." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="АВТОРЫ И ИСТОЧНИКИ" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyText}" Text="Стратегии и движок: Flowseal/zapret-discord-youtube" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0" Text="Релизы со стратегиями, списками и bin-файлами." />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PageActionGhost}" Content="Открыть репозиторий"
                                    Margin="10,0,0,0" VerticalAlignment="Center" Click="OpenFlowseal_Click" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.35" Margin="0,10,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyText}" Text="Утилита обхода: zapret от bol-van" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0" Text="Оригинальная реализация DPI-обхода и документация параметров." />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PageActionGhost}" Content="Открыть zapret"
                                    Margin="10,0,0,0" VerticalAlignment="Center" Click="OpenZapret_Click" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.35" Margin="0,10,0,0" />
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource BodyText}" Text="Перехват трафика: WinDivert" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0" Text="Драйвер, из-за которого антивирусы иногда ругаются на сборку." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="ВЕРСИИ" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyText}" Text="Zapret GUI" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding AppVersion}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyText}" Text="Движок zapret" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding EngineVersionText}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyText}" Text="Среда" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text=".NET 8 · WPF"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="ЛИЦЕНЗИЯ" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Zapret GUI распространяется по лицензии MIT. Движок и стратегии принадлежат их авторам." />
                        <Button Style="{StaticResource PageActionGhost}" Content="Лицензия zapret-discord-youtube"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenLicense_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageCard}" Padding="16,12"
                        Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="ВАЖНО" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Приложение не обходит блокировки само по себе — оно управляет утилитой zapret. Используйте в соответствии с законодательством вашей страны." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
