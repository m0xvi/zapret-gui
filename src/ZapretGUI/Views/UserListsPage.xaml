<UserControl x:Class="ZapretGui.Views.UserListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly" Padding="0,0,4,0">
        <StackPanel Margin="24,20,20,26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Списки пользователя" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Добавляйте домены и IP через интерфейс. Блокнот и ручное редактирование больше не нужны." />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Открыть папку lists"
                        Command="{Binding OpenFolderCommand}" ToolTip="Открыть папку списков в проводнике" />
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="ВЫБЕРИТЕ КАТЕГОРИЮ" />
                    <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding ListOptions}"
                              SelectedValuePath="Key" DisplayMemberPath="Title"
                              SelectedValue="{Binding SelectedListKey, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding SelectedList.Description}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding ListPath}" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ListPath}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ЗАПИСИ" />
                            <TextBlock Style="{StaticResource DimText}" Text="По одной записи в строке" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Style="{StaticResource SecondaryButton}" Content="Добавить запись"
                                    Command="{Binding AddEntryCommand}" ToolTip="Открыть отдельное окно добавления записи" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Сохранить список" Margin="8,0,0,0"
                                    Command="{Binding SaveCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Перечитать" Margin="8,0,0,0"
                                    Command="{Binding ReloadCommand}" />
                        </WrapPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Text="{Binding Status}" Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                    <ListBox Grid.Row="2" Margin="0,12,0,0" MinHeight="180" MaxHeight="520"
                             Style="{StaticResource PlainListBox}" ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" />
                                    <WrapPanel Grid.Column="1">
                                        <Button Style="{StaticResource GhostButton}" Content="Изменить" Padding="8,4"
                                                Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource GhostButton}" Content="Удалить" Padding="8,4" Margin="6,0,0,0"
                                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
