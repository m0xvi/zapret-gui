<UserControl x:Class="ZapretGui.Views.UserListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZapretGui.Views.Controls"
             Background="Transparent">
    <Grid Margin="24,20,20,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок страницы и общие действия -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource DisplayText}" Text="Списки доменов и DNS" />
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Визуальный редактор доменов, авто-обновление списков Flowseal, безопасный DNS (DoH) и игровые фильтры" />
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource PrimaryButton}" Content="Применить и перезапустить"
                        Command="{Binding RestartBypassCommand}"
                        ToolTip="Перезапустить активный обход для применения новых списков и настроек фильтрации" />
                <Button Style="{StaticResource GhostButton}" Content="Папка lists" Margin="8,0,0,0"
                        Command="{Binding OpenFolderCommand}" ToolTip="Открыть папку со списками в проводнике" />
            </WrapPanel>
        </Grid>

        <!-- Переключатель подвкладок (Редактор списков / Безопасный DNS / Режимы фильтрации) -->
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <controls:SegmentedControl ItemsSource="{Binding SubTabs}"
                                       SelectedIndex="{Binding SelectedSubTabIndex, Mode=TwoWay}"
                                       MinWidth="460" />
        </Grid>

        <!-- ============================== ВКЛАДКА 1: РЕДАКТОР СПИСКОВ ============================== -->
        <Grid Grid.Row="2" Visibility="{Binding IsEditorTabVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Выбор списка и панель автообновления -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ВЫБОР ФАЙЛА СПИСКА" />
                            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,6,0,0"
                                      ItemsSource="{Binding ListOptions}"
                                      SelectedValuePath="Key" DisplayMemberPath="Title"
                                      SelectedValue="{Binding SelectedListKey, Mode=TwoWay}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButton}" Content="Обновить списки с GitHub"
                                    Command="{Binding UpdateListsFromGithubCommand}"
                                    ToolTip="Загрузить свежие списки general, discord, youtube и ipset от Flowseal" />
                            <Button Style="{StaticResource GhostButton}" Content="Открыть в Блокноте" Margin="8,0,0,0"
                                    Command="{Binding OpenInNotepadCommand}" ToolTip="Открыть этот файл в стандартном Блокноте" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding SelectedList.Description}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <!-- Статус обновления с GitHub -->
                    <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6"
                            Background="{Binding DomainListUpdateResultKey, Converter={StaticResource SoftSeverityBrush}}"
                            Visibility="{Binding DomainListUpdateResultText, Converter={StaticResource StringToVis}}">
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding DomainListUpdateResultText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Содержимое списка и визуальный редактор -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Строка быстрого добавления домена и утилиты -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,8,0">
                            <TextBox Style="{StaticResource SearchBox}" Text="{Binding QuickDomainInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Введите домен или IP (например, twitch.tv или open.spotify.com)" />
                            <TextBlock Style="{StaticResource DimText}" Text="Быстрое добавление домена (например, twitch.tv)…" Margin="13,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding QuickDomainInput, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                        </Grid>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Добавить"
                                Command="{Binding QuickAddDomainCommand}" ToolTip="Добавить домен в список и сразу сохранить" />

                        <WrapPanel Grid.Column="2" Margin="10,0,0,0" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Сортировать А-Я"
                                    Command="{Binding SortEntriesCommand}" ToolTip="Отсортировать список по алфавиту" />
                            <Button Style="{StaticResource GhostButton}" Content="Очистить дубликаты" Margin="6,0,0,0"
                                    Command="{Binding DeduplicateEntriesCommand}" ToolTip="Удалить повторяющиеся домены и пустые строки" />
                            <Button Style="{StaticResource GhostButton}" Content="Экспорт" Margin="6,0,0,0"
                                    Command="{Binding ExportListCommand}" ToolTip="Сохранить список в файл" />
                            <Button Style="{StaticResource GhostButton}" Content="Импорт" Margin="6,0,0,0"
                                    Command="{Binding ImportListCommand}" ToolTip="Загрузить домены из внешнего файла" />
                        </WrapPanel>
                    </Grid>

                    <!-- Поиск по списку и статусная строка -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Поиск и фильтрация строк в текущем списке" />
                            <TextBlock Style="{StaticResource DimText}" Text="Поиск в списке…" Margin="13,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                        </Grid>

                        <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="{Binding Status}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="2" Style="{StaticResource DimText}" Text="{Binding CountText}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>

                    <!-- Таблица / Список записей -->
                    <ListBox Grid.Row="2" Style="{StaticResource PlainListBox}" Background="Transparent"
                             ItemsSource="{Binding EntriesView}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CompactRowItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE70F;"
                                                ToolTip="Изменить запись"
                                                Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE74D;" Margin="4,0,0,0"
                                                ToolTip="Удалить запись"
                                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== ВКЛАДКА 2: БЕЗОПАСНЫЙ DNS (DOH) ============================== -->
        <Grid Grid.Row="2" Visibility="{Binding IsDnsTabVisible, Converter={StaticResource BoolToVis}}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*" MinWidth="360" />
                        <ColumnDefinition Width="10*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВАЯ КОЛОНКА: Выбор и применение безопасного DNS -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="НАСТРОЙКА БЕЗОПАСНОГО DNS" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="Шифрованный и независимый DNS защищает от подмены IP-адресов сайтов провайдером (DNS poisoning / hijacking)." Margin="0,2,0,12" />

                            <TextBlock Style="{StaticResource DimText}" Text="ВЫБЕРИТЕ ПРОФИЛЬ DNS" />
                            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,10"
                                      ItemsSource="{Binding DnsProfiles}" DisplayMemberPath="DisplayTitle"
                                      SelectedItem="{Binding SelectedDnsProfile, Mode=TwoWay}"
                                      ToolTip="Выберите безопасный DNS-сервер" />

                            <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding SelectedDnsProfile.Name}" FontWeight="Bold" />
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedDnsProfile.Description}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DimText}" Text="Основной DNS:" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding SelectedDnsProfile.PrimaryServer, FallbackValue='Автоматический (DHCP)'}" Margin="8,0,0,0" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DimText}" Text="Запасной DNS:" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding SelectedDnsProfile.SecondaryServer, FallbackValue='—'}" Margin="8,0,0,0" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DimText}" Text="DoH URL:" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" Text="{Binding SelectedDnsProfile.DohUrl, FallbackValue='—'}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,4,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Применить DNS к адаптеру"
                                        Command="{Binding ApplyDnsProfileCommand}"
                                        ToolTip="Установить выбранный DNS сервер для вашего активного сетевого подключения" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Проверить скорость и резолв" Margin="8,0,0,0"
                                        Command="{Binding TestDnsServerCommand}"
                                        ToolTip="Проверить задержку отклика и разрешение домена youtube.com" />
                                <Button Style="{StaticResource GhostButton}" Content="Сбросить на DHCP (авто)" Margin="8,0,0,0"
                                        Command="{Binding ResetDnsToDhcpCommand}"
                                        ToolTip="Вернуть автоматическое получение DNS от роутера" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ПРАВАЯ КОЛОНКА: Статус DNS в системе и диагностика -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionText}" Text="ТЕКУЩИЙ СИСТЕМНЫЙ DNS" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Обновить" Padding="6,2" FontSize="11"
                                        Command="{Binding RefreshCurrentDnsCommand}" />
                            </Grid>

                            <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,6,0,12" Background="{DynamicResource ElevatedBrush}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding CurrentSystemDnsText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Активный сетевой адаптер Windows" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionText}" Text="РЕЗУЛЬТАТ ТЕСТИРОВАНИЯ DNS" Margin="0,6,0,0" />
                            <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="8"
                                    Background="{Binding DnsTestStatusKey, Converter={StaticResource SoftSeverityBrush}}"
                                    Visibility="{Binding DnsTestStatusText, Converter={StaticResource StringToVis}}">
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding DnsTestStatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </Border>

                            <Border Style="{StaticResource InnerCard}" Margin="0,14,0,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionText}" Text="ПОЧЕМУ DNS ВАЖЕН ДЛЯ ОБХОДА" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Некоторые провайдеры подменяют ответы стандартного DNS (перенаправляют на страницу-заглушку). Установка Cloudflare 1.1.1.1 или Quad9 9.9.9.9 гарантирует получение подлинных IP-адресов YouTube, Discord и заблокированных сайтов." TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ============================== ВКЛАДКА 3: РЕЖИМЫ ФИЛЬТРАЦИИ ============================== -->
        <Grid Grid.Row="2" Visibility="{Binding IsFiltersTabVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="РЕЖИМЫ ФИЛЬТРАЦИИ IP И ПОРТОВ (IPSET / GAMES)" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Тонкая настройка перехвата сетевого трафика драйвером WinDivert" Margin="0,2,0,14" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InnerCard}" Margin="0,0,8,0" Padding="14,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="ФИЛЬТРАЦИЯ IP (IPSET)" />
                                <ComboBox Style="{StaticResource AppComboBox}" Margin="0,6,0,0"
                                          ItemsSource="{Binding IpsetOptions}"
                                          SelectedIndex="{Binding IpsetModeIndex, Mode=TwoWay}"
                                          ToolTip="Режим фильтрации IP: по файлу ipset-all.txt, все адреса (Any) или отключено (None)" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                           Text="• По списку ipset-all.txt (рекомендуется) — обрабатывает только IP заблокированных сервисов, снижая нагрузку на процессор.&#x0a;• Все IP / Any — максимальный охват без ограничений по IP.&#x0a;• Без фильтрации / None — отключение ipset фильтрации." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InnerCard}" Margin="8,0,0,0" Padding="14,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="ИГРОВОЙ ФИЛЬТР (ПОРТЫ ВЫШЕ 1023)" />
                                <ComboBox Style="{StaticResource AppComboBox}" Margin="0,6,0,0"
                                          ItemsSource="{Binding GameFilterOptions}"
                                          SelectedIndex="{Binding GameFilterIndex, Mode=TwoWay}"
                                          ToolTip="Игровой фильтр: обрабатывать ли трафик игр, Discord голосовых каналов и сторонних сервисов" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                           Text="• TCP + UDP — оптимально для голосовых серверов Discord (UDP 50000-65535) и онлайн-игр.&#x0a;• Только TCP / Только UDP — выборочный перехват протоколов.&#x0a;• Выключен — обрабатываются только стандартные порты 80 и 443." TextWrapping="Wrap" />

                                <TextBlock Style="{StaticResource SectionText}" Text="ПРОФИЛЬ ПОРТОВ И ИСКЛЮЧЕНИЙ ДЛЯ ИГР" Margin="0,12,0,0" />
                                <ComboBox Style="{StaticResource AppComboBox}" Margin="0,6,0,0"
                                          ItemsSource="{Binding GameFilterProfiles}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedGameFilterProfile, Mode=TwoWay}"
                                          ToolTip="Выберите профиль портов для исключения античитов и оптимизации задержки" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                                           Text="{Binding SelectedGameFilterProfile.Description}" TextWrapping="Wrap" />

                                <!-- Кастомные порты -->
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsCustomGameFilterSelected, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Style="{StaticResource SectionText}" Text="TCP ПОРТЫ" />
                                            <TextBox Style="{StaticResource InputBox}" Text="{Binding CustomGameFilterTcpPorts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Style="{StaticResource SectionText}" Text="UDP ПОРТЫ" />
                                            <TextBox Style="{StaticResource InputBox}" Text="{Binding CustomGameFilterUdpPorts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource SectionText}" Text="ИСКЛЮЧЁННЫЕ ПОРТЫ" Margin="0,6,0,0" />
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding CustomExcludedPorts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Button Style="{StaticResource SecondaryButton}" Content="Применить настройки портов" Margin="0,10,0,0"
                                        Command="{Binding ApplyGameFilterPortsCommand}" HorizontalAlignment="Left"
                                        ToolTip="Сохранить выбранные диапазоны портов и перезапустить winws" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Применить и перезапустить обход"
                                Command="{Binding RestartBypassCommand}"
                                ToolTip="Перезапустить winws с обновлёнными параметрами фильтрации" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
