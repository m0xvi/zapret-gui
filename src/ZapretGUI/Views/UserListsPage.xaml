<UserControl x:Class="ZapretGui.Views.UserListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly" Padding="0,0,4,0">
        <StackPanel Margin="24,20,20,26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Списки и фильтры" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Управление доменами, списками исключений, режимами ipset и игровым фильтром" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="Применить и перезапустить"
                            Command="{Binding RestartBypassCommand}"
                            ToolTip="Перезапустить активный обход для применения новых списков и настроек фильтрации" />
                    <Button Style="{StaticResource GhostButton}" Content="Папка lists" Margin="8,0,0,0"
                            Command="{Binding OpenFolderCommand}" ToolTip="Открыть папку списков в проводнике" />
                </WrapPanel>
            </Grid>

            <!-- Параметры фильтрации IP и игр -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="РЕЖИМЫ ФИЛЬТРАЦИИ IP И ПОРТОВ" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource DimText}" Text="Фильтрация IP (режим ipset)" />
                            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,5,0,0"
                                      ItemsSource="{Binding IpsetOptions}"
                                      SelectedIndex="{Binding IpsetModeIndex, Mode=TwoWay}"
                                      ToolTip="Режим фильтрации IP: по файлу ipset-all.txt, все адреса (Any) или отключено (None)" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                                       Text="Режим Any перенаправляет все IP в движок (максимальный обход, но выше нагрузка)." TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource DimText}" Text="Игровой фильтр (порты выше 1023)" />
                            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,5,0,0"
                                      ItemsSource="{Binding GameFilterOptions}"
                                      SelectedIndex="{Binding GameFilterIndex, Mode=TwoWay}"
                                      ToolTip="Игровой фильтр: обрабатывать ли трафик игр, Discord голосовых каналов и сторонних сервисов" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0"
                                       Text="TCP+UDP обеспечивает лучшую совместимость с онлайн-играми и голосовым чатом." TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Выбор и редактирование списка -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="РЕДАКТИРОВАНИЕ СПИСКОВ ДОМЕНОВ" />
                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,6,0,0"
                              ItemsSource="{Binding ListOptions}"
                              SelectedValuePath="Key" DisplayMemberPath="Title"
                              SelectedValue="{Binding SelectedListKey, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding SelectedList.Description}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding ListPath}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ListPath}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ЗАПИСИ СПИСКА" />
                            <TextBlock Style="{StaticResource DimText}" Text="По одной записи в строке (домен или IP-подсеть)" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Style="{StaticResource SecondaryButton}" Content="Добавить запись"
                                    Command="{Binding AddEntryCommand}" ToolTip="Открыть отдельное окно добавления записи" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Сохранить список" Margin="8,0,0,0"
                                    Command="{Binding SaveCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Перечитать" Margin="8,0,0,0"
                                    Command="{Binding ReloadCommand}" />
                        </WrapPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Text="{Binding Status}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <ListBox Grid.Row="2" Margin="0,10,0,0" MinHeight="180" MaxHeight="480"
                             Style="{StaticResource PlainListBox}" ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CompactRowItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE70F;"
                                                ToolTip="Изменить запись"
                                                Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE74D;" Margin="4,0,0,0"
                                                ToolTip="Удалить запись"
                                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
