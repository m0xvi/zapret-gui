<UserControl x:Class="ZapretGui.Views.GameModePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZapretGui.Views.Controls"
             Background="Transparent">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка раздела -->
        <Grid Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource DisplayText}" Text="Игровой режим" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                           Text="Профиль портов и игры, трафик которых обход не трогает." />
            </StackPanel>
            <WrapPanel Grid.Column="1" Style="{StaticResource PageActions}">
                <Button Style="{StaticResource PageActionPrimary}" Content="Перезапустить обход"
                        Command="{Binding RestartBypassCommand}"
                        ToolTip="{Binding RestartBypassHint}" />
                <Button Style="{StaticResource PageActionGhost}" Content="Обновить" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                        ToolTip="Перечитать профили и состояние игрового фильтра" />
            </WrapPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="0,4,0,0">
            <StackPanel Style="{StaticResource PageContent}">

            <Border Margin="0,12,0,0" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" Foreground="{Binding MessageKey, Converter={StaticResource SeverityBrush}}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="✕" Margin="8,0,0,0" Command="{Binding DismissMessageCommand}"/>
                </Grid>
            </Border>

            <!-- Вкл/выкл -->
            <Border Style="{StaticResource PageCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Игровой режим"/>
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding GameModeStatusText}" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding DetectionStatusText}" TextWrapping="Wrap" FontSize="11" Foreground="{Binding DetectionStatusKey, Converter={StaticResource SeverityBrush}}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding GameModeActive, Mode=TwoWay}" Content="{Binding GameModeBadge}" VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Автодетект игры" IsChecked="{Binding GameDetectionEnabled, Mode=TwoWay}"/>
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Авто-включать режим" Margin="16,0,0,0" IsChecked="{Binding AutoGameModeOnLaunch, Mode=TwoWay}" IsEnabled="{Binding GameDetectionEnabled}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Фильтр -->
            <Border Style="{StaticResource PageCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="ПРОФИЛЬ ПОРТОВ"/>
                    <TextBlock Style="{StaticResource DimText}" Text="Какой UDP-трафик пропускать без обхода." TextWrapping="Wrap" FontSize="11" Opacity="0.85" Margin="0,2,0,0"/>
                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,10,0,0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedProfileDescription}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Opacity="0.85"/>
                    <Button Style="{StaticResource PageAction}" Content="Применить профиль" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding ApplyProfileCommand}"/>
                </StackPanel>
            </Border>

            <!-- Steam: медленные страницы магазина (v2.2.5) -->
            <Border Style="{StaticResource PageCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource SectionText}" Text="STEAM: БЫСТРЫЕ СТРАНИЦЫ"/>
                            <TextBlock Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{Binding SteamBypassStateText}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" Content="Через обход"
                                  IsChecked="{Binding SteamBypassEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                  ToolTip="{Binding SteamBypassHint}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource DimText}" FontSize="11" Opacity="0.85" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{Binding SteamBypassHint}"/>
                    <CheckBox Style="{StaticResource SwitchCheckBox}" Margin="0,10,0,0"
                              Content="Не подделывать QUIC (если страницы всё равно тормозят)"
                              IsChecked="{Binding DisableQuicFake, Mode=TwoWay}"
                              ToolTip="Steam грузит страницы по HTTP/3 (QUIC). Подделка QUIC-пакетов заставляет его повторять рукопожатие — с этой галочкой обход не трогает QUIC. Может замедлить обход YouTube."/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PageAction}" Content="Применить и перезапустить обход"
                                Command="{Binding ApplySteamBypassCommand}"
                                ToolTip="Создать списки Steam и перезапустить обход, если он уже работает"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource DimText}" FontSize="11" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SteamBypassStatus}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Игры -->
            <Border Style="{StaticResource PageCard}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="КАКИЕ ИГРЫ НЕ ТРОГАТЬ"/>
                    <TextBlock Style="{StaticResource DimText}" Text="Галочка — добавить домены игры в список обхода и перезапустить его." TextWrapping="Wrap" FontSize="11" Opacity="0.85" Margin="0,2,0,0"/>
                    <ItemsControl ItemsSource="{Binding GameOptions}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8" Background="{DynamicResource CardBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource CheckBoxApp}" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource DimText}" FontSize="11" Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.85" Margin="0,1,0,0"/>
                                            <TextBlock Style="{StaticResource DimText}" FontSize="10" Text="{Binding Status}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Visibility="{Binding Status, Converter={StaticResource StringToVis}}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource PageActionPrimary}" Content="Сохранить и перезапустить обход" Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding FixSelectedGamesCommand}"/>
                </StackPanel>
            </Border>

            <!-- R.E.P.O.: регионы Photon (v2.2.6) -->
            <Border Style="{StaticResource PageCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="R.E.P.O.: РЕГИОНЫ PHOTON"/>
                    <TextBlock Style="{StaticResource DimText}" FontSize="11" Opacity="0.85" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Игра выбирает регион Photon сама, и цифры там завышены. Проверьте реальное время ответа и выберите регион в игре."/>
                    <TextBlock Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
                               Text="{Binding RepoStateText}"
                               Foreground="{Binding RepoStateKey, Converter={StaticResource SeverityBrush}}"/>
                    <TextBlock Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{Binding PhotonCoverageText}"
                               Foreground="{Binding PhotonCoverageKey, Converter={StaticResource SeverityBrush}}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource PageAction}" Content="Починить R.E.P.O."
                                Command="{Binding FixPhotonCommand}"
                                ToolTip="Исключить адреса Photon (216.120.180.0/23) из ipset обхода, отключить обход Photon и перезапустить обход"/>
                        <Button Style="{StaticResource PageActionGhost}" Content="Перезапустить обход" Margin="8,0,0,0"
                                Command="{Binding RestartBypassCommand}"
                                ToolTip="{Binding RestartBypassHint}"/>
                    </WrapPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PageAction}" Content="Проверить регионы"
                                Command="{Binding CheckPhotonRegionsCommand}"
                                ToolTip="Измерить время ответа узлов Photon для каждого региона (кнопка недоступна во время проверки)"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource DimText}" FontSize="11" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding PhotonRegionHint}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PhotonRegionResults}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource DimText}" FontSize="11.5" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource DimText}" FontSize="11.5" FontWeight="SemiBold"
                                               Text="{Binding StatusText}"
                                               Foreground="{Binding SeverityKey, Converter={StaticResource SeverityBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Style="{StaticResource SwitchCheckBox}" Margin="0,12,0,0"
                              Content="Вести трафик Photon через обход (обычно не нужно)"
                              IsChecked="{Binding PhotonThroughBypass, Mode=TwoWay}"
                              ToolTip="Включайте только если без обхода не открываются сайты photonengine.io. Для R.E.P.O. это чаще вредит: игра начинает таймаутить."/>
                    <TextBlock Style="{StaticResource DimText}" FontSize="11" Opacity="0.85" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{Binding PhotonRoutingStatus}" Visibility="{Binding PhotonRoutingStatus, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
