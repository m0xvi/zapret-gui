<Window x:Class="ZapretGui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Zapret GUI" Height="740" Width="1150" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged"
        AutomationProperties.Name="Главное окно Zapret GUI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= ЗАГОЛОВОК ОКНА ======================= -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Zapret GUI" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="12,0,0,0"
                        Command="{Binding NavigateHomeCommand}"
                        ToolTip="Состояние обхода — нажмите, чтобы перейти к тумблеру включения на странице Обзор">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding Home.BypassStateKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="{Binding Home.StatusText}" Margin="7,0,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Home.StatusText}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="8,0,0,0"
                        Command="{Binding NavigateStrategiesCommand}"
                        ToolTip="{Binding ActiveStrategyTooltipText}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding ActiveStrategyKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="⚡ " FontSize="10" Margin="4,0,0,0" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding ActiveStrategySummaryText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                    </WrapPanel>
                </Button>
                <!-- Метрики хостов — кликабельно: ведёт к настройке списка хостов (Экспресс-проверка) -->
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="6,0,0,0"
                        Command="{Binding NavigateMonitoringCommand}"
                        ToolTip="{Binding MonitoringSummaryTooltip}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding MonitoringSummaryKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="{Binding MonitoringSummaryText}" Margin="6,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    </WrapPanel>
                </Button>
                <!-- Живой RTT пинг — кликабельно: настройка интервала RTT -->
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="6,0,0,0"
                        Command="{Binding NavigateMonitoringCommand}"
                        Visibility="{Binding RealTimePingVisible, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding RealTimePingTooltip}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding RealTimePingStatusKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="{Binding RealTimePingSummaryText}" Margin="6,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                    </WrapPanel>
                </Button>
                <!-- Тулбар-метрики как в MSI Afterburner — обновление каждую минуту, рядом с иконкой -->
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="6,0,0,0"
                        Command="{Binding NavigateMonitoringCommand}"
                        Visibility="{Binding ToolbarMetricsVisible, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding ToolbarMetricsTooltip}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◉" FontSize="8" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Opacity="0.9" />
                        <TextBlock Text="{Binding ToolbarMetricsText}" Margin="6,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    </WrapPanel>
                </Button>
                <!-- Бейдж активной игры -->
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="6,0,0,0"
                        Command="{Binding Home.ToggleGameModeCommand}"
                        Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVis}}"
                        ToolTip="Обнаружен игровой процесс. Нажмите, чтобы переключить игровой режим (пропуск UDP).">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}" Background="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding GameStatusBadgeText}" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    </WrapPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="6,0,0,0"
                        Command="{Binding NavigateActiveCheckCommand}"
                        Visibility="{Binding IsAnyCheckRunning, Converter={StaticResource BoolToVis}}"
                        ToolTip="В фоне выполняется проверка сети. Нажмите, чтобы перейти к выполняемой проверке.">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource BusySpinner}" Width="12" Height="12" BorderThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveCheckStatusText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="6,0,0,0"
                        Background="{Binding ReadinessKey, Converter={StaticResource SoftSeverityBrush}}"
                        Command="{Binding NavigateDiagnosticsCommand}"
                        ToolTip="{Binding ReadinessDetails, StringFormat='{}{0} — нажмите, чтобы открыть аудит системы и исправить проблемы'}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding ReadinessKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="{Binding ReadinessText}" Margin="7,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
            </WrapPanel>

            <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButton}" Content="&#xE737;"
                        Command="{Binding Home.OpenOverlayCommand}" ToolTip="Открыть компактный мини-виджет (HUD)"
                        AutomationProperties.Name="Открыть HUD" />
                <Button Style="{StaticResource IconButton}" Content="&#xE793;"
                        Command="{Binding ToggleThemeCommand}" ToolTip="Переключить тему (системная → тёмная → светлая)"
                        AutomationProperties.Name="Переключить тему" />
                <Button Style="{StaticResource IconButton}" Content="&#xE946;"
                        Command="{Binding OpenEngineFolderCommand}" ToolTip="Открыть папку движка"
                        AutomationProperties.Name="Открыть папку движка" />
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"
                        ToolTip="Свернуть" AutomationProperties.Name="Свернуть окно" />
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                        Click="Maximize_Click" ToolTip="Развернуть" AutomationProperties.Name="Развернуть или восстановить окно" />
                <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="Close_Click"
                        ToolTip="Закрыть" AutomationProperties.Name="Закрыть окно" />
            </WrapPanel>
        </Grid>

        <!-- ======================= ОСНОВНАЯ ОБЛАСТЬ ======================= -->
        <!-- Масштабируется только рабочая область страницы. Навигация остаётся
             закреплённой слева, поэтому она не может уйти за горизонтальный край. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="NavList" Style="{StaticResource PlainListBox}" Margin="0,12,0,0"
                             KeyboardNavigation.TabNavigation="Local"
                             AutomationProperties.Name="Разделы приложения"
                             ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}"
                                               FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource DimText}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" Opacity="0.85"
                                                   Visibility="{Binding Hint, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Margin="14,0,14,14">
                        <Border Style="{StaticResource InnerCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DimText}" Text="ВЕРСИЯ ДВИЖКА" />
                                <TextBlock Text="{Binding EngineVersionText}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,3,0,3" />
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding Home.EnginePathText}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Home.EnginePathText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource DimText}"
                                   Text="{Binding AppVersion, StringFormat=Zapret GUI {0} · лицензия MIT}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="PageScroll" Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly" Background="Transparent" Focusable="False" CanContentScroll="False">
                <Grid>
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource ZoomedViewport}">
                            <Binding Path="ViewportWidth" ElementName="PageScroll" />
                            <Binding Path="InterfaceZoom" />
                        </MultiBinding>
                    </Grid.Width>
                    <Grid.MinHeight>
                        <MultiBinding Converter="{StaticResource ZoomedViewport}">
                            <Binding Path="ViewportHeight" ElementName="PageScroll" />
                            <Binding Path="InterfaceZoom" />
                        </MultiBinding>
                    </Grid.MinHeight>
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding InterfaceZoom}" ScaleY="{Binding InterfaceZoom}" />
                    </Grid.LayoutTransform>
                    <ContentControl x:Name="PageHost" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ======================= ПРЕДУПРЕЖДЕНИЕ О ПРАВАХ ======================= -->
        <Border Grid.Row="2" Background="{DynamicResource WarningSoftBrush}" Padding="16,10"
                Visibility="{Binding AdminWarningVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}"
                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding AdminWarningText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding AdminWarningDetails}" TextWrapping="Wrap" />
                    </StackPanel>
                </WrapPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Перезапустить от администратора"
                        HorizontalAlignment="Right" Command="{Binding RestartAsAdminCommand}" Padding="14,7" />
            </Grid>
        </Border>

        <!-- ======================= ОВЕРЛЕЙ ОБНОВЛЕНИЯ GUI ======================= -->
        <!-- Затемняет всё окно при скачивании/установке нового ZapretGUI.exe и показывает прогресс в процентах -->
        <Border Grid.RowSpan="3" Panel.ZIndex="200" Background="#AA000000"
                Visibility="{Binding Updates.GuiUpdateOverlayVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="26,22"
                    Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#22000000" BlurRadius="10" ShadowDepth="2" Opacity="0.22" />
                </Border.Effect>
                <StackPanel>
                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Updates.GuiUpdateHasError}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontFamily="{DynamicResource IconFont}" FontSize="16"
                                       Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE895;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Updates.GuiUpdateHasError}" Value="True">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Обновление Zapret GUI" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Updates.GuiUpdateHasError}" Value="True">
                                            <Setter Property="Text" Value="Ошибка обновления GUI" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                    <!-- Секция прогресса — скрывается при ошибке -->
                    <StackPanel Visibility="{Binding Updates.GuiUpdateProgressVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Updates.Status}" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{Binding Updates.GuiUpdateStatus}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <Grid Margin="0,18,0,0">
                            <ProgressBar Height="10" Minimum="0" Maximum="100"
                                         Value="{Binding Updates.Progress, Mode=OneWay}"
                                         IsIndeterminate="{Binding Updates.Indeterminate, Mode=OneWay}"
                                         Style="{StaticResource ThinProgress}" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Visibility="{Binding Updates.Indeterminate, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <Run Text="{Binding Updates.Progress, Mode=OneWay, StringFormat={}{0:0}%}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </TextBlock>
                        <TextBlock Text="Подготовка — проверка SHA-256…"
                                   Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   Visibility="{Binding Updates.Indeterminate, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Не закрывайте приложение — после загрузки оно автоматически перезапустится"
                                   Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                        <Button Style="{StaticResource GhostButton}" Content="Отмена" Margin="0,14,0,0"
                                HorizontalAlignment="Center" Command="{Binding Updates.CancelCommand}"
                                ToolTip="Прервать загрузку обновления GUI" />
                    </StackPanel>
                    <!-- Секция ошибки — видима только при ошибке -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding Updates.GuiUpdateErrorVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Updates.GuiUpdateErrorText}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Updates.GuiUpdateStatus}" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   Visibility="{Binding Updates.GuiUpdateErrorText, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                        <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Повторить" Padding="14,6" Margin="0,0,8,0"
                                    Command="{Binding Updates.RetryGuiUpdateCommand}" ToolTip="Повторить загрузку обновления" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Скачать вручную" Padding="14,6" Margin="0,0,8,0"
                                    Command="{Binding Updates.OpenManualGuiDownloadCommand}" ToolTip="Открыть страницу релиза на GitHub" />
                            <Button Style="{StaticResource GhostButton}" Content="Закрыть" Padding="14,6"
                                    Command="{Binding Updates.DismissGuiUpdateErrorCommand}" ToolTip="Скрыть это сообщение" />
                        </WrapPanel>
                        <TextBlock Text="Резервная копия предыдущего exe хранится в %APPDATA%\\ZapretGUI\\gui-backup" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Глобальный прогресс-оверлей для длительных операций (затемнение, блокировка UI) — полный экран на весь процесс, кнопка В фон уходит в правый нижний угол -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="300">
            <!-- Полноэкранный оверлей -->
            <Border Background="#AA000000"
                    Visibility="{Binding GlobalOverlay.OverlayVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Border Width="480"
                            Padding="28"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="Black" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding GlobalOverlay.Title}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" TextAlignment="Center" />
                            <TextBlock Text="{Binding GlobalOverlay.Status}" Margin="0,10,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" />
                            <!-- Анимированный процесс: серый текст, растворение вниз / появление сверху вместо статичного 'не закрывайте окно' -->
                            <TextBlock x:Name="OverlayDetailsText" Text="{Binding GlobalOverlay.Details, NotifyOnTargetUpdated=True}" Margin="0,6,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="0" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.13" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="8" Duration="0:0:0.13" />
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="0.85" BeginTime="0:0:0.13" Duration="0:0:0.16" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-8" To="0" BeginTime="0:0:0.13" Duration="0:0:0.16">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding GlobalOverlay.ProgressVisible, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Value="{Binding GlobalOverlay.Progress, Mode=OneWay}" Maximum="100"
                                             IsIndeterminate="{Binding GlobalOverlay.IsIndeterminate, Mode=OneWay}"
                                             Height="7" />
                                <TextBlock Text="{Binding GlobalOverlay.ProgressPercentText}" Margin="0,6,0,0"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                           Visibility="{Binding GlobalOverlay.IsIndeterminate, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding GlobalOverlay.ErrorVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding GlobalOverlay.ErrorText}" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="#E53935" FontSize="13" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Повторить" Command="{Binding GlobalOverlay.RetryCommand}" MinWidth="120" Padding="14,6" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Закрыть" Command="{Binding GlobalOverlay.DismissCommand}" MinWidth="120" Padding="14,6" />
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Content="Отмена" Command="{Binding GlobalOverlay.CancelCommand}" MinWidth="120" Padding="14,6"
                                    HorizontalAlignment="Center" Margin="0,14,0,0" Opacity="0.9"
                                    Visibility="{Binding GlobalOverlay.CanCancel, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                    <!-- Кнопка В фон — правый нижний угол оверлея -->
                    <Button Content="В фон" Command="{Binding GlobalOverlay.MinimizeCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="14,6" MinWidth="100"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                            ToolTip="Свернуть проверку в фон — индикатор останется в правом нижнем углу, прогресс на весь процесс сохранится" />
                </Grid>
            </Border>
            <!-- Минимизированный индикатор в правом нижнем углу — виден когда оверлей свёрнут в фон -->
            <Border Visibility="{Binding GlobalOverlay.MinimizedVisible, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center" MaxWidth="200">
                        <TextBlock Text="{Binding GlobalOverlay.Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding GlobalOverlay.Details}" Style="{StaticResource DimText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Value="{Binding GlobalOverlay.Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,4,0,0"
                                     IsIndeterminate="{Binding GlobalOverlay.IsIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding GlobalOverlay.ProgressVisible, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Button Content="Развернуть" Command="{Binding GlobalOverlay.RestoreCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" VerticalAlignment="Center" />
                    <Button Content="✕" Command="{Binding GlobalOverlay.CancelCommand}" ToolTip="Отменить"
                            Style="{StaticResource GhostButton}" Padding="6,4" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                            Visibility="{Binding GlobalOverlay.CanCancel, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
