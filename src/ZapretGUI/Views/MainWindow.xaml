<Window x:Class="ZapretGui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Zapret GUI" Height="740" Width="1150" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged"
        AutomationProperties.Name="Главное окно Zapret GUI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= ЗАГОЛОВОК ОКНА ======================= -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Zapret GUI" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="12,0,0,0"
                        Command="{Binding NavigateHomeCommand}"
                        ToolTip="Состояние обхода — нажмите, чтобы перейти к тумблеру включения на странице Обзор">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding Home.BypassStateKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="{Binding Home.StatusText}" Margin="7,0,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Home.StatusText}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="8,0,0,0"
                        Command="{Binding NavigateStrategiesCommand}"
                        ToolTip="{Binding ActiveStrategyTooltipText}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding ActiveStrategyKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="⚡ " FontSize="10" Margin="4,0,0,0" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding ActiveStrategySummaryText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                    </WrapPanel>
                </Button>
                <!-- Метрики хостов — кликабельно: ведёт к настройке списка хостов (Экспресс-проверка) -->
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="6,0,0,0"
                        Command="{Binding NavigateMonitoringCommand}"
                        ToolTip="{Binding MonitoringSummaryTooltip}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding MonitoringSummaryKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="{Binding MonitoringSummaryText}" Margin="6,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    </WrapPanel>
                </Button>
                <!-- Живой RTT пинг — кликабельно: настройка интервала RTT -->
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="6,0,0,0"
                        Command="{Binding NavigateMonitoringCommand}"
                        Visibility="{Binding RealTimePingVisible, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding RealTimePingTooltip}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding RealTimePingStatusKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="{Binding RealTimePingSummaryText}" Margin="6,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                    </WrapPanel>
                </Button>
                <!-- Бейдж активной игры -->
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="6,0,0,0"
                        Command="{Binding Home.ToggleGameModeCommand}"
                        Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVis}}"
                        ToolTip="Обнаружен игровой процесс. Нажмите, чтобы переключить игровой режим (пропуск UDP).">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}" Background="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding GameStatusBadgeText}" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    </WrapPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="6,0,0,0"
                        Command="{Binding NavigateActiveCheckCommand}"
                        Visibility="{Binding IsAnyCheckRunning, Converter={StaticResource BoolToVis}}"
                        ToolTip="В фоне выполняется проверка сети. Нажмите, чтобы перейти к выполняемой проверке.">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource BusySpinner}" Width="12" Height="12" BorderThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveCheckStatusText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="6,0,0,0"
                        Background="{Binding ReadinessKey, Converter={StaticResource SoftSeverityBrush}}"
                        Command="{Binding NavigateDiagnosticsCommand}"
                        ToolTip="{Binding ReadinessDetails, StringFormat={}{0} — нажмите, чтобы открыть аудит системы и исправить проблемы}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}"
                                Background="{Binding ReadinessKey, Converter={StaticResource SeverityBrush}}" />
                        <TextBlock Text="{Binding ReadinessText}" Margin="7,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
            </WrapPanel>

            <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButton}" Content="&#xE737;"
                        Command="{Binding Home.OpenOverlayCommand}" ToolTip="Открыть компактный мини-виджет (HUD)"
                        AutomationProperties.Name="Открыть HUD" />
                <Button Style="{StaticResource IconButton}" Content="&#xE793;"
                        Command="{Binding ToggleThemeCommand}" ToolTip="Переключить тему (системная → тёмная → светлая)"
                        AutomationProperties.Name="Переключить тему" />
                <Button Style="{StaticResource IconButton}" Content="&#xE946;"
                        Command="{Binding OpenEngineFolderCommand}" ToolTip="Открыть папку движка"
                        AutomationProperties.Name="Открыть папку движка" />
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"
                        ToolTip="Свернуть" AutomationProperties.Name="Свернуть окно" />
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                        Click="Maximize_Click" ToolTip="Развернуть" AutomationProperties.Name="Развернуть или восстановить окно" />
                <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="Close_Click"
                        ToolTip="Закрыть" AutomationProperties.Name="Закрыть окно" />
            </WrapPanel>
        </Grid>

        <!-- ======================= ОСНОВНАЯ ОБЛАСТЬ ======================= -->
        <!-- Масштабируется только рабочая область страницы. Навигация остаётся
             закреплённой слева, поэтому она не может уйти за горизонтальный край. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="NavList" Style="{StaticResource PlainListBox}" Margin="0,12,0,0"
                             KeyboardNavigation.TabNavigation="Local"
                             AutomationProperties.Name="Разделы приложения"
                             ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}"
                                               FontSize="15" Width="24" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource DimText}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" Opacity="0.85"
                                                   Visibility="{Binding Hint, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Margin="14,0,14,14">
                        <Border Style="{StaticResource InnerCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DimText}" Text="ВЕРСИЯ ДВИЖКА" />
                                <TextBlock Text="{Binding EngineVersionText}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,3,0,3" />
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding Home.EnginePathText}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Home.EnginePathText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource DimText}"
                                   Text="{Binding AppVersion, StringFormat=Zapret GUI {0} · лицензия MIT}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="PageScroll" Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly" Background="Transparent" Focusable="False" CanContentScroll="False">
                <Grid>
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource ZoomedViewport}">
                            <Binding Path="ViewportWidth" ElementName="PageScroll" />
                            <Binding Path="InterfaceZoom" />
                        </MultiBinding>
                    </Grid.Width>
                    <Grid.MinHeight>
                        <MultiBinding Converter="{StaticResource ZoomedViewport}">
                            <Binding Path="ViewportHeight" ElementName="PageScroll" />
                            <Binding Path="InterfaceZoom" />
                        </MultiBinding>
                    </Grid.MinHeight>
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding InterfaceZoom}" ScaleY="{Binding InterfaceZoom}" />
                    </Grid.LayoutTransform>
                    <ContentControl x:Name="PageHost" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ======================= ПРЕДУПРЕЖДЕНИЕ О ПРАВАХ ======================= -->
        <Border Grid.Row="2" Background="{DynamicResource WarningSoftBrush}" Padding="16,10"
                Visibility="{Binding AdminWarningVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}"
                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding AdminWarningText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding AdminWarningDetails}" TextWrapping="Wrap" />
                    </StackPanel>
                </WrapPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Перезапустить от администратора"
                        HorizontalAlignment="Right" Command="{Binding RestartAsAdminCommand}" Padding="14,7" />
            </Grid>
        </Border>
    </Grid>
</Window>
