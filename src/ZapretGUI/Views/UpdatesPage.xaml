<UserControl x:Class="ZapretGui.Views.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PageContent}">

            <!-- Шапка раздела: только когда страница открыта отдельно (в «Настройках» шапка не нужна) -->
            <Grid Style="{StaticResource PageHeader}"
                  Visibility="{Binding ShowHeader, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Обновления" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                               Text="Версия GUI, движок, списки и hosts." />
                </StackPanel>
                <WrapPanel Grid.Column="1" Style="{StaticResource PageActions}">
                    <Button Style="{StaticResource PageActionPrimary}" Content="Проверить всё"
                            Command="{Binding CheckCommand}"
                            ToolTip="Проверить GUI (m0xvi) и движок (Flowseal) за один клик" />
                    <Button Style="{StaticResource PageActionGhost}" Content="← Настройки" Margin="8,0,0,0"
                            Click="BackToSettings_Click" ToolTip="Назад в Настройки" />
                </WrapPanel>
            </Grid>

            <!-- Статус обновлений -->
            <Border Style="{StaticResource PageCardFirst}"
                    Visibility="{Binding HasAnyUpdate, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource BodyText}" Text="Доступны обновления" Margin="8,0,0,0"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{DynamicResource CardBrush}"
                                Visibility="{Binding GuiUpdateAvailable, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GUI" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="{DynamicResource CardBrush}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="движок" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <Border Margin="0,10,0,0" CornerRadius="8" Padding="12,9"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding GuiUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionText}" Text="GUI" />
                                <TextBlock Margin="0,2,0,0" FontSize="13">
                                    <Run Text="{Binding GuiCurrentVersion, Mode=OneWay}" />
                                    <Run Text=" → " />
                                    <Run Text="{Binding GuiLatestVersion, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PageActionPrimary}" Content="Обновить"
                                    Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding UpdateGuiCommand}" />
                        </Grid>
                    </Border>

                    <Border Margin="0,8,0,0" CornerRadius="8" Padding="12,9"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionText}" Text="ДВИЖОК" />
                                <TextBlock Margin="0,2,0,0" FontSize="13">
                                    <Run Text="{Binding EngineVersion, Mode=OneWay}" />
                                    <Run Text=" → " />
                                    <Run Text="{Binding LatestVersion, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PageActionPrimary}" Content="Обновить"
                                    Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding UpdateEngineCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCard}"
                    Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasAnyUpdate, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource BodyText}" Text="Всё актуально" Margin="8,0,0,0"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource DimText}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Run Text="GUI " /><Run Text="{Binding GuiCurrentVersion, Mode=OneWay}" />
                        <Run Text=" · " /><Run Text="{Binding EngineVersion, Mode=OneWay}" />
                        <Run Text=" · " /><Run Text="{Binding LastCheckText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Сетевой отчёт для анализа -->
            <Border Style="{StaticResource PageCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionText}" Text="СЕТЕВОЙ ОТЧЁТ ДЛЯ АНАЛИЗА" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Конфигурация, стратегии и блокировки одной сводкой." />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PageActionGhost}" Content="Копировать отчёт"
                                VerticalAlignment="Center" Command="{Binding CopyNetworkReportCommand}"
                                ToolTip="Скопировать сводку в буфер для ИИ" />
                    </Grid>
                    <Border Margin="0,10,0,0" CornerRadius="8" Padding="12,10"
                            Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" LineHeight="17">
                                <Run Text="Стратегия:" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Main.ActiveStrategySummaryText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Main.ReadinessText, Mode=OneWay}" />
                                <LineBreak /><Run Text="Ресурсы:" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Main.MonitoringSummaryText, Mode=OneWay}" />
                                <LineBreak /><Run Text="Движок:" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding EngineVersion, Mode=OneWay}" /><Run Text=" · hosts:" /><Run Text=" " /><Run Text="{Binding HostsStatus, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap"
                                       Text="Нажми «Копировать» и вставь отчёт — так проще разобрать обход и предложить улучшение." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Сообщения операций -->
            <Border Style="{StaticResource PageCard}" Padding="14,10"
                    Background="{Binding MessageKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource PageCard}" Padding="14,10"
                    Background="{Binding OperationResultKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding OperationResultVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding OperationResultTitle}" />
                    <TextBlock Style="{StaticResource DimText}" Margin="0,3,0,0" Text="{Binding OperationResultDetails}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Версии -->
            <Border Style="{StaticResource PageCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionText}" Text="ВЕРСИИ" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="{Binding LastCheckText}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- GUI -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyText}" Text="GUI" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding GuiCurrentVersion}" Margin="8,0,0,0"
                                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource DimText}" Text="→" Margin="6,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GuiLatestVersion}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource SuccessSoftBrush}"
                                    Visibility="{Binding GuiUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="есть обновление" FontSize="10" Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Margin="10,0,8,0" VerticalAlignment="Center"
                                   Text="{Binding GuiUpdateBadgeText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PageActionGhost}" Content="Проверить" Command="{Binding CheckGuiUpdateCommand}" />
                            <Button Style="{StaticResource PageActionPrimary}" Content="{Binding GuiUpdateButtonText}" Margin="8,0,0,0"
                                    Command="{Binding UpdateGuiCommand}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Проверять GUI при запуске" Margin="0,8,0,0"
                              IsChecked="{Binding Settings.AutoCheckGuiUpdates, Mode=TwoWay}" />

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.35" Margin="0,12,0,0" />

                    <!-- Движок -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyText}" Text="Движок" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding EngineVersion}" Margin="8,0,0,0"
                                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource DimText}" Text="→" Margin="6,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LatestVersion}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource WarningSoftBrush}"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="есть обновление" FontSize="10" Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding UpdateBadgeText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource DimText}" FontSize="10.5" Opacity="0.7" Text="{Binding ReleaseDate}"
                                       Visibility="{Binding HasRelease, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PageActionPrimary}" Content="{Binding UpdateEngineButtonText}"
                                    Command="{Binding UpdateEngineCommand}" />
                            <Button Style="{StaticResource PageActionGhost}" Content="Релиз" Margin="8,0,0,0"
                                    Command="{Binding OpenReleasePageCommand}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,8,0,0" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Style="{StaticResource ThinProgress}" Height="3" Value="{Binding Progress, Mode=OneWay}"
                                     Maximum="100" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource DimText}" FontSize="10.5" Margin="0,4,0,0" Text="{Binding Status}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding AvailableEngineBackups}"
                                  SelectedItem="{Binding SelectedEngineBackup, Mode=TwoWay}" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Style="{StaticResource PageActionGhost}" Content="Откат" Margin="8,0,0,0"
                                VerticalAlignment="Center" Command="{Binding RollbackEngineCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Согласованность -->
            <Border Style="{StaticResource PageCard}" Padding="14,10"
                    Background="{Binding ConsistencyKey, Converter={StaticResource SoftSeverityBrush}}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                       Foreground="{Binding ConsistencyKey, Converter={StaticResource SeverityBrush}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyText}" Text="Согласованность" Margin="8,0,0,0"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding ConsistencyText}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Consistency.Checks}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse Width="5" Height="5" Fill="{Binding SeverityKey, Converter={StaticResource SeverityBrush}}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" Margin="8,0,0,0"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding Details}" Margin="8,0,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </Border>

            <!-- Списки и hosts -->
            <Border Style="{StaticResource PageCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="СПИСКИ И HOSTS" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyText}" Text="ipset-all.txt — IP для ipset" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Style="{StaticResource PageActionGhost}" Content="Обновить"
                                VerticalAlignment="Center" Command="{Binding UpdateIpsetCommand}" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.4" Margin="0,10,0,0" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="{Binding HostsStatusKey, Converter={StaticResource SeverityBrush}}"
                                         VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource BodyText}" Text="hosts" Margin="8,0,0,0" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding HostsStatus}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Foreground="{Binding HostsStatusKey, Converter={StaticResource SeverityBrush}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PageActionGhost}" Content="Проверить" Command="{Binding CheckHostsCommand}" />
                            <Button Style="{StaticResource PageActionPrimary}" Content="Обновить" Margin="8,0,0,0"
                                    Command="{Binding UpdateHostsCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Автообновления и ссылки -->
            <Border Style="{StaticResource PageCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SectionText}" Text="АВТООБНОВЛЕНИЯ" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="При запуске" Margin="0,10,0,0"
                                  IsChecked="{Binding Settings.AutoCheckEngineUpdates, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Сохранять списки" Margin="0,8,0,0"
                                  IsChecked="{Binding Settings.PreserveUserDataOnUpdate, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Pre-release" Margin="0,8,0,0"
                                  IsChecked="{Binding Settings.IncludePrerelease, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Проверять GUI" Margin="0,8,0,0"
                                  IsChecked="{Binding Settings.AutoCheckGuiUpdates, Mode=TwoWay}" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Opacity="0.4" Margin="20,2,20,2" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionText}" Text="ССЫЛКИ" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource PageActionGhost}" Content="GUI GitHub" Command="{Binding OpenGuiRepoCommand}" />
                            <Button Style="{StaticResource PageActionGhost}" Content="Движок GitHub" Margin="8,0,0,0"
                                    Command="{Binding OpenRepoCommand}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource PageActionGhost}" Content="Журнал" Command="{Binding OpenLogsCommand}" />
                            <Button Style="{StaticResource PageActionGhost}" Content="Папка движка" Margin="8,0,0,0"
                                    Command="{Binding OpenEngineFolderCommand}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource DimText}" FontSize="10.5" Opacity="0.6" Margin="0,8,0,0"
                                   Text="{Binding EnginePathText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Заметки релиза -->
            <Border Style="{StaticResource PageCard}" Padding="14,10"
                    Visibility="{Binding HasRelease, Converter={StaticResource BoolToVis}}">
                <Expander Header="Заметки релиза" IsExpanded="False" Background="Transparent" BorderThickness="0">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding ReleaseTitle}" />
                        <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0" Text="{Binding ReleaseDate}" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding ReleaseNotes}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" MaxHeight="200" />
                        <Button Style="{StaticResource PageActionGhost}" Content="Открыть релиз" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Command="{Binding OpenReleasePageCommand}" />
                    </StackPanel>
                </Expander>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
