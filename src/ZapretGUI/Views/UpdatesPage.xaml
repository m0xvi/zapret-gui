<UserControl x:Class="ZapretGui.Views.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="24,20,20,26">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Обновления" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Движок, списки доменов и файл hosts подтягиваются из официального репозитория Flowseal/zapret-discord-youtube" />
                </StackPanel>
                <WrapPanel Grid.Column="1" MaxWidth="330" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="Проверить обновления"
                            Command="{Binding CheckCommand}"
                            ToolTip="Спросить GitHub о последней версии движка (через API, резервно — файл version.txt)" />
                    <Button Style="{StaticResource GhostButton}" Content="Открыть репозиторий" Margin="8,0,0,0"
                            Command="{Binding OpenRepoCommand}"
                            ToolTip="Открыть репозиторий Flowseal/zapret-discord-youtube в браузере" />
                </WrapPanel>
            </Grid>

            <!-- Сообщения и статус -->
            <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,11"
                    Background="{Binding MessageKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" />
            </Border>

            <Border Margin="0,10,0,0" CornerRadius="10" Padding="14,11"
                    Background="{Binding OperationResultKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding OperationResultVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding OperationResultTitle}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding OperationResultDetails}"
                               TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <!-- Согласованность файлов -->
            <Border Margin="0,10,0,0" CornerRadius="10" Padding="14,11"
                    Background="{Binding ConsistencyKey, Converter={StaticResource SoftSeverityBrush}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="СОГЛАСОВАННОСТЬ ДВИЖКА" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding ConsistencyText}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Consistency.Checks}" Margin="0,5,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Style="{StaticResource Dot}" Width="7" Height="7"
                                            Background="{Binding SeverityKey, Converter={StaticResource SeverityBrush}}" />
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding Name}" Margin="7,0,0,0" />
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding Details}" Margin="6,0,0,0" />
                                </WrapPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Основные карточки обновления -->
            <!-- 1. Движок zapret — ПЕРЕДЕЛАНО 1.6.6: карточный дизайн с версиями и ручным откатом -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <Grid Margin="16,12,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE8B5;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionText}" Text="ДВИЖОК ZAPRET (ОБХОД)" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource DimText}" Text="winws.exe + WinDivert из Flowseal/zapret-discord-youtube" FontSize="11" />
                        </StackPanel>
                        <Border Style="{StaticResource Badge}" VerticalAlignment="Center" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="АКТУАЛЬНО" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                <Setter Property="Text" Value="ОБНОВЛЕНИЕ" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Grid Margin="16,12,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="9" Padding="12,10" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DimText}" Text="УСТАНОВЛЕНА" FontSize="10" FontWeight="Bold" />
                                <TextBlock Style="{StaticResource StatValueText}" Text="{Binding EngineVersion}" FontSize="16" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding LastCheckText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="9" Padding="12,10" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DimText}" Text="НА GITHUB" FontSize="10" FontWeight="Bold" />
                                <TextBlock Style="{StaticResource StatValueText}" Text="{Binding LatestVersion}" FontSize="16" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding UpdateBadgeText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Margin="20,12,20,0">
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding UpdateEngineButtonText}" MinHeight="38" Padding="18,8"
                                    Command="{Binding UpdateEngineCommand}"
                                    ToolTip="Скачать свежий релиз, безопасно остановить обход, заменить файлы (ваши списки сохранятся) и перезапустить обход" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Страница релиза" Margin="8,0,0,0" Padding="14,7"
                                    Command="{Binding OpenReleasePageCommand}" ToolTip="Открыть страницу релиза на GitHub" />
                            <Button Style="{StaticResource GhostButton}" Content="Отмена" Margin="8,0,0,0" Padding="10,7"
                                    Command="{Binding CancelCommand}" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" ToolTip="Прервать проверку" />
                        </WrapPanel>

                        <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Padding="12,10" Background="{DynamicResource CardBrush}"
                                Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Status}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProgressPercentText}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                               Visibility="{Binding Indeterminate, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                </Grid>
                                <ProgressBar Style="{StaticResource ThinProgress}" Height="6" Margin="0,8,0,0"
                                             Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                             IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Padding="14,12">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE7AD;" FontFamily="{DynamicResource IconFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Style="{StaticResource SectionText}" Text="РУЧНОЙ ОТКАТ" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource ElevatedBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EngineBackupText}" Style="{StaticResource DimText}" FontSize="11" />
                                    </Border>
                                </WrapPanel>
                                <ComboBox Style="{StaticResource AppComboBox}" Margin="0,10,0,0" MinHeight="36"
                                          ItemsSource="{Binding AvailableEngineBackups}"
                                          SelectedItem="{Binding SelectedEngineBackup, Mode=TwoWay}"
                                          ToolTip="Выберите сохранённую версию движка для ручного отката">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Style="{StaticResource SecondaryButton}" Content="Вернуться к выбранной версии" Padding="14,7" Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Command="{Binding RollbackEngineCommand}" ToolTip="Остановить обход, восстановить файлы выбранной версии" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Padding="12,10" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="11" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Обновление сохраняет: *-user.txt, режимы ipset/игрового фильтра, фейки." TextWrapping="Wrap" FontSize="11" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding EnginePathText}" FontSize="10.5" Margin="0,7,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding EnginePathText}" Foreground="{DynamicResource TextMutedBrush}" />
                                <Button Style="{StaticResource GhostButton}" Content="Открыть папку движка" FontSize="11" Padding="10,5" Margin="0,7,0,0" HorizontalAlignment="Left"
                                        Command="{Binding OpenEngineFolderCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" Margin="16,12,16,0" />
                </StackPanel>
            </Border>

            <!-- 2. Списки и файл hosts -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="СПИСКИ И ФАЙЛ HOSTS" />

                    <!-- IPSET -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource BodyText}" Text="Список ipset-all.txt" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource DimText}" Text="Актуальный список IP-адресов для фильтра ipset. Обновляется отдельно от движка." Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Обновить список"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding UpdateIpsetCommand}" Padding="14,7"
                                ToolTip="Скачать свежий ipset-all.txt из репозитория (при режимах none/any пишется в резервную копию)" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- HOSTS -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding HostsIsUpToDate, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Style="{StaticResource BodyText}" Text="Файл hosts (GitHub-адреса)" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding HostsStatus}" Margin="0,4,0,0"
                                       Foreground="{Binding HostsStatusKey, Converter={StaticResource SeverityBrush}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Обновить hosts" Padding="14,7"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding UpdateHostsCommand}"
                                ToolTip="Проверить файл hosts и автоматически применить актуальные записи GitHub при необходимости" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Настройки обновлений движка -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionText}" Text="НАСТРОЙКИ ОБНОВЛЕНИЙ ДВИЖКА" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Проверять при запуске"
                              IsChecked="{Binding Settings.AutoCheckEngineUpdates, Mode=TwoWay}"
                              ToolTip="Тихо проверять новые версии движка при каждом запуске приложения" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Сохранять мои списки при обновлении" Margin="0,10,0,0"
                              IsChecked="{Binding Settings.PreserveUserDataOnUpdate, Mode=TwoWay}"
                              ToolTip="Не затирать *-user.txt, режимы фильтров и резерв ipset при обновлении движка" />
                </StackPanel>
            </Border>

            <!-- 5. Обновление Zapret GUI — ПЕРЕДЕЛАНО 1.6.6: две карточки версий + статус -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <Grid Margin="16,12,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFont}" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionText}" Text="ОБНОВЛЕНИЕ ZAPRET GUI" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource DimText}" Text="Самообновление portable EXE с проверкой SHA-256" FontSize="11" />
                        </StackPanel>
                        <Border Style="{StaticResource Badge}" VerticalAlignment="Center" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="GUI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <Grid Margin="16,12,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="9" Padding="12,10" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DimText}" Text="УСТАНОВЛЕНА" FontSize="10" FontWeight="Bold" />
                                <TextBlock Style="{StaticResource StatValueText}" Text="{Binding GuiCurrentVersion}" FontSize="16" Margin="0,4,0,0" />
                                <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,8,0,0" Background="{DynamicResource SuccessSoftBrush}" Visibility="{Binding GuiUpdateAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <TextBlock Text="Актуальная" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="9" Padding="12,10" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DimText}" Text="ПОСЛЕДНЯЯ" FontSize="10" FontWeight="Bold" />
                                <TextBlock Style="{StaticResource StatValueText}" Text="{Binding GuiLatestVersion}" FontSize="16" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding GuiUpdateBadgeText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="20,12,20,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding GuiUpdateStatus, Converter={StaticResource StringToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="11" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource DimText}" Text="{Binding GuiUpdateStatus}" TextWrapping="Wrap" FontSize="11" />
                        </Grid>
                    </Border>

                    <WrapPanel Margin="20,12,20,0" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Проверить GUI" Padding="14,7" MinHeight="36"
                                Command="{Binding CheckGuiUpdateCommand}" ToolTip="Проверить официальный GitHub-релиз Zapret GUI без установки" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding GuiUpdateButtonText}" Margin="8,0,0,0" Padding="18,8" MinHeight="36"
                                Command="{Binding UpdateGuiCommand}" ToolTip="Скачать portable EXE, проверить SHA-256, сохранить резервную копию и перезапустить GUI" />
                    </WrapPanel>

                    <Border Margin="20,12,20,16" Padding="10,8" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource BodyText}" Text="Проверять при запуске" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Style="{StaticResource DimText}" Text="Только уведомление, без автоперезапуска" FontSize="11" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" IsChecked="{Binding Settings.AutoCheckGuiUpdates, Mode=TwoWay}" Content="" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="20,0,20,16" Style="{StaticResource DimText}" Text="{Binding Settings.GuiRepo}" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Settings.GuiRepo}" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Border>

<!-- Резервные копии — убрано в 1.6.6 по запросу (блок hosts backups) -->

        </StackPanel>
    </ScrollViewer>
</UserControl>
