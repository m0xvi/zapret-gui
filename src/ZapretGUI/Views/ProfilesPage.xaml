<UserControl x:Class="ZapretGui.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZapretGui.Views.Controls"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="24,20,20,26">

            <!-- Заголовок страницы -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Профили и Переносимость" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Управление пресетами настроек, полные резервные копии (ZIP) и портативный режим" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="Создать профиль"
                            Command="{Binding CreateProfileFromCurrentCommand}"
                            ToolTip="Сохранить текущие параметры в новый профиль" />
                </WrapPanel>
            </Grid>

            <!-- Баннер статуса -->
            <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,11"
                    Background="{Binding StatusKey, Converter={StaticResource SoftSeverityBrush}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource CardBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" />
                    </Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding StatusText}"
                               Margin="10,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource BusySpinner}" Width="16" Height="16" BorderThickness="2" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Подсказка для новичка: Профили -->
            <Border Margin="0,16,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" Text="Профили — сохранения ваших настроек (стратегия, списки, фильтры). Сохраните рабочий набор — при сбое восстановите за клик. Автопереключение по сети — в Настройках → Сеть. Двойной клик по профилю — применить." />
                </Grid>
            </Border>

            <!-- Вкладки управления -->
            <controls:SegmentedControl Margin="0,16,0,0"
                                       ItemsSource="{Binding SubTabs}"
                                       SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" />

            <!-- ===================== ВКЛАДКА 0: ПРОФИЛИ ===================== -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsProfilesTabVisible, Converter={StaticResource BoolToVis}}">

                <!-- Автопереключение по сети — P0 1.7.0 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE8AF;" FontFamily="{DynamicResource IconFont}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionText}" Text="АВТОПЕРЕКЛЮЧЕНИЕ ПО СЕТИ" Margin="0,0,0,1"/>
                                <TextBlock Style="{StaticResource DimText}" FontSize="11" Text="Автоматический выбор профиля при смене Wi-Fi / сети или при сбое стратегии"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="↻ Обновить" Padding="10,6" FontSize="11"
                                    Command="{Binding RefreshNetworkCommand}" ToolTip="Перечитать текущую сеть (SSID, шлюз, интерфейс)" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource InnerCard}" Margin="0,12,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource DimText}" Text="Текущая сеть:" Margin="0,2,0,2" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding CurrentNetworkDisplay}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource DimText}" Text="Отпечаток:" Margin="0,2,0,2" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource DimText}" FontSize="11" Text="{Binding CurrentNetworkFingerprint}" TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,2"/>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="⎘" Padding="6,2" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding CopyNetworkFingerprintCommand}" ToolTip="Скопировать отпечаток в буфер обмена" />
                                </Grid>
                                <Border Style="{StaticResource Divider}" Margin="0,10,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Style="{StaticResource SwitchCheckBox}" Content="При смене сети" IsChecked="{Binding AutoSwitchOnNetworkChange, Mode=TwoWay}" ToolTip="Автоматически применять привязанный профиль при смене Wi-Fi / проводной сети" Margin="0,0,8,0"/>
                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" Content="При сбое стратегии" IsChecked="{Binding AutoSwitchOnFailure, Mode=TwoWay}" ToolTip="При диагностированном сбое стратегии попробовать привязанный к сети профиль" Margin="8,0,0,0"/>
                                </Grid>
                                <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="8" Background="{Binding AutoSwitchStatusKey, Converter={StaticResource SoftSeverityBrush}}" Visibility="{Binding AutoSwitchStatusVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="11" FontWeight="SemiBold" Text="{Binding AutoSwitchStatus}" TextWrapping="Wrap" Foreground="{Binding AutoSwitchStatusKey, Converter={StaticResource SeverityBrush}}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Style="{StaticResource SecondaryButton}" Content="📌 Привязать выбранный к текущей сети" Padding="12,6" FontSize="11.5"
                                    Command="{Binding BindToCurrentNetworkCommand}" ToolTip="Сохранить текущую сеть (SSID/шлюз) в выбранный профиль — он будет включаться автоматически"/>
                            <Button Style="{StaticResource GhostButton}" Content="✕ Отвязать" Margin="8,0,0,0" Padding="12,6" FontSize="11.5"
                                    Command="{Binding UnbindNetworkCommand}" ToolTip="Снять привязку профиля к сети"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Подсказка: создайте отдельные профили для «Домашний Wi-Fi» и «Мобильный», привяжите каждый к своей сети — переключение в фоне через ~30с (cooldown 60с). Enter в списке стратегий — быстрое применение."/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Список профилей слева — ПЕРЕДЕЛАНО 1.6.6: карточки с акцентным выбором -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
                        <StackPanel>
                            <Grid Margin="16,14,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="&#xE8D2;" FontFamily="{DynamicResource IconFont}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionText}" Text="СПИСОК ПРОФИЛЕЙ" Margin="0,0,0,1" />
                                    <TextBlock Style="{StaticResource DimText}" FontSize="11" Text="{Binding Profiles.Count, StringFormat='{}{0} профилей'}" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="БАЗОВЫЕ + СВОИ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                </Border>
                            </Grid>

                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                     Style="{StaticResource PlainListBox}" Margin="8,10,8,0" MinHeight="260" MaxHeight="450"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource CompactRowItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ToolTip="Двойной клик — применить профиль; Enter — тоже">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="12,10" Margin="0,4,0,4" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.10" Color="Black" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentBrush}" Opacity="0.85" Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" Padding="6,2"
                                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Базовый" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding SummaryText}" Style="{StaticResource DimText}" FontSize="11" Margin="15,4,0,0" Opacity="0.85" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <Border Grid.Row="2" Style="{StaticResource Badge}" Margin="15,5,0,0" Padding="6,2" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="{Binding IsNetworkBound, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding NetworkBadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Style="{StaticResource Divider}" Margin="16,12,16,0" />
                            <WrapPanel Margin="16,12,16,14">
                                <Button Style="{StaticResource GhostButton}" Content="Импорт JSON" Padding="12,6" FontSize="11.5"
                                        Command="{Binding ImportProfileCommand}" ToolTip="Загрузить профиль из JSON файла" />
                                <Button Style="{StaticResource PrimaryButton}" Content="+ Создать" Margin="8,0,0,0" Padding="14,6" FontSize="11.5" MinWidth="110"
                                        Command="{Binding CreateProfileFromCurrentCommand}" ToolTip="Создать из текущих параметров" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Карточка выбранного профиля справа -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                        <StackPanel DataContext="{Binding SelectedProfile}">
                            <TextBlock Style="{StaticResource SectionText}" Text="ДЕТАЛИ ПРОФИЛЯ" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,12" TextWrapping="Wrap" />

                            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Стратегия -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DimText}" Text="Стратегия обхода:" Margin="0,3,0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding StrategyName}" Margin="0,3,0,3" />

                                    <!-- DNS -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DimText}" Text="DNS профиль:" Margin="0,3,0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding DnsProfileId}" Margin="0,3,0,3" />

                                    <!-- Игровой фильтр -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DimText}" Text="Игровой фильтр:" Margin="0,3,0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding GameFilter}" Margin="0,3,0,3" />

                                    <!-- Режим игры -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DimText}" Text="Игровой режим:" Margin="0,3,0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyText}"
                                               Text="{Binding GameModeActive}" Margin="0,3,0,3" />

                                    <!-- Привязка к сети -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DimText}" Text="Привязка к сети:" Margin="0,3,0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding NetworkBadgeText}" Margin="0,3,0,3" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DimText}" Text="Сеть:" Margin="0,3,0,3" Visibility="{Binding IsNetworkBound, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DimText}" FontSize="11" Text="{Binding NetworkDisplayName}" TextWrapping="Wrap" Margin="0,3,0,3" Visibility="{Binding IsNetworkBound, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>

                            <!-- Кнопки управления профилем -->
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Применить этот профиль"
                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Применить параметры стратегии, DNS и фильтров этого профиля" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Дублировать" Margin="8,0,0,0"
                                        Command="{Binding DataContext.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Создать копию профиля для редактирования" />
                                <Button Style="{StaticResource GhostButton}" Content="Экспорт в JSON" Margin="8,0,0,0"
                                        Command="{Binding DataContext.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Экспортировать этот профиль в файл" />
                                <Button Style="{StaticResource DangerButton}" Content="Удалить" Margin="8,0,0,0"
                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                        ToolTip="Удалить пользовательский профиль" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ===================== ВКЛАДКА 1: РЕЗЕРВНЫЕ КОПИИ ===================== -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsBackupsTabVisible, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="ПОЛНЫЙ АРХИВ КОНФИГУРАЦИИ (ZIP)" />
                        <TextBlock Style="{StaticResource DimText}"
                                   Text="Архивирует settings.json, профили, сохранённые кандидаты стратегий, пользовательские списки доменов (*-user.txt) и list-exclude.txt в один переносимый ZIP-файл."
                                   TextWrapping="Wrap" />

                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Создать полный архив (ZIP)"
                                    Command="{Binding CreateFullBackupCommand}"
                                    ToolTip="Создать точку полного сохранения текущих настроек и списков" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Восстановить из выбранного архива" Margin="8,0,0,0"
                                    Command="{Binding RestoreBackupCommand}"
                                    ToolTip="Восстановить конфигурацию из выбранного ZIP-архива" />
                            <Button Style="{StaticResource GhostButton}" Content="Удалить архив" Margin="8,0,0,0"
                                    Command="{Binding DeleteBackupCommand}"
                                    ToolTip="Удалить выбранную резервную копию" />
                            <Button Style="{StaticResource GhostButton}" Content="Обновить список" Margin="8,0,0,0"
                                    Command="{Binding RefreshBackupHistoryCommand}"
                                    ToolTip="Пересканировать папку резервных копий" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Таблица архивов -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="ИСТОРИЯ РЕЗЕРВНЫХ КОПИЙ" />
                        <ListBox ItemsSource="{Binding BackupHistory}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                                 Style="{StaticResource PlainListBox}" MinHeight="180" MaxHeight="350">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource ElevatedBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE753;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource DimText}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Created, StringFormat='dd.MM.yyyy HH:mm'}"
                                                   Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Border Grid.Column="3" Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource DimText}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== ВКЛАДКА 2: ПОРТАТИВНОСТЬ И ОЧИСТКА ===================== -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsPortableTabVisible, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="ПОРТАТИВНЫЙ РЕЖИМ (PORTABLE USB MODE)" />
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding PortableModeStatusText}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   Text="Для работы в портативном режиме (на USB-флешке или в изолированной папке без записи в %APPDATA%): создайте пустой файл «portable» или папку «data» рядом с ZapretGUI.exe. Приложение автоматически перенесёт все настройки, логи и базы в эту папку." />

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Style="{StaticResource SectionText}" Text="ОЧИСТКА СИСТЕМЫ ПЕРЕД ПЕРЕНОСОМ" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   Text="Если вы использовали приложение с правами администратора, в системе могли остаться: служба Windows zapret, драйвер перехвата WinDivert, задача автозапуска и изменённые DNS. Нажмите кнопку ниже, чтобы безопасно выгрузить и удалить все системные компоненты." />

                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource DangerButton}" Content="Полная очистка следов в Windows"
                                    Command="{Binding CleanSystemCommand}"
                                    ToolTip="Остановить обход, удалить службы zapret и WinDivert, сбросить DNS в DHCP, удалить автозапуск" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
