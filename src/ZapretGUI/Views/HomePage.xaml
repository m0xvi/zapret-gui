<UserControl x:Class="ZapretGui.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZapretGui.Views.Controls"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="24,20,20,26">

            <!-- Заголовок страницы -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Обзор" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Запуск обхода, служба Windows, фильтры и состояние движка" />
                </StackPanel>
                <WrapPanel Grid.Column="1" MaxWidth="420" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="Стратегии"
                            Command="{Binding OpenStrategiesCommand}"
                            ToolTip="Список стратегий обхода из .bat файлов движка: выбор, описание, запуск" />
                    <Button Style="{StaticResource GhostButton}" Content="🎙️ Voice RTC" Margin="8,0,0,0"
                            Command="{Binding OpenDiscordVoiceFixCommand}"
                            ToolTip="Диагностика голосовых серверов Discord, очистка кэша и сброс сети в 1 клик" />
                    <Button Style="{StaticResource GhostButton}" Content="Диагностика" Margin="8,0,0,0"
                            Command="{Binding OpenDiagnosticsCommand}"
                            ToolTip="Проверка типичных проблем: права, службы, VPN, прокси, конфликты — с автоисправлением" />
                </WrapPanel>
            </Grid>

            <!-- Сообщение о результате действия -->
            <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,11"
                    Background="{Binding MessageKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" Margin="0,0,30,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE894;" Width="26" Height="26"
                            HorizontalAlignment="Right" Command="{Binding ClearMessageCommand}" ToolTip="Скрыть" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,11"
                    Background="{Binding ReadinessKey, Converter={StaticResource SoftSeverityBrush}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource CardBrush}">
                        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding ReadinessKey, Converter={StaticResource SeverityBrush}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                        <TextBlock Style="{StaticResource SectionText}" Text="ГОТОВНОСТЬ ПРИЛОЖЕНИЯ" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding ReadinessText}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource DimText}" Text="{Binding ReadinessDetails}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Открыть мастер"
                            Command="{Binding OpenFirstLaunchCommand}"
                            Visibility="{Binding ReadinessActionVisible, Converter={StaticResource BoolToVis}}"
                            ToolTip="Перейти к мастеру первого запуска и выбрать безопасный режим" />
                </Grid>
            </Border>

            <!-- Порядок действий — явные ссылки на инструменты (единый стиль с Настройками) -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE9CE;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource SectionText}" Text="ПОРЯДОК ДЕЙСТВИЙ" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource DimText}" Text="Нажмите по порядку — каждая ссылка ведёт прямо в нужный инструмент. Делайте слева направо." TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="1" Foreground="{DynamicResource OnAccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Проверьте обновления движка" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Скачайте свежий zapret, если версия устарела или движок не установлен." TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Обновления →" VerticalAlignment="Center" Command="{Binding CheckUpdatesCommand}" ToolTip="Перейти к проверке обновлений движка" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource InfoBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Запустите диагностику системы" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Находит конфликты VPN/прокси, службы WinDivert и предлагает «Исправить» в 1 клик." TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Диагностика →" VerticalAlignment="Center" Command="{Binding OpenDiagnosticsCommand}" ToolTip="Открыть единый центр проверки" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource InnerCard}" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Подберите рабочую стратегию" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Нажмите «Проверить все» — приложение тестирует 22 стратегии и подсвечивает зелёным работающие." TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Стратегии →" VerticalAlignment="Center" Command="{Binding OpenStrategiesCommand}" ToolTip="Открыть каталог стратегий" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource InnerCard}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Включите обход и проверьте сайты" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Нажмите круглую кнопку — зелёное свечение = работает. Ниже проверьте YouTube/Discord." TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Проверить ↓" VerticalAlignment="Center" Command="{Binding TestConnectionCommand}" ToolTip="Запустить проверку YouTube/Discord/GitHub ниже" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DimText}" Margin="0,10,0,0" Text="После 4 шагов: если что-то не работает — вернитесь к диагностике, попробуйте другую стратегию или смените фильтр в карточке «Фильтры» ниже." TextWrapping="Wrap" FontSize="11" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,16,0,0">

                <!-- ================= ОСНОВНОЙ БЛОК ================= -->
                <StackPanel>

                    <!-- Статус -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource PowerButton}" VerticalAlignment="Top"
                                    Command="{Binding ToggleBypassCommand}"
                                    ToolTip="Включить или выключить обход — как кнопка питания в VPN-клиентах. Зелёное свечение означает, что запрет активен и работает." />

                            <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding StatusText}" FontSize="20" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding StrategyText}" Margin="0,4,0,0" />
                                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}">
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding UptimeText, StringFormat=Время работы: {0}}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding PidText, StringFormat=Процесс: {0}}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding ServiceText}" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource BusySpinner}">
                                        <TextBlock Text="…" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Style="{StaticResource MutedText}" Text="Выполняю операцию…" Margin="8,2,0,0" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="160" MaxWidth="220">
                                <Button Style="{StaticResource SecondaryButton}" Content="Установить в службу"
                                        Command="{Binding InstallServiceCommand}" MinHeight="38" Padding="14,8"
                                        Visibility="{Binding ServiceInstalled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                        ToolTip="Создать и запустить службу Windows zapret с выбранной стратегией" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Переустановить службу"
                                        Command="{Binding ReinstallServiceCommand}" MinHeight="36" Padding="12,6" Margin="0,0,0,6"
                                        Visibility="{Binding ServiceInstalled, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Обновить параметры работающей службы на текущую выбранную стратегию" />
                                <Button Style="{StaticResource DangerButton}" Content="Удалить службу"
                                        Command="{Binding RemoveServiceCommand}" MinHeight="36" Padding="12,6"
                                        Visibility="{Binding ServiceInstalled, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Остановить и полностью удалить службу zapret и WinDivert" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Конфликт со старым запретом -->
                    <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,11"
                            Background="{DynamicResource WarningSoftBrush}"
                            Visibility="{Binding LegacyWarningVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding LegacyWarningText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Решить конфликт"
                                    VerticalAlignment="Center" Command="{Binding ResolveLegacyCommand}"
                                    ToolTip="Выбрать: взять управление на себя, скопировать настройки старого запрета или просто выключить его" />
                        </Grid>
                    </Border>

                    <!-- Игровой опыт — единый стиль с Настройками (иконка + подсказка) -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7FC;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionText}" Text="ИГРОВОЙ ОПЫТ" Margin="0,0,0,2" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Детект игр и оптимизация задержек — как в Настройках → Игры" FontSize="11" />
                                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" Margin="0,0,8,0">
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Dot}"
                                                        Background="{Binding IsGameRunning, Converter={StaticResource SeverityBrush}}" />
                                                <TextBlock Text="{Binding GameStatusBadgeText}" Style="{StaticResource BodyText}" FontSize="12" Margin="6,0,0,0" FontWeight="SemiBold" />
                                            </WrapPanel>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}">
                                            <TextBlock Text="{Binding GameModeStatusText}" Style="{StaticResource DimText}" FontSize="12" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding GamingNetworkStatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                            Command="{Binding ToggleGameModeCommand}"
                                            ToolTip="Включить или выключить игровой режим (пропуск игрового UDP для минимального инпут-лага)">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎮 " FontSize="12" />
                                            <TextBlock Text="Игровой режим" FontWeight="SemiBold" />
                                        </WrapPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Content="🗗 HUD Виджет" Margin="0,0,8,0"
                                            Command="{Binding OpenOverlayCommand}"
                                            ToolTip="Открыть плавающий компактный мини-виджет поверх экрана" />
                                    <Button Style="{StaticResource GhostButton}" Content="Твики сети (TCP/IP)"
                                            Command="{Binding ApplyGamingTweaksCommand}"
                                            ToolTip="Отключить алгоритм Nagle (TCPNoDelay) и задержку ACK (TcpAckFrequency) для активного адаптера" />
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Фильтры — продвинутая настройка, свёрнутая визуально -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource SectionText}" Text="ФИЛЬТРЫ · ДЛЯ ПРОДВИНУТЫХ" Margin="0,0,0,2" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Можно не трогать — по умолчанию работает для большинства. Меняйте только если не работают игры или нужен максимум обхода." TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyText}" Text="Игровой фильтр" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                               Text="Обработка портов выше 1023 (игры, сторонние сервисы). После изменения перезапустите обход." />
                                </StackPanel>
                                <controls:SegmentedControl Grid.Column="1" MinWidth="380" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           ItemsSource="{Binding GameFilterOptions}"
                                                           SelectedIndex="{Binding GameFilterIndex, Mode=TwoWay}"
                                                           ToolTip="Игровой фильтр (файл utils\game_filter.enabled): обрабатывать ли порты выше 1023 — игры, голосовые чаты, сторонние сервисы. TCP+UDP — максимум совместимости." />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyText}" Text="Фильтр ipset" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                                               Text="loaded — проверять IP по списку, none — отключить фильтр, any — фильтровать любые IP." />
                                </StackPanel>
                                <controls:SegmentedControl Grid.Column="1" MinWidth="340" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           ItemsSource="{Binding IpsetOptions}"
                                                           SelectedIndex="{Binding IpsetIndex, Mode=TwoWay}"
                                                           ToolTip="Фильтр ipset проверяет IP-адреса по списку ipset-all.txt. loaded — проверять по списку (обычный режим), none — отключить фильтр, any — фильтровать любые IP (максимум обхода, выше нагрузка)." />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" Text="Проверка обновлений для .bat" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource DimText}"
                                               Text="Флаг utils\check_updates.enabled — используется при запуске обхода через .bat-файлы." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center"
                                          IsChecked="{Binding BatAutoUpdate, Mode=TwoWay}" Content=""
                                          ToolTip="Флаг для запуска через .bat-файлы: проверять ли обновления движка при старте general*.bat. На работу через это приложение не влияет." />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Проверка соединения — единый стиль (иконка как в Настройках) -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource InfoSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE774;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionText}" Text="ПРОВЕРКА СОЕДИНЕНИЯ" Margin="0,0,0,2" />
                                    <TextBlock Style="{StaticResource DimText}" Text="YouTube, Discord, GitHub и ваши адреса" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Проверить"
                                        HorizontalAlignment="Right" Command="{Binding TestConnectionCommand}" Padding="14,7"
                                        ToolTip="Проверяет доступность YouTube, Discord и GitHub: сначала TCP-подключение, затем HTTP-запрос" />
                            </Grid>
                            <TextBlock Style="{StaticResource DimText}"
                                       Text="Быстрая проверка доступности YouTube, Discord, GitHub и добавленных вами адресов." />
                            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0"
                                    Visibility="{Binding ConnectionBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource BodyText}" Text="Проверяю соединение" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding ConnectionProgressPercentText}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding ConnectionProgressText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Style="{StaticResource ThinProgress}"
                                                 Value="{Binding ConnectionProgressValue, Mode=OneWay}"
                                                 Maximum="{Binding ConnectionProgressMaximum, Mode=OneWay}"
                                                 IsIndeterminate="{Binding ConnectionProgressIndeterminate, Mode=OneWay}"
                                                 Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" Content="Добавить адрес для проверки"
                                    Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Command="{Binding AddConnectionTargetCommand}"
                                    ToolTip="Открыть отдельное окно и добавить URL или домен в список проверки" />
                            <ItemsControl ItemsSource="{Binding ConnectionTargets}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                       Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <Button Style="{StaticResource SmallIconButton}" Content="&#xE70F;" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.EditConnectionTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Изменить адрес или название" />
                                                <Button Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                                        Command="{Binding DataContext.RemoveConnectionTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Удалить адрес из проверки соединения" />
                                            </WrapPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding ConnectionChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Dot}"
                                                    Background="{Binding SeverityKey, Converter={StaticResource SeverityBrush}}" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource DimText}" Text="{Binding Details}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Style="{StaticResource MutedText}"
                                                       Text="{Binding StatusText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= ПРАВАЯ КОЛОНКА ================= -->
                <StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE8B5;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource SectionText}" Text="ДВИЖОК ZAPRET" Margin="0,0,0,2" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Версия и путь к сборке" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource StatValueText}" Text="{Binding EngineVersionText}" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding LatestVersionText, StringFormat=Последняя на GitHub: {0}}" Margin="0,4,0,0" />

                            <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Доступно обновление" />
                                    <TextBlock Style="{StaticResource DimText}"
                                               Text="Обновление сохранит ваши списки, флаги фильтров и активные фейки." />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource PrimaryButton}" Content="Перейти к обновлениям"
                                    Margin="0,14,0,0" Command="{Binding CheckUpdatesCommand}"
                                    ToolTip="Проверка новых версий движка, скачивание и установка, списки ipset и файл hosts" />
                            <Button Style="{StaticResource GhostButton}" Content="Открыть папку движка"
                                    Margin="0,6,0,0" Command="{Binding OpenEngineFolderCommand}"
                                    ToolTip="Открыть папку со сборкой zapret в проводнике (bin, lists, .bat файлы)" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding StrategyCountText}" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding EnginePathText}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding EnginePathText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE9CE;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource SectionText}" Text="ЕСЛИ НЕ РАБОТАЕТ" Margin="0,0,0,2" />
                                    <TextBlock Style="{StaticResource DimText}" Text="Короткая памятка" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="1. Попробуйте другую стратегию (обычно помогает одна из группы ALT или FAKE TLS AUTO)." />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Text="2. Включите игровой фильтр, если не работают игры с UDP." />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Text="3. Нажмите «Диагностика» — она проверит VPN, прокси, службы и конфликты." />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Text="4. Включите безопасный DNS (DoH) в браузере или Windows 11." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource SectionText}" Text="О ДВИЖКЕ" Margin="0,0,0,2" />
                                    <TextBlock Style="{StaticResource DimText}" Text="winws.exe и WinDivert" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="Обход выполняется утилитой winws.exe (zapret от bol-van) со стратегиями из сборки Flowseal." />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="WinDivert может вызывать реакцию антивируса — это инструмент перехвата трафика, а не вирус." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
