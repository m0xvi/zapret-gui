<UserControl x:Class="ZapretGui.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZapretGui.Views.Controls"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,24" CanContentScroll="False">
        <StackPanel Margin="24,20,20,32">

            <!-- Заголовок страницы -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Обзор" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Запуск обхода, служба Windows, фильтры и состояние движка" />
                </StackPanel>
                <!-- Верхние кнопки Стратегии/Voice/Диагностика удалены по дизайну 23.09 — навигация через боковое меню -->
            </Grid>

            <!-- Сообщение о результате действия -->
            <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,11"
                    Background="{Binding MessageKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" Margin="0,0,30,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE894;" Width="26" Height="26"
                            HorizontalAlignment="Right" Command="{Binding ClearMessageCommand}" ToolTip="Скрыть" />
                </Grid>
            </Border>

            <!-- Баннер ГОТОВНОСТЬ ПРИЛОЖЕНИЯ удалён 23.09 — дублирует статус обхода -->


            <StackPanel Margin="0,16,0,0">

                <!-- ================= ОСНОВНОЙ БЛОК ================= -->
                <StackPanel>

                    <!-- Статус -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource PowerButton}" VerticalAlignment="Top"
                                    Command="{Binding ToggleBypassCommand}"
                                    ToolTip="Включить или выключить обход — как кнопка питания в VPN-клиентах. Зелёное свечение означает, что запрет активен и работает." />

                            <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding StatusText}" FontSize="20" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding StrategyText}" Margin="0,4,0,0" />
                                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}">
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding UptimeText, StringFormat=Время работы: {0}}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding PidText, StringFormat=Процесс: {0}}" />
                                    </Border>
                                </WrapPanel>
                                <!-- Здоровье соединения — кольцо теперь отражает реальный коннект -->
                                <Border Margin="0,8,0,0" CornerRadius="7" Padding="8,5" Background="{Binding ConnectionHealthKey, Converter={StaticResource SoftSeverityBrush}}" BorderBrush="{Binding ConnectionHealthKey, Converter={StaticResource SeverityBrush}}" BorderThickness="1"
                                        Visibility="{Binding ConnectionHealthVisible, Converter={StaticResource BoolToVis}}">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="3.5" VerticalAlignment="Center" Background="{Binding ConnectionHealthKey, Converter={StaticResource SeverityBrush}}" />
                                        <TextBlock Text="{Binding ConnectionHealthText}" Style="{StaticResource DimText}" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text=" • проверьте YouTube/Discord" Style="{StaticResource DimText}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
                                    </WrapPanel>
                                </Border>
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding ServiceText}" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource BusySpinner}">
                                        <TextBlock Text="…" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Style="{StaticResource MutedText}" Text="Выполняю операцию…" Margin="8,2,0,0" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- Служба — один тумблер + обновление (P0 1.6.8) -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="180" MaxWidth="240">
                                <Border CornerRadius="9" Padding="12,10" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="Служба Windows" Style="{StaticResource SectionText}" FontSize="11" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding ServiceToggleStatusText}" Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ServicePendingText}" Style="{StaticResource DimText}" FontSize="10" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding IsServicePending, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center" Margin="0,0,0,0"
                                                      IsChecked="{Binding ServiceInstalled, Mode=OneWay}" Command="{Binding ToggleServiceCommand}"
                                                      IsEnabled="{Binding IsServiceToggleEnabled}"
                                                      ToolTip="Включить/выключить автозапуск как службу Windows (требуются права администратора)" Content=""
                                                      Visibility="{Binding IsServicePending, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <Border Style="{StaticResource BusySpinner}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding IsServicePending, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Button Style="{StaticResource SecondaryButton}" Content="Обновить службу" Padding="10,6" FontSize="11.5" Margin="0,8,0,0" MinHeight="32"
                                        Visibility="{Binding ServiceInstalled, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding IsServiceToggleEnabled}"
                                        Command="{Binding ReinstallServiceCommand}"
                                        ToolTip="Применить текущую стратегию и фильтры к уже установленной службе" />
                                <!-- Дублирующий ServiceText удалён 23.09 — статус уже в шапке -->
                            </StackPanel>
                        </Grid>
                    </Border>

                    
                    <!-- ============== Единая проверка — охват всех функций, баллы 0..10 ================= -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8D2;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Единая проверка — охват всех функций"/>
                                    <TextBlock Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" Text="Одна кнопка: стратегии×DNS (92 теста), автоподбор, обход, служба, движок, DNS/подмена, hosts/ipset, прокси/VPN/BFE и сеть — баллы 0..10 + пинг до каждого ресурса."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrimaryButton}" Content="▶ Проверить всё" Command="{Binding RunUnifiedCheckCommand}" Padding="16,8"/>
                                    <Button Style="{StaticResource GhostButton}" Content="■ Стоп" Margin="0,6,0,0" Command="{Binding CancelUnifiedCheckCommand}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionText}" Text="КАК ЧИТАТЬ БАЛЛЫ" Foreground="{DynamicResource InfoBrush}"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="8–10 🟢 отлично"/>
                                        </Border>
                                        <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                                            <TextBlock FontSize="11" Text="5–7 🟡 средне"/>
                                        </Border>
                                        <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="0–4 🔴 плохо"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" Text="Балл варианта = доля успешных проб (YouTube/Discord/GitHub…) + бонус за скорость. Система = сумма 10-балльных оценок по всем функциям."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Visibility="{Binding UnifiedLastRunVisible, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ElevatedBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding UnifiedLastRunText}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="Очистить" Padding="10,4" Command="{Binding ClearUnifiedCheckCommand}"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Visibility="{Binding IsUnifiedRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding UnifiedStatusText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="{Binding UnifiedProgressPercentText}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </Grid>
                                    <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="{Binding UnifiedProgressMaximum, Mode=OneWay}" Value="{Binding UnifiedProgressValue, Mode=OneWay}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Visibility="{Binding IsUnifiedRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding UnifiedSummaryText}" TextWrapping="Wrap" Visibility="{Binding UnifiedResultVisible, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0" Text="{Binding UnifiedAdviceText}" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Visibility="{Binding UnifiedResultVisible, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasUnifiedVariants, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource PrimaryButton}" Content="✅ Применить лучший вариант" Command="{Binding ApplyBestUnifiedVariantCommand}"/>
                                        <TextBlock Style="{StaticResource DimText}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding BestUnifiedVariantName, StringFormat=Лидер: {0}}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Visibility="{Binding HasUnifiedResults, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionText}" Text="СИСТЕМНЫЕ ФУНКЦИИ — БАЛЛЫ"/>
                                        <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{DynamicResource AccentSoftBrush}" Padding="7,3">
                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding UnifiedSystemScoreText}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding UnifiedSystemScores}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="54"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"/>
                                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding Details}" FontSize="11" TextWrapping="Wrap" Opacity="0.85"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="{Binding FixHint}" FontSize="11" Margin="8,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220" Opacity="0.7" Visibility="{Binding FixHint, Converter={StaticResource StringToVis}}"/>
                                                        <Border Grid.Column="2" CornerRadius="8" Padding="6,3" Background="{Binding StatusKey, Converter={StaticResource SoftSeverityBrush}}" BorderBrush="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding ScoreText}" FontWeight="Bold" FontSize="12" Foreground="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerCard}" Margin="0,8,0,0" Visibility="{Binding ConnectionChecks.Count, Converter={StaticResource CountToVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionText}" Text="КОНТРОЛЬНЫЕ РЕСУРСЫ — ПИНГ (мс)"/>
                                    <TextBlock Style="{StaticResource DimText}" FontSize="11" Text="Каждая строка — задержка до ресурса; зелёный — доступен, красный — блок."/>
                                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ConnectionChecks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="{Binding Milliseconds, StringFormat={}{0} мс}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                        <Border Grid.Column="2" CornerRadius="6" Padding="5,2" Margin="6,0,0,0" Background="{Binding SeverityKey, Converter={StaticResource SoftSeverityBrush}}" BorderBrush="{Binding SeverityKey, Converter={StaticResource SeverityBrush}}" BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding SeverityKey, Converter={StaticResource SeverityBrush}}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                                                        <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Visibility="{Binding HasUnifiedVariants, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionText}" Text="ВАРИАНТЫ СТРАТЕГИЙ — ОЦЕНКА 0..10"/>
                                    <TextBlock Style="{StaticResource DimText}" FontSize="11" Text="Зелёные 8–10 работают, 5–7 частично, 0–4 блок. ⭐ — лучший."/>
                                    <ListView Margin="0,8,0,0" MaxHeight="380" ItemsSource="{Binding UnifiedVariantScores}" SelectedItem="{Binding BestUnifiedVariant, Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Вариант × DNS" Width="220" DisplayMemberBinding="{Binding DnsAndStrategy}"/>
                                                <GridViewColumn Header="Балл" Width="60">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="7" Padding="6,2" Background="{Binding StatusKey, Converter={StaticResource SoftSeverityBrush}}" BorderBrush="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" BorderThickness="1">
                                                                <TextBlock Text="{Binding ScoreText}" FontWeight="Bold" Foreground="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" HorizontalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Успех" Width="100" DisplayMemberBinding="{Binding Summary}"/>
                                                <GridViewColumn Header="Пинг" Width="150">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ChecksDetails}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChecksDetails}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="⭐" Width="30">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="⭐" Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource DimText}" FontSize="11" Opacity="0.75" Margin="0,8,0,0" TextWrapping="Wrap" Text="Подсказка: если лидер 7/10 а остальные 0–3 — провайдер режет жёстко, пробуй ALT11/EXP с Cloudflare. Если система 60/100 — исправь красные пункты в Проверке."/>
                        </StackPanel>
                    </Border>

                    <!-- Конфликт со старым запретом -->
                    <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,11"
                            Background="{DynamicResource WarningSoftBrush}"
                            Visibility="{Binding LegacyWarningVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding LegacyWarningText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Решить конфликт"
                                    VerticalAlignment="Center" Command="{Binding ResolveLegacyCommand}"
                                    ToolTip="Выбрать: взять управление на себя, скопировать настройки старого запрета или просто выключить его" />
                        </Grid>
                    </Border>

                    <!-- Блок НОВИЧКУ удалён 23.09 — подсказка теперь в «Быстрая настройка» -->

                    

                    
                </StackPanel>

                <!-- ================= ПРАВАЯ КОЛОНКА ================= -->
                <StackPanel>

                                        <!-- Движок Zapret перенесён в Настройки → Обновления -->
<!-- Блоки «Если не работает» и «О движке» — убраны в 1.6.6 по запросу -->
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
