<UserControl x:Class="ZapretGui.Views.SearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
             AutomationProperties.Name="Поиск по приложению">

    <!-- Оверлей поиска `Ctrl+K` (этап 7, docs/IA_REDESIGN.md §10.4).
         Логика — в SearchViewModel, здесь только раскладка, фокус и клавиши. -->
    <UserControl.Resources>
        <Style x:Key="SearchRowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="MouseLeftButtonUp" Handler="Result_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SearchRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}" FontSize="14"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource DimText}" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="{Binding StarGlyph}"
                        Command="{Binding ToggleFavoriteCommand}" ToolTip="{Binding FavoriteHint}"
                        AutomationProperties.Name="{Binding FavoriteHint}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Затемнение: клик вне карточки закрывает поиск -->
        <Border Background="#AA000000" MouseLeftButtonUp="Scrim_Click" />

        <Border Style="{StaticResource Card}" Padding="0" Width="620" MaxHeight="500"
                Margin="0,70,0,40" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Строка ввода -->
                <Grid Grid.Row="0" Margin="16,12,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="15"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Margin="10,0,10,0">
                        <TextBox x:Name="QueryBox" Style="{StaticResource SearchBox}" BorderThickness="0"
                                 Background="Transparent" Padding="0"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поисковый запрос" />
                        <TextBlock Text="{Binding QueryHint}" Style="{StaticResource DimText}" FontSize="12.5"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding QueryPlaceholderVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE8BB;"
                            Command="{Binding CloseCommand}" ToolTip="Закрыть поиск (Esc)"
                            AutomationProperties.Name="Закрыть поиск" />
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" />

                <!-- Выдача -->
                <Grid Grid.Row="2" MinHeight="96" Margin="0,6">
                    <!-- Пока запрос пуст: избранное и недавние -->
                    <ScrollViewer Visibility="{Binding StartPanelVisible, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto" MaxHeight="330">
                        <StackPanel Margin="0,4">
                            <StackPanel Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource DimText}" Text="ИЗБРАННОЕ" Margin="16,6,0,4" />
                                <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Favorites}"
                                         ItemContainerStyle="{StaticResource SearchRowItem}"
                                         ItemTemplate="{StaticResource SearchRowTemplate}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="16,10,16,4">
                                    <TextBlock Style="{StaticResource DimText}" Text="НЕДАВНИЕ" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource LinkButton}" Content="Очистить" HorizontalAlignment="Right"
                                            Command="{Binding ClearRecentCommand}" ToolTip="Очистить список недавних мест" />
                                </Grid>
                                <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Recent}"
                                         ItemContainerStyle="{StaticResource SearchRowItem}"
                                         ItemTemplate="{StaticResource SearchRowTemplate}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource DimText}" FontSize="10.5" Margin="16,10,16,4"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVis}}"
                                       Text="Звёздочка в строке — добавить место в избранное." />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Найденное -->
                    <ListBox Style="{StaticResource PlainListBox}" MaxHeight="330" Margin="0,2"
                             Visibility="{Binding ResultsVisible, Converter={StaticResource BoolToVis}}"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SearchRowItem}"
                             ItemTemplate="{StaticResource SearchRowTemplate}"
                             AutomationProperties.Name="Результаты поиска" />

                    <!-- Ничего не найдено -->
                    <TextBlock Style="{StaticResource MutedText}" Margin="16,18,16,18" TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Visibility="{Binding NothingFoundVisible, Converter={StaticResource BoolToVis}}"
                               Text="{Binding NothingFoundText}" />
                </Grid>

                <!-- Подвал: подсказки -->
                <Border Grid.Row="3" Background="{DynamicResource ElevatedBrush}" Padding="16,9">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DimText}" FontSize="10.5" Text="{Binding FooterHint}" />
                        <TextBlock Style="{StaticResource DimText}" FontSize="10.5" TextWrapping="Wrap"
                                   Margin="0,3,0,0" Text="{Binding IndexHint}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
