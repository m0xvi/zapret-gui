<Window x:Class="ZapretGui.Views.LegacyZapretDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обнаружен старый запрет" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MinWidth="560" MaxWidth="640"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Style="{StaticResource TitleText}" Text="В фоне уже работает запрет" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Запрет, запущенный не через это приложение (служба или процесс из другой папки). Два обхода одновременно конфликтуют через драйвер WinDivert — будет ломаться интернет. Выберите, что сделать:" />

        <Border Style="{StaticResource InnerCard}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="ServiceInfoText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                <TextBlock x:Name="ProcessInfoText" Style="{StaticResource DimText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="StrategyInfoText" Style="{StaticResource DimText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="FolderInfoText" Style="{StaticResource DimText}" Margin="0,4,0,0"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                Content="Остановить старый и запустить через GUI" Click="TakeOver_Click"
                ToolTip="Чужая служба zapret будет остановлена и удалена (её папка не изменится), затем обход запустится из этого приложения" />
        <TextBlock Style="{StaticResource DimText}" Margin="2,4,0,0"
                   Text="Служба старого запрета удалится (иначе она вернётся после перезагрузки), папка старого движка не тронется." />

        <Button Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                Content="Скопировать его настройки и запустить через GUI" Click="Import_Click"
                ToolTip="Списки *-user.txt, резерв ipset, режимы фильтров и имя стратегии будут перенесены в движок приложения" />
        <TextBlock Style="{StaticResource DimText}" Margin="2,4,0,0"
                   Text="Ваши списки и режимы фильтров переедут в движок приложения, старый будет выключен." />

        <Button Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                Content="Только выключить старый" Click="StopOnly_Click"
                ToolTip="Остановить чужую службу и процессы. Новый обход запущен не будет" />

        <Grid Margin="0,16,0,0">
            <CheckBox x:Name="DontAskCheck" Style="{StaticResource CheckBoxApp}" Content="Больше не спрашивать"
                      VerticalAlignment="Center"
                      ToolTip="Не показывать это окно при следующих запусках (конфликт придётся решать вручную)" />
            <Button Style="{StaticResource GhostButton}" Content="Напомнить позже" HorizontalAlignment="Right"
                    Click="Later_Click" />
        </Grid>
    </StackPanel>
</Window>
