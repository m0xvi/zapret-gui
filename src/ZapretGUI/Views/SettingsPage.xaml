<UserControl x:Class="ZapretGui.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZapretGui.Views.Controls"
             xmlns:views="clr-namespace:ZapretGui.Views"
             Background="Transparent">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка раздела -->
        <Grid Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Настройки" />
                    <TextBlock Style="{StaticResource MutedText}" Text="Изменения сохраняются автоматически." TextWrapping="Wrap" />
                </StackPanel>
            <WrapPanel Grid.Column="1" Style="{StaticResource PageActions}">
                    <Button Style="{StaticResource PageActionGhost}" Content="↺ Сбросить"
                            Command="{Binding ResetSettingsCommand}"
                            ToolTip="Вернуть все настройки к значениям по умолчанию" />
                </WrapPanel>
            </Grid>

        <!-- Статус сохранения -->
        <Border Grid.Row="1" MaxWidth="1180" Margin="0,12,0,0" CornerRadius="8" Padding="12,9"
                    Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="8" Height="8" CornerRadius="8" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="{Binding Status}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>

        <!-- Переключатель разделов — главный навигатор настроек -->
        <StackPanel Grid.Row="2" Style="{StaticResource PageTabs}">
            <controls:SegmentedControl ItemsSource="{Binding SettingsTabs}"
                                       SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" />
            <TextBlock Style="{StaticResource PageTabHint}" Text="{Binding SelectedTabHint}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer x:Name="RootScrollViewer" Grid.Row="3" Style="{StaticResource PageScroll}" Margin="0,12,0,0" ScrollChanged="OnScrollChanged">
        <StackPanel Style="{StaticResource PageContent}">

            <!-- ===================== ВКЛАДКА 0: ОБЩИЕ ===================== -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsGeneralTabSelected, Converter={StaticResource BoolToVis}}">

                <!-- Движок -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE8B5;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource SectionText}" Text="ДВИЖОК ZAPRET" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Папка со сборкой zapret (внутри должны быть bin, lists и .bat файлы стратегий)." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding EnginePath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Папка со сборкой zapret: внутри должны быть bin, lists и .bat файлы" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Обзор…" Margin="8,0,0,0"
                                    Command="{Binding BrowseEnginePathCommand}" ToolTip="Выбрать папку с движком" />
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Найти автоматически" Command="{Binding DetectEngineCommand}" ToolTip="Найти уже распакованную сборку рядом с приложением или в загрузках" />
                            <Button Style="{StaticResource GhostButton}" Content="Проверить" Command="{Binding ValidateEngineCommand}" ToolTip="Проверить, что в папке есть winws.exe и WinDivert64.sys" />
                            <Button Style="{StaticResource GhostButton}" Content="Открыть папку" Command="{Binding OpenEngineFolderCommand}" ToolTip="Открыть папку движка в проводнике" />
                        </WrapPanel>
                        <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Background="{DynamicResource ElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="8" Height="8" CornerRadius="8" VerticalAlignment="Center"
                                        Background="{Binding EngineReady, Converter={StaticResource SeverityBrush}}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="{Binding EngineInfoText}" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Система и автозапуск -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource InfoSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource SectionText}" Text="ЗАПУСК И АВТОЗАПУСК" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Как приложение ведёт себя при старте Windows и при закрытии окна." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Запускать при входе в систему (от администратора)" Margin="0,14,0,0"
                                  IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                                  ToolTip="Автозапуск через планировщик задач с правами администратора" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Сворачивать в трей при закрытии окна"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                  ToolTip="При закрытии окно остаётся в трее, обход продолжает работать" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Запускать свёрнутым в трей" Margin="0,10,0,0"
                                  IsChecked="{Binding StartMinimized, Mode=TwoWay}" ToolTip="Запускаться сразу свёрнутым в трей" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="settings.json" Command="{Binding OpenSettingsFileCommand}" ToolTip="Открыть файл настроек в блокноте" />
                            <Button Style="{StaticResource GhostButton}" Content="Папка журналов" Command="{Binding OpenLogsFolderCommand}" ToolTip="Открыть папку с файлами журнала" />
                            <Button Style="{StaticResource GhostButton}" Content="Резервные копии" Command="{Binding OpenBackupFolderCommand}" ToolTip="Открыть папку с резервными копиями hosts" />
                            <Button Style="{StaticResource GhostButton}" Content="Файл hosts" Command="{Binding OpenHostsCommand}" ToolTip="Открыть системный файл hosts в блокноте" />
                            <Button Style="{StaticResource GhostButton}" Content="Репозиторий" Command="{Binding OpenRepoCommand}" ToolTip="Открыть репозиторий Flowseal в браузере" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                

                
            </StackPanel>

            <!-- ===================== ВКЛАДКА 1: АВТОМАТИКА ===================== -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsBypassTabSelected, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}">
                                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource SectionText}" Text="СТОРОЖЕВОЙ ТАЙМЕР (WATCHDOG)" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Следит, чтобы winws.exe и служба zapret не падали молча." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Включить сторож" Margin="0,14,0,0"
                                  IsChecked="{Binding WatchdogEnabled, Mode=TwoWay}" ToolTip="Фоновый контроль процесса и службы" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Автоматически перезапускать при падении" Margin="0,10,0,0"
                                  IsChecked="{Binding WatchdogAutoRestart, Mode=TwoWay}" IsEnabled="{Binding WatchdogEnabled}" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Уведомлять в трее о восстановлении" Margin="0,10,0,0"
                                  IsChecked="{Binding WatchdogNotifyUser, Mode=TwoWay}" IsEnabled="{Binding WatchdogEnabled}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DimText}" Text="Интервал проверки" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding WatchdogEnabled}">
                                <Slider Minimum="5" Maximum="60" Width="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding WatchdogIntervalSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{DynamicResource ElevatedBrush}">
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding WatchdogIntervalSeconds, StringFormat={}{0} сек}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE8F5;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionText}" Text="БЕСШОВНОЕ ПЕРЕКЛЮЧЕНИЕ СТРАТЕГИЙ" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Без окон и подтверждений: сам проверяет YouTube/Discord и тихо переключает на рабочую стратегию, сохраняя режим служба/процесс." TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Content="" IsChecked="{Binding SeamlessFailoverEnabled, Mode=TwoWay}" ToolTip="Включить бесшовное автопереключение" VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Background="{DynamicResource ElevatedBrush}" Visibility="{Binding SeamlessFailoverEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource DimText}" Text="Проверка каждые" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Minimum="2" Maximum="30" Width="110" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SeamlessCheckMinutes, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource ElevatedBrush}">
                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding SeamlessCheckMinutes, StringFormat={}{0} мин}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource DimText}" Text="Cooldown между переключениями" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Minimum="5" Maximum="60" Width="110" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SeamlessCooldownMinutes, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource ElevatedBrush}">
                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding SeamlessCooldownMinutes, StringFormat={}{0} мин}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Background="{DynamicResource CardBrush}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DimText}" Text="СТАТУС" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding SeamlessStatus}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{Binding SeamlessStatusKey, Converter={StaticResource SeverityBrush}}" />
                                        <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0" Text="{Binding SeamlessLastSwitch, StringFormat='Последнее переключение: {0}'}" />
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource GhostButton}" Content="Проверить сейчас" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding TestSeamlessNowCommand}" ToolTip="Внепланово проверить ресурсы и при необходимости переключить" />
                                <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" Text="Логика: 2 подтверждённых сбоя подряд → сравнение «прямо vs обход» → если стратегия мешает — тест 8 кандидатов на упавшем ресурсе → бесшовный SwitchToStrategyAsync/InstallService. Уведомление только в трей, без MessageBox." />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap" Text="Работает в фоне даже когда окно в трее. Учитывает SafeMode и не трогает обход если он выключен." Visibility="{Binding SeamlessFailoverEnabled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}">
                                <TextBlock Text="&#xE90F;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource SectionText}" Text="АВТОПОДБОР ПРИ ПЕРВОМ ЗАПУСКЕ" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Выполняется один раз после установки движка. Повторить можно вручную на странице «Стратегии»." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Проверять все стратегии при первом запуске" Margin="0,14,0,0"
                                  IsChecked="{Binding AutoTestStrategiesOnFirstLaunch, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Запускать диагностику перед автоподбором" Margin="0,10,0,0"
                                  IsChecked="{Binding AutoDiagnoseOnFirstLaunch, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Расписание обхода — таймер/дни -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource InfoSoftBrush}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE823;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionText}" Text="РАСПИСАНИЕ ОБХОДА (ТАЙМЕР/ДНИ)" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Автоматический старт и стоп в заданные часы — например, ночью отключать, утром включать." TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Content="" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" ToolTip="Включить расписание" VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Visibility="{Binding ScheduleEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource DimText}" Text="СТАРТ (HH:MM)" />
                                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Text="{Binding ScheduleStartTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например 09:00" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource DimText}" Text="СТОП (HH:MM)" />
                                        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0" Text="{Binding ScheduleStopTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например 23:00" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource DimText}" Text="ДНИ НЕДЕЛИ" Margin="0,12,0,4" />
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox Style="{StaticResource CheckBoxApp}" Content="Пн" IsChecked="{Binding ScheduleDayMonday, Mode=TwoWay}" Margin="0,0,10,0" />
                                    <CheckBox Style="{StaticResource CheckBoxApp}" Content="Вт" IsChecked="{Binding ScheduleDayTuesday, Mode=TwoWay}" Margin="0,0,10,0" />
                                    <CheckBox Style="{StaticResource CheckBoxApp}" Content="Ср" IsChecked="{Binding ScheduleDayWednesday, Mode=TwoWay}" Margin="0,0,10,0" />
                                    <CheckBox Style="{StaticResource CheckBoxApp}" Content="Чт" IsChecked="{Binding ScheduleDayThursday, Mode=TwoWay}" Margin="0,0,10,0" />
                                    <CheckBox Style="{StaticResource CheckBoxApp}" Content="Пт" IsChecked="{Binding ScheduleDayFriday, Mode=TwoWay}" Margin="0,0,10,0" />
                                    <CheckBox Style="{StaticResource CheckBoxApp}" Content="Сб" IsChecked="{Binding ScheduleDaySaturday, Mode=TwoWay}" Margin="0,0,10,0" />
                                    <CheckBox Style="{StaticResource CheckBoxApp}" Content="Вс" IsChecked="{Binding ScheduleDaySunday, Mode=TwoWay}" />
                                </WrapPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Запускать как службу (автозапуск)" Margin="0,12,0,0" IsChecked="{Binding ScheduleUseService, Mode=TwoWay}" ToolTip="Если включено — старт через службу Windows, иначе как процесс" />
                                <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0" Text="{Binding ScheduleSummary, StringFormat='Текущее: {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,8,0,0" Text="Подсказка: оставляйте запас 1–2 минуты — проверка идёт каждые 30с, срабатывание в пределах минуты от заданного времени." TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== ВКЛАДКА 2: ИНТЕРФЕЙС ===================== -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsAppearanceTabSelected, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE790;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource SectionText}" Text="ТЕМА И МАСШТАБ" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Тёмная, светлая или как в системе — меняется на лету. Масштаб 80–140%." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyText}" Text="Тема оформления" VerticalAlignment="Center" />
                            <controls:SegmentedControl Grid.Column="1" HorizontalAlignment="Right" MinWidth="280"
                                                       ItemsSource="{Binding ThemeOptions}"
                                                       SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyText}" Text="Масштаб интерфейса" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="80" Minimum="80" Maximum="140"
                                    TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding ZoomPercent, Mode=TwoWay}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource ElevatedBrush}">
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding ZoomPercent, StringFormat={}{0}%}" />
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Style="{StaticResource DimText}" FontSize="11" Opacity="0.8" Text="Настройки трея — в разделе «Общие › Запуск и автозапуск»" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE765;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource SectionText}" Text="ГОРЯЧИЕ КЛАВИШИ" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Работают даже когда окно не в фокусе — удобно в играх." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Включить глобальные горячие клавиши" Margin="0,14,0,0"
                                  IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}" />
                        <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" IsEnabled="{Binding GlobalHotkeysEnabled}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyText}" Text="Вкл/выкл обхода" />
                                        <TextBlock Style="{StaticResource DimText}" Text="Быстро без мыши" FontSize="11" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding HotkeyToggleBypass, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: Ctrl+Shift+Z" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyText}" Text="Игровой режим" />
                                        <TextBlock Style="{StaticResource DimText}" Text="Переключение пропуска UDP" FontSize="11" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding HotkeyToggleGameMode, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: Ctrl+Shift+G" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyText}" Text="HUD виджет" />
                                        <TextBlock Style="{StaticResource DimText}" Text="Показать/скрыть оверлей" FontSize="11" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding HotkeyToggleMiniOverlay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: Ctrl+Shift+O" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE7FC;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource SectionText}" Text="МИНИ-ВИДЖЕТ (HUD)" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Компактный оверлей поверх всех окон — для игр и быстрого контроля." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Поверх всех окон (Topmost)" Margin="0,14,0,0"
                                  IsChecked="{Binding MiniOverlayTopmost, Mode=TwoWay}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DimText}" Text="Прозрачность" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider Minimum="50" Maximum="100" Width="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding MiniOverlayOpacity, Mode=TwoWay}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{DynamicResource ElevatedBrush}">
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding MiniOverlayOpacity, StringFormat={}{0}%}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource SecondaryButton}" Content="Открыть HUD виджет" Margin="0,14,0,0" HorizontalAlignment="Left"
                                Command="{Binding OpenOverlayCommand}" />
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ===================== ВКЛАДКА 3: ОБНОВЛЕНИЯ ===================== -->
            <StackPanel Margin="0,4,0,0" Visibility="{Binding IsUpdatesTabSelected, Converter={StaticResource BoolToVis}}">
                <views:UpdatesPage DataContext="{Binding Updates}" ShowHeader="False" />
            </StackPanel>

            <!-- ===================== ВКЛАДКА 4: СИСТЕМА (поведение обхода, файлы, о программе) ===================== -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsAdvancedTabSelected, Converter={StaticResource BoolToVis}}">

                <!-- Поведение обхода — перенесено из вкладки Обход -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE81B;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource SectionText}" Text="ПОВЕДЕНИЕ ОБХОДА" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource DimText}" Text="Что делает обход при запуске и выходе — без скрытых действий." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Запускать обход вместе с приложением" Margin="0,14,0,0"
                                  IsChecked="{Binding AutoStartBypass, Mode=TwoWay}"
                                  ToolTip="Запускать обход с выбранной стратегией сразу при старте" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DimText}" Text="Отложенный старт при включении (секунды)" />
                                <TextBlock Style="{StaticResource DimText}" Text="Полезно для Wi-Fi/DHCP — даёт сети время подняться" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Minimum="0" Maximum="30" Width="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding StartupDelaySeconds, Mode=TwoWay}" ToolTip="0-30 сек" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{DynamicResource ElevatedBrush}">
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding StartupDelaySeconds, StringFormat={}{0} сек}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="🔒 Безопасный режим" FontWeight="SemiBold"
                                  IsChecked="{Binding SafeMode, Mode=TwoWay}"
                                  ToolTip="Не запускать обход автоматически и не менять службу/сеть без подтверждения. Диагностика остаётся доступной." />
                        <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0" Text="В безопасном режиме служба, hosts, proxy и WinDivert меняются только вручную после вашего подтверждения." TextWrapping="Wrap" />

                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Останавливать обход при выходе"
                                  IsChecked="{Binding StopBypassOnExit, Mode=TwoWay}" ToolTip="Останавливать обход при выходе из приложения" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Спрашивать подтверждение при остановке" Margin="0,10,0,0"
                                  IsChecked="{Binding ConfirmOnStop, Mode=TwoWay}" ToolTip="Показывать подтверждение при остановке круглой кнопкой" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Показывать консоль winws.exe" Margin="0,10,0,0"
                                  IsChecked="{Binding ShowWinwsConsole, Mode=TwoWay}" ToolTip="Чёрное окно консоли winws.exe" />
                        <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0" Text="По умолчанию консоль скрыта — обход работает в фоне, вывод пишется в «Журнал»." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Мастер первого запуска — перенесено из Общие -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9CE;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyText}" Text="Мастер первого запуска" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource DimText}" Text="Пошаговая проверка прав, движка, диагностики и выбор первой стратегии. Можно запустить заново в любой момент." TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Запустить мастер" VerticalAlignment="Center"
                                    Command="{Binding RerunFirstLaunchWizardCommand}" ToolTip="Открыть пошаговый мастер настройки" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- О программе — перенесено из отдельной вкладки -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionText}" Text="О ПРОГРАММЕ" />
                                <TextBlock Style="{StaticResource DimText}" Text="Версия, лицензия и ссылки" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Zapret GUI — графический интерфейс для zapret-discord-youtube" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0" Text="Портативный EXE, автообновление движка и GUI, профили и автопереключение. Лицензия MIT." TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Открыть о программе" Padding="14,7" Command="{Binding OpenAboutCommand}" ToolTip="Перейти на страницу О программе" />
                                <Button Style="{StaticResource GhostButton}" Content="Репозиторий GUI" Margin="8,0,0,0" Padding="12,7" Command="{Binding OpenRepoCommand}" ToolTip="Открыть m0xvi/zapret-gui" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>