<UserControl x:Class="ZapretGui.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZapretGui.Views.Controls"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="24,20,20,26">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Настройки" />
                    <TextBlock Style="{StaticResource MutedText}" Text="Изменения применяются и сохраняются автоматически" />
                </StackPanel>
                <WrapPanel Grid.Column="1" MaxWidth="220" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource GhostButton}" Content="Сбросить настройки"
                            Command="{Binding ResetSettingsCommand}"
                            ToolTip="Вернуть все настройки приложения к значениям по умолчанию" />
                </WrapPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0">

                <!-- Основные блоки настроек идут последовательно, чтобы страница
                     оставалась доступной на узком окне и при системном DPI. -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ДВИЖОК ZAPRET" />
                            <TextBlock Style="{StaticResource DimText}"
                                       Text="Папка со сборкой zapret (внутри должны быть bin, lists и .bat файлы стратегий)." />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding EnginePath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Папка со сборкой zapret: внутри должны быть bin, lists и .bat файлы" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Обзор…" Margin="8,0,0,0"
                                        Command="{Binding BrowseEnginePathCommand}"
                                        ToolTip="Выбрать папку с движком" />
                            </Grid>
                            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Найти автоматически" Command="{Binding DetectEngineCommand}"
                                        ToolTip="Найти уже распакованную сборку рядом с приложением или в загрузках" />
                                <Button Style="{StaticResource GhostButton}" Content="Проверить" Command="{Binding ValidateEngineCommand}"
                                        ToolTip="Проверить, что в папке есть winws.exe и WinDivert64.sys" />
                                <Button Style="{StaticResource GhostButton}" Content="Открыть папку" Command="{Binding OpenEngineFolderCommand}"
                                        ToolTip="Открыть папку движка в проводнике" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding EngineInfoText}" Margin="2,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="КОНТЕКСТ ПРОВАЙДЕРА" />
                            <TextBlock Style="{StaticResource DimText}" Text="Укажите провайдера вручную, если хотите использовать его как признак будущего автоконструктора. Нажмите «Сохранить», чтобы зафиксировать время проверки. Endpoint из DPI-suite не считается вашим провайдером." TextWrapping="Wrap" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="Имя провайдера" />
                                    <TextBox Style="{StaticResource InputBox}" Margin="0,5,0,0"
                                             Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Название интернет-провайдера пользователя; можно оставить пустым" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="ASN провайдера" />
                                    <TextBox Style="{StaticResource InputBox}" Margin="0,5,0,0"
                                             Text="{Binding ProviderAsn, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Необязательный ASN провайдера, например AS12345" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="Источник данных" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProviderSourceText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource DimText}" Text="Уверенность в данных" />
                                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,5,0,0"
                                              ItemsSource="{Binding ProviderConfidenceOptions}"
                                              SelectedIndex="{Binding ProviderConfidenceIndex, Mode=TwoWay}"
                                              ToolTip="Насколько вы уверены в указанном провайдере" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding ProviderCheckedAtText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Сохранить"
                                        Command="{Binding SaveProviderContextCommand}"
                                        ToolTip="Зафиксировать провайдера, источник, уверенность и время проверки" />
                                <Button Style="{StaticResource GhostButton}" Content="Определить через внешний сервис" Margin="8,0,0,0"
                                        Command="{Binding LookupProviderCommand}"
                                        ToolTip="После отдельного подтверждения запросить ASN и организацию через ipapi.co" />
                                <Button Style="{StaticResource GhostButton}" Content="Очистить данные" Margin="8,0,0,0"
                                        Command="{Binding ClearProviderContextCommand}"
                                        ToolTip="Очистить имя, ASN, источник, уверенность и время проверки" />
                            </WrapPanel>
                            <WrapPanel Margin="0,10,0,0" Visibility="{Binding IsProviderLookupBusy, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource BusySpinner}">
                                    <TextBlock Text="…" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Style="{StaticResource MutedText}" Text="Запрашиваю данные провайдера…" Margin="8,2,0,0" />
                            </WrapPanel>
                            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding ProviderContextText}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Экспорт телеметрии и отчёта провайдера для настройки автоподбора -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ЭКСПОРТ ТЕЛЕМЕТРИИ И ОТЧЁТА ПРОВАЙДЕРА" />
                            <TextBlock Style="{StaticResource DimText}"
                                       Text="Формирует исчерпывающий отчёт: матрицу тестов всех 26 стратегий, результаты автоподбора, параметры ТСПУ, списки доменов и журналы. Скопируйте текст отчёта или сохраните файл, чтобы передать разработчику для точной калибровки и адаптации обхода под вашего провайдера."
                                       TextWrapping="Wrap" Margin="0,4,0,0" />

                            <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding TelemetrySummaryText}" />
                                    <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                                               Text="Отчёт содержит детальный срез: какие методы (fooling ts, repeats, split-pos, badsum, disorder2) работают, а какие блокируются на вашем DPI." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CopyTelemetryMarkdownCommand}"
                                        Padding="16,8"
                                        ToolTip="Скопировать готовый Markdown отчёт со всеми таблицами и параметрами в буфер обмена для отправки">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Скопировать отчёт (Markdown)" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                        Command="{Binding ExportTelemetryJsonCommand}"
                                        Padding="14,8"
                                        ToolTip="Сохранить структурированный JSON со всеми данными телеметрии">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Экспорт в JSON (.json)" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                        Command="{Binding ExportTelemetryZipCommand}"
                                        Padding="14,8"
                                        ToolTip="Создать полный архив (.zip) с отчётом, JSON дампом и логами">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED35;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Диагностический пакет (.zip)" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ИНТЕРФЕЙС" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyText}" Text="Тема оформления" VerticalAlignment="Center" />
                                <controls:SegmentedControl Grid.Column="1" HorizontalAlignment="Right" MinWidth="280"
                                                           ItemsSource="{Binding ThemeOptions}"
                                                           SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                                                           ToolTip="Тёмная, светлая тема или как в системе (переключается на лету)" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyText}" Text="Масштаб интерфейса" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="80" Minimum="80" Maximum="140"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding ZoomPercent, Mode=TwoWay}" ToolTip="Масштаб от 80 до 140 процентов" />
                                <TextBlock Grid.Column="2" Style="{StaticResource DimText}" Text="{Binding ZoomPercent, StringFormat={}{0}%}"
                                           Width="45" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Сворачивать в трей при закрытии окна"
                                      Margin="0,14,0,0" IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                      ToolTip="При закрытии окна приложение остаётся в трее, обход продолжает работать" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Запускать свёрнутым в трей"
                                      Margin="0,10,0,0" IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                      ToolTip="Запускаться сразу свёрнутым в трей" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ПОВЕДЕНИЕ ОБХОДА" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Запускать обход вместе с приложением"
                                      IsChecked="{Binding AutoStartBypass, Mode=TwoWay}"
                                      ToolTip="Запускать обход с выбранной стратегией сразу при старте приложения" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="Отложенный автозапуск обхода (секунды для ожидания инициализации сети)" />
                            <Slider Minimum="0" Maximum="30" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding StartupDelaySeconds, Mode=TwoWay}" ToolTip="От 0 до 30 секунд (рекомендуется 5-10 сек для Wi-Fi/DHCP)" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding StartupDelaySeconds, StringFormat={}{0} сек}" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Безопасный режим"
                                      Margin="0,10,0,0" IsChecked="{Binding SafeMode, Mode=TwoWay}"
                                      ToolTip="Не запускать обход автоматически и не выполнять автоматическую установку службы или сетевые изменения. Диагностика остаётся доступной." />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,5,0,0"
                                       Text="В безопасном режиме приложение наблюдает и диагностирует систему; служба, hosts, proxy, TCP timestamps, reset network и WinDivert изменяются только вручную после объяснения и подтверждения." TextWrapping="Wrap" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Останавливать обход при выходе"
                                      Margin="0,10,0,0" IsChecked="{Binding StopBypassOnExit, Mode=TwoWay}"
                                      ToolTip="Останавливать обход при выходе из приложения" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Спрашивать подтверждение при остановке"
                                      Margin="0,10,0,0" IsChecked="{Binding ConfirmOnStop, Mode=TwoWay}"
                                      ToolTip="Показывать подтверждение при остановке обхода круглой кнопкой" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Показывать консольное окно winws.exe"
                                      Margin="0,10,0,0" IsChecked="{Binding ShowWinwsConsole, Mode=TwoWay}"
                                      ToolTip="Показывать чёрное окно консоли winws.exe (в скрытом режиме его вывод пишется в журнал на странице «Журнал»)" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="По умолчанию консоль скрыта — обход работает в фоне, как и раньше через .bat с параметром /min." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="СТОРОЖЕВОЙ ТАЙМЕР И САМОКОНТРОЛЬ (WATCHDOG)" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Включить сторожевой таймер (Watchdog)"
                                      IsChecked="{Binding WatchdogEnabled, Mode=TwoWay}"
                                      ToolTip="Фоновый контроль процесса winws.exe и службы zapret" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Автоматически перезапускать процесс при падении"
                                      Margin="0,10,0,0" IsChecked="{Binding WatchdogAutoRestart, Mode=TwoWay}"
                                      IsEnabled="{Binding WatchdogEnabled}"
                                      ToolTip="Мягко восстанавливать обход при внезапном закрытии winws.exe или службы" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Уведомлять о восстановлении через трей"
                                      Margin="0,10,0,0" IsChecked="{Binding WatchdogNotifyUser, Mode=TwoWay}"
                                      IsEnabled="{Binding WatchdogEnabled}"
                                      ToolTip="Показывать всплывающее уведомление в системном трее при перезапуске" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="Интервал проверки сторожа (секунды)" />
                            <Slider Minimum="5" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding WatchdogIntervalSeconds, Mode=TwoWay}"
                                    IsEnabled="{Binding WatchdogEnabled}" ToolTip="От 5 до 60 секунд" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding WatchdogIntervalSeconds, StringFormat={}{0} сек}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="МОНИТОРИНГ ЗАДЕРЖКИ СЕТИ (RTT PING)" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Отображать живой RTT пинг в шапке окна"
                                      IsChecked="{Binding RealTimePingEnabled, Mode=TwoWay}"
                                      ToolTip="Периодический пинг до YouTube, Discord и GitHub в верхней панели окна" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="Интервал живого пинга (секунды)" />
                            <Slider Minimum="5" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding RealTimePingIntervalSeconds, Mode=TwoWay}"
                                    IsEnabled="{Binding RealTimePingEnabled}" ToolTip="От 5 до 60 секунд" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding RealTimePingIntervalSeconds, StringFormat={}{0} сек}" />
                        </StackPanel>
                    </Border>

                    <!-- Игровой опыт и сетевые твики -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ИГРОВОЙ ОПЫТ И ОНЛАЙН-ИГРЫ (UX &amp; GAMING)" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Включить автоматический детектор запущенных игр"
                                      IsChecked="{Binding GameDetectionEnabled, Mode=TwoWay}"
                                      ToolTip="Отслеживать процессы популярных игр (CS2, Dota 2, Valorant, Apex, War Thunder, Genshin и др.)" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Автоматически активировать игровой режим при запуске игры"
                                      Margin="0,10,0,0" IsChecked="{Binding AutoGameModeOnLaunch, Mode=TwoWay}"
                                      IsEnabled="{Binding GameDetectionEnabled}"
                                      ToolTip="При запуске игры автоматически переключать zapret на режим пропуска UDP для защиты от лагов и скачков пинга" />
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Style="{StaticResource BodyText}" Text="Оптимизация сетевых задержек Windows (TCP/IP Gaming Tweaks)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding GamingOptimizationStatusText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Применить оптимизацию для игр"
                                        Command="{Binding ApplyGamingTweaksCommand}"
                                        ToolTip="Отключить алгоритм Nagle (TCPNoDelay = 1), задержку ACK (TcpAckFrequency = 1) и троттлинг сети" />
                                <Button Style="{StaticResource GhostButton}" Content="Сбросить по умолчанию" Margin="8,0,0,0"
                                        Command="{Binding RevertGamingTweaksCommand}"
                                        ToolTip="Восстановить стандартные параметры сетевого стека Windows" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Глобальные горячие клавиши -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ГЛОБАЛЬНЫЕ ГОРЯЧИЕ КЛАВИШИ (HOTKEYS)" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Включить глобальные горячие клавиши"
                                      IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}"
                                      ToolTip="Позволяет управлять обходом из любой игры или программы" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyText}" Text="Включение / выключение Zapret" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding HotkeyToggleBypass, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding GlobalHotkeysEnabled}" ToolTip="Например: Ctrl+Shift+Z" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyText}" Text="Переключение игрового режима" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding HotkeyToggleGameMode, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding GlobalHotkeysEnabled}" ToolTip="Например: Ctrl+Shift+G" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyText}" Text="Показать / скрыть HUD виджет" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding HotkeyToggleMiniOverlay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding GlobalHotkeysEnabled}" ToolTip="Например: Ctrl+Shift+O" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Мини-виджет HUD -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="КОМПАКТНЫЙ МИНИ-ВИДЖЕТ (HUD OVERLAY)" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Виджет поверх всех окон (Topmost)"
                                      IsChecked="{Binding MiniOverlayTopmost, Mode=TwoWay}"
                                      ToolTip="Отображать плавающий HUD поверх игр и других окон" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="Прозрачность виджета (%)" />
                            <Slider Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding MiniOverlayOpacity, Mode=TwoWay}" ToolTip="От 50% до 100%" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding MiniOverlayOpacity, StringFormat={}{0}%}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Открыть / показать HUD виджет"
                                    Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Command="{Binding OpenOverlayCommand}"
                                    ToolTip="Показать компактный полупрозрачный оверлей с быстрым управлением" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="АВТОПОДБОР СТРАТЕГИИ" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Проверять все стратегии при первом запуске"
                                      IsChecked="{Binding AutoTestStrategiesOnFirstLaunch, Mode=TwoWay}"
                                      ToolTip="Один раз последовательно запустить стратегии и проверить YouTube, Discord и GitHub" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Запускать диагностику перед автоподбором"
                                      Margin="0,10,0,0" IsChecked="{Binding AutoDiagnoseOnFirstLaunch, Mode=TwoWay}"
                                      ToolTip="Перед проверкой стратегий проверить BFE, TCP timestamps, WinDivert и сетевые конфликты" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="Проверка выполняется только один раз после установки движка. Повторить её можно вручную на странице «Стратегии»." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="МАСТЕР НАСТРОЙКИ" />
                            <TextBlock Style="{StaticResource DimText}"
                                       Text="Пошаговый мастер проверки прав, установки движка, диагностики и выбора первой стратегии." TextWrapping="Wrap" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Запустить мастер первого запуска заново"
                                    Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Command="{Binding RerunFirstLaunchWizardCommand}"
                                    ToolTip="Открыть пошаговый мастер настройки" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ФОНОВЫЙ МОНИТОРИНГ" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Проверять ресурсы в фоне"
                                      IsChecked="{Binding ResourceMonitoringEnabled, Mode=TwoWay}"
                                      ToolTip="Проверять избранные сайты даже когда окно свёрнуто в трей" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Показывать уведомления в трее"
                                      Margin="0,10,0,0" IsChecked="{Binding MonitorNotificationsEnabled, Mode=TwoWay}"
                                      ToolTip="Показывать результат фоновой диагностики через существующий значок в трее" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="Интервал проверки (минуты)" />
                            <Slider Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding MonitoringIntervalMinutes, Mode=TwoWay}" ToolTip="От 5 до 120 минут" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding MonitoringIntervalMinutes, StringFormat={}{0} мин}" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="Приложение уже поддерживает запуск при входе в Windows и работу в трее. Мониторинг не добавляет домены автоматически без подтверждения пользователя." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Правая колонка -->
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="СИСТЕМА И ФАЙЛЫ" />
                            <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Запускать при входе в систему (от администратора)"
                                      IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                                      ToolTip="Автозапуск приложения при входе в систему через планировщик задач (с правами администратора)" />
                            <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0"
                                       Text="{Binding Status}" />
                            <Border Style="{StaticResource Divider}" />
                            <Button Style="{StaticResource GhostButton}" Content="settings.json" HorizontalAlignment="Left"
                                    Command="{Binding OpenSettingsFileCommand}"
                                    ToolTip="Открыть файл настроек в блокноте" />
                            <Button Style="{StaticResource GhostButton}" Content="Папка журналов" HorizontalAlignment="Left"
                                    Command="{Binding OpenLogsFolderCommand}"
                                    ToolTip="Открыть папку с файлами журнала" />
                            <Button Style="{StaticResource GhostButton}" Content="Папка резервных копий" HorizontalAlignment="Left"
                                    Command="{Binding OpenBackupFolderCommand}"
                                    ToolTip="Открыть папку с резервными копиями hosts" />
                            <Button Style="{StaticResource GhostButton}" Content="Файл hosts (блокнот)" HorizontalAlignment="Left"
                                    Command="{Binding OpenHostsCommand}"
                                    ToolTip="Открыть системный файл hosts в блокноте" />
                            <Button Style="{StaticResource GhostButton}" Content="Репозиторий движка" HorizontalAlignment="Left"
                                    Command="{Binding OpenRepoCommand}"
                                    ToolTip="Открыть репозиторий Flowseal/zapret-discord-youtube в браузере" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="О ПУТЯХ" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding SettingsFilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SettingsFilePath}" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding LogsPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogsPath}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding BackupPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BackupPath}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding LastBackupText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
