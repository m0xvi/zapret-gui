<Window x:Class="ZapretGui.Views.TaskbarMetricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Metrics" Height="28" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="#CC1E1E1E" CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="8,4" Margin="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="◉" FontSize="8" Foreground="#FF00E676" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Grid.Column="1" Text="{Binding ToolbarMetricsText}" FontSize="11" FontFamily="Consolas" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolbarMetricsTooltip}" />
            <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="✕" FontSize="10" Foreground="White" Opacity="0.6" Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center" Click="Close_Click" ToolTip="Скрыть метрики (включить снова в Настройках → Метрики в тулбаре)" />
        </Grid>
    </Border>
</Window>
