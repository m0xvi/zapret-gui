<Window x:Class="ZapretGui.Views.TaskbarMetricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Metrics" Width="170" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="#CC1E1E1E" CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="0" Margin="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <!-- Шапка -->
            <Grid Margin="8,6,6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#FF00E676" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="МЕТРИКИ" FontSize="10" FontWeight="SemiBold" Foreground="White" Opacity="0.85" VerticalAlignment="Center" LetterSpacing="0.5" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SmallIconButton}" Content="&#xE8BB;" FontSize="10" Foreground="White" Opacity="0.7" Width="18" Height="18" VerticalAlignment="Center" Click="Close_Click" ToolTip="Скрыть метрики (включить снова в Настройки → Сеть → Метрики)" />
            </Grid>
            <Separator Margin="8,0" Background="#33FFFFFF" Height="1" />
            <!-- Вертикальный список: имя слева, пинг справа, без слова Доступен -->
            <ItemsControl ItemsSource="{Binding ToolbarMetricsRows}" Margin="8,4,8,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0"
                                        Background="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" />
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="95" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Latency}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
