<Window x:Class="ZapretGui.Views.TaskbarMetricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Metrics" Width="170" SizeToContent="Height"
        MinWidth="140" MinHeight="40" MaxWidth="400" MaxHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border x:Name="RootBorder" Background="#CC1E1E1E" CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="0" Margin="2"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid>
            <!-- Список хостов без заголовка МЕТРИКИ -->
            <ItemsControl x:Name="MetricsList" ItemsSource="{Binding ToolbarMetricsRows}" Margin="8,8,8,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0"
                                        Background="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" />
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Latency}" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Кнопка закрытия — маленький крестик в правом верхнем углу без заголовка -->
            <Button Style="{StaticResource SmallIconButton}" Content="&#xE8BB;" FontSize="8" Foreground="White" Opacity="0.5" Width="16" Height="16"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                    Click="Close_Click" ToolTip="Скрыть метрики (включить снова в Настройки → Сеть → Метрики)" Cursor="Hand" />
            <!-- Ручка изменения размера — правый нижний угол -->
            <Border x:Name="ResizeGrip" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                    Background="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" ToolTip="Потяните для изменения размера">
                <Path Data="M 9 0 L 9 9 L 0 9 Z M 9 4 L 9 6 L 4 9 L 6 9 Z" Fill="White" Opacity="0.35" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
            </Border>
        </Grid>
    </Border>
</Window>
