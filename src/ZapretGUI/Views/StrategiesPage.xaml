<UserControl x:Class="ZapretGui.Views.StrategiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZapretGui.Views.Controls"
             Background="Transparent">
    <Grid Margin="24,20,20,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок и главные действия -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource DisplayText}" Text="Стратегии и автоподбор" />
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Интеллектуальный подбор параметров winws, визуальный конструктор и проверка на контрольных ресурсах" />
            </StackPanel>
            <WrapPanel Grid.Column="1" MaxWidth="500" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource PrimaryButton}" Content="Проверить все" Command="{Binding TestAllCommand}"
                        ToolTip="Последовательно запустить каждую стратегию и проверить YouTube, Discord, GitHub и пользовательские адреса" />
                <Button Style="{StaticResource DangerButton}" Content="Остановить" Margin="8,0,0,0"
                        Command="{Binding CancelTestCommand}"
                        Visibility="{Binding IsTestingAll, Converter={StaticResource BoolToVis}}"
                        ToolTip="Остановить перебор стратегий" />
                <Button Style="{StaticResource SecondaryButton}" Content="Обновить" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                        ToolTip="Перечитать .bat файлы движка и сохранённые стратегии" />
                <Button Style="{StaticResource GhostButton}" Content="Папка .bat" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                        ToolTip="Открыть папку движка в проводнике" />
            </WrapPanel>
        </Grid>

        <!-- Интеллектуальная рекомендация — ПЕРЕДЕЛАНО 1.6.6: акцентная карточка с лидером -->
        <Border Grid.Row="1" Margin="0,12,0,4" Padding="0" CornerRadius="12" BorderThickness="1.2" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}"
                Visibility="{Binding HasBestRecommendation, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,12,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8D2;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding BestStrategyRecommendationText}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="7,3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="ЛИДЕР СЕТИ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding BestStrategyDetailsText}" Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Opacity="0.85" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="⚡ Применить лидер" Padding="16,8" MinHeight="36" FontWeight="SemiBold"
                        Command="{Binding ApplyBestRecommendedCommand}" ToolTip="Запустить рекомендованную для вашей сети стратегию" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Подсказка для новичка — свёрнутый Expander, не занимает место -->
        <Expander Grid.Row="1" Margin="0,8,0,0" IsExpanded="False" Visibility="{Binding HasBestRecommendation, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="11" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Подсказка для новичка" Style="{StaticResource DimText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text=" — куда нажать, что значат вкладки" Style="{StaticResource DimText}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
                </StackPanel>
            </Expander.Header>
            <Border CornerRadius="8" Padding="12,10" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,6,0,0">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource SuccessSoftBrush}" Padding="6,3" Margin="0,0,6,0">
                            <TextBlock Text="1" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" FontSize="10" />
                        </Border>
                        <TextBlock Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" MaxWidth="640" Text="Нажмите «Проверить все» — зелёные строки «14/14 — OK» = работают у вашего провайдера. Красные/0/14 — блок." />
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource SuccessSoftBrush}" Padding="6,3" Margin="0,0,6,0">
                            <TextBlock Text="2" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" FontSize="10" />
                        </Border>
                        <TextBlock Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" MaxWidth="640" Text="Двойной клик по строке — применить (спросит «Служба или процесс?»). «Применить» — разовый запуск, «Как службу» — автозапуск." />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Text="Вкладки: «Конструктор» — собрать winws-параметры вручную; «Пул SNI» — IP/домены для игр и Discord; «Контрольные адреса» — свои сайты для проверки; «Умный автоподбор» — сам переберёт и найдёт лучшее." />
                </StackPanel>
            </Border>
        </Expander>

        <!-- Переключатель подвкладок раздела (Каталог / Конструктор / Контрольные адреса) -->
        <Grid Grid.Row="2" Margin="0,8,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:SegmentedControl ItemsSource="{Binding SubTabs}"
                                       SelectedIndex="{Binding SelectedSubTabIndex, Mode=TwoWay}"
                                       MinWidth="580" />
        </Grid>

        <!-- ============================== ВКЛАДКА 1: КАТАЛОГ СТРАТЕГИЙ ============================== -->
        <Grid Grid.Row="4" Visibility="{Binding IsCatalogTabVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Поиск и фильтры каталога — sticky Card с тенью -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по названию стратегии и параметрам winws.exe" />
                        <TextBlock Style="{StaticResource DimText}" Text="Поиск по названию или параметрам…" Margin="13,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                    </Grid>

                    <ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" MinWidth="140" MaxWidth="220" Margin="10,0,0,0"
                              ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex, Mode=TwoWay}"
                              ToolTip="Фильтр по группе стратегий: FAKE TLS AUTO, ALT, SIMPLE FAKE, базовая, автоконструктор" />

                    <!-- Фильтры «Только рекомендуемые»/«Рекомендуемая» удалены 23.09 — загромождали поиск -->
                </Grid>
            </Border>

            <!-- Панель пакетного тестирования -->
            <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,8"
                    CornerRadius="9" Background="{Binding TestSummaryKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding TestProgressVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Visibility="{Binding IsTestingAll, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding TestProgressText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding TestProgressPercentText}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ThinProgress}"
                                 Value="{Binding TestProgressValue, Mode=OneWay}"
                                 Maximum="{Binding TestProgressMaximum, Mode=OneWay}"
                                 Margin="0,6,0,4"
                                 Visibility="{Binding IsTestingAll, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding TestSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Двухколоночный мастер-детейл вид каталога -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" MinWidth="380" />
                    <ColumnDefinition Width="9*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ КОЛОНКА: Компактный список всех стратегий -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="6,2,6,6">
                            <TextBlock Style="{StaticResource SectionText}" Text="ВСЕ СТРАТЕГИИ" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" Background="Transparent"
                                 ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 MouseDoubleClick="StrategyList_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="StrategyList_PreviewMouseRightButtonDown"
                                 ItemContainerStyle="{StaticResource CompactRowItemStyle}"
                                 AlternationCount="2"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.IsDeferredScrollingEnabled="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTip="Enter — бесшовно применить выбранную стратегию; двойной клик — то же">
                            <ListBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding RunCommand}" CommandParameter="{Binding Selected}" />
                            </ListBox.InputBindings>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Проверить выбранную стратегию" Click="TestStrategyMenuItem_Click" />
                                    <MenuItem Header="Сделать основной стратегией" Click="SetDefaultMenuItem_Click" />
                                    <MenuItem Header="Скопировать параметры" Click="CopyStrategyArgsMenuItem_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Верхняя строка элемента: имя, категория, бейджи, кнопки -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Dot}" Margin="0,0,7,0"
                                                        Background="{Binding TestStatusKey, Converter={StaticResource SeverityBrush}}" />
                                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding Category}" FontSize="10.5" />
                                                </Border>
                                            </WrapPanel>

                                            <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource DimText}" Text="рекомендуется"
                                                           Foreground="{DynamicResource AccentBrush}" FontSize="10.5" />
                                            </Border>

                                            <WrapPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource DimText}" Text="{Binding TestStatusText}" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{Binding TestStatusKey, Converter={StaticResource SeverityBrush}}" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Применить" Padding="8,3" FontSize="11"
                                                        Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Бесшовно применить эту стратегию (переключит службу/процесс без ручной остановки)" />
                                                <Button Style="{StaticResource GhostButton}" Content="Тест" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.TestStrategyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Временно проверить эту стратегию и восстановить прежнее состояние" />
                                            </WrapPanel>
                                        </Grid>

                                        <!-- Нижняя строка: краткое описание -->
                                        <TextBlock Grid.Row="1" Style="{StaticResource DimText}" Text="{Binding Description}"
                                                   FontSize="11" Margin="14,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ПРАВАЯ КОЛОНКА: Детали выбранной стратегии и история -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly" Margin="6,0,0,0" Padding="0,0,2,0">
                    <StackPanel>
                        <!-- Карточка выбранной стратегии -->
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="ВЫБРАННАЯ СТРАТЕГИЯ" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding Selected.Name, FallbackValue=Ничего не выбрано}"
                                               FontSize="17" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedCategory}" />
                                    </Border>
                                </Grid>

                                <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedDescription}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                <!-- Кнопки управления стратегией — P1 1.6.9: динамический текст Запустить/Переключить -->
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding RunButtonText}" Margin="0,10,0,0"
                                        Command="{Binding RunCommand}"
                                        ToolTip="{Binding RunButtonTooltip}" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Проверить эту стратегию" Margin="0,0,3,0"
                                            Command="{Binding TestStrategyCommand}" CommandParameter="{Binding Selected}"
                                            ToolTip="Временно запустить стратегию и проверить YouTube, Discord и адреса" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Установить в службу" Margin="3,0,0,0"
                                            Command="{Binding InstallServiceCommand}"
                                            ToolTip="Установить эту стратегию в службу Windows zapret с автозапуском" />
                                </Grid>

                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Сделать основной"
                                            Command="{Binding SetDefaultCommand}"
                                            ToolTip="Сделать стратегией по умолчанию для запуска с кнопки питания" />
                                    <Button Style="{StaticResource GhostButton}" Content="Открыть .bat" Margin="6,0,0,0"
                                            Command="{Binding OpenBatCommand}" ToolTip="Открыть .bat файл стратегии в блокноте" />
                                    <Button Style="{StaticResource GhostButton}" Content="Скопировать" Margin="6,0,0,0"
                                            Command="{Binding CopyArgsCommand}" ToolTip="Скопировать строку аргументов winws.exe" />
                                </WrapPanel>

                                <TextBlock Style="{StaticResource DimText}" Text="{Binding Selected.TestResult.SummaryText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Visibility="{Binding Selected.TestResult.SummaryText, Converter={StaticResource StringToVis}}" />

                                <!-- Параметры winws.exe -->
                                <TextBlock Style="{StaticResource SectionText}" Text="ПАРАМЕТРЫ WINWS.EXE" Margin="0,10,0,0" />
                                <Border Style="{StaticResource InnerCard}" Padding="8,6">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding SelectedArgs}" TextWrapping="Wrap" ToolTip="{Binding SelectedArgs}" FontSize="11" />
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Style="{StaticResource SectionText}" Text="НОРМАЛИЗОВАННЫЕ ПРИЗНАКИ" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding SelectedFeatures}" TextWrapping="Wrap" FontSize="11.5" />
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedPath}" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPath}" FontSize="10.5" />

                                <Border Style="{StaticResource InnerCard}" Margin="0,8,0,0"
                                        Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Message}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- История проверок удалена 24.09 — дублирует логи -->

                        <!-- История переключений удалена 24.09 — доступна в логах -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================== ВКЛАДКА 2: КОНСТРУКТОР ПАРАМЕТРОВ ============================== -->
        <Grid Grid.Row="4" Visibility="{Binding IsBuilderTabVisible, Converter={StaticResource BoolToVis}}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*" MinWidth="360" />
                        <ColumnDefinition Width="10*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВАЯ КОЛОНКА: Форма настройки параметров -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ВИЗУАЛЬНЫЙ КОНСТРУКТОР WINWS" />
                            <TextBlock Style="{StaticResource MutedText}" Text="Тонкая ручная настройка параметров обхода DPI и генерация аргументов в реальном времени" Margin="0,2,0,12" />

                            <!-- Название стратегии -->
                            <TextBlock Style="{StaticResource DimText}" Text="НАЗВАНИЕ СТРАТЕГИИ" />
                            <TextBox Style="{StaticResource SearchBox}" Text="{Binding BuilderStrategyName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,4" ToolTip="Имя стратегии для сохранения в каталог — без расширения .bat" />
                            <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,6"
                                       Text="{Binding BuilderNameValidationText}" Foreground="{DynamicResource WarningBrush}"
                                       Visibility="{Binding BuilderNameValidationText, Converter={StaticResource StringToVis}}" TextWrapping="Wrap"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource GhostButton}" Content="⬇ Загрузить из выбранной в каталоге" Padding="8,3" FontSize="11"
                                        Command="{Binding LoadBuilderFromSelectedCommand}" ToolTip="Скопировать параметры выбранной стратегии из каталога в конструктор" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="→ правите и сохраняете как новую" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Opacity="0.7"/>
                            </Grid>

                            <!-- Пресеты — быстрый старт -->
                            <TextBlock Style="{StaticResource DimText}" Text="БЫСТРЫЙ ПРЕСЕТ (ШАБЛОН)" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding BuilderPresets}" DisplayMemberPath="DisplayText"
                                          SelectedItem="{Binding SelectedBuilderPreset, Mode=TwoWay}" ToolTip="Готовые шаблоны: стандарт, агрессивный, лёгкий, игровой" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Применить" Margin="6,0,0,0" Padding="10,3" FontSize="11"
                                        Command="{Binding ApplyBuilderPresetCommand}" ToolTip="Заполнить форму выбранным пресетом"/>
                            </Grid>

                            <!-- Режим расщепления и Split Pos -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="РЕЖИМ DPI-DESYNC" />
                                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                              ItemsSource="{Binding BuilderDesyncModes}" SelectedItem="{Binding BuilderDesyncMode, Mode=TwoWay}"
                                              ToolTip="Метод расщепления пакетов (split2, disorder2, fake...)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="ПОЗИЦИЯ SPLIT-POS" />
                                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                              ItemsSource="{Binding BuilderSplitPositions}" SelectedItem="{Binding BuilderSplitPos, Mode=TwoWay}"
                                              ToolTip="Позиция разделения (midsld - середина SNI, 1, 2, 3...)" />
                                </StackPanel>
                            </Grid>

                            <!-- Fake TLS SNI и TTL -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="ПОДДЕЛЬНЫЙ SNI (FAKE TLS)" />
                                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                              ItemsSource="{Binding BuilderFakeSnis}" SelectedItem="{Binding BuilderFakeSni, Mode=TwoWay}"
                                              ToolTip="Доменное имя, подставляемое в первый фейковый пакет" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="TTL (ВРЕМЯ ЖИЗНИ ПАКЕТА)" />
                                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                              ItemsSource="{Binding BuilderTtls}" SelectedItem="{Binding BuilderTtl, Mode=TwoWay}"
                                              ToolTip="Значение TTL для фейкового пакета (auto или фиксированное число)" />
                                </StackPanel>
                            </Grid>

                            <!-- Fooling метод -->
                            <TextBlock Style="{StaticResource DimText}" Text="FOOLING (МЕТОД ИСКАЖЕНИЯ)" />
                            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,10"
                                      ItemsSource="{Binding BuilderFoolings}" SelectedItem="{Binding BuilderFooling, Mode=TwoWay}"
                                      ToolTip="Способ сделать фейковый пакет незаметным для сервера (badsum, badseq...)" />

                            <!-- Чекбоксы дополнительных опций -->
                            <TextBlock Style="{StaticResource SectionText}" Text="ДОПОЛНИТЕЛЬНЫЕ МОДУЛИ" Margin="0,6,0,6" />
                            <CheckBox Style="{StaticResource CheckBoxApp}" Content="Игровой UDP фильтр (порты 50000-65535, голос Discord)"
                                      IsChecked="{Binding BuilderUseGameUdp, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,3,0,6" />
                            <CheckBox Style="{StaticResource CheckBoxApp}" Content="Включить multisplit seqovl"
                                      IsChecked="{Binding BuilderUseMultisplit, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,3,0,6" />
                            <CheckBox Style="{StaticResource CheckBoxApp}" Content="Применять списки hostlist (list-general.txt)"
                                      IsChecked="{Binding BuilderUseHostlist, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,3,0,6" />
                            <CheckBox Style="{StaticResource CheckBoxApp}" Content="Применять IP-фильтры ipset (ipset-all.txt)"
                                      IsChecked="{Binding BuilderUseIpSet, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,3,0,6" />
                        </StackPanel>
                    </Border>

                    <!-- ПРАВАЯ КОЛОНКА: Предпросмотр аргументов, тест и сохранение -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionText}" Text="СГЕНЕРИРОВАННЫЕ АРГУМЕНТЫ WINWS" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding BuilderArgsCountText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="⎘ Копировать" Padding="6,2" FontSize="11"
                                            Command="{Binding CopyBuilderArgsCommand}" ToolTip="Скопировать строку аргументов в буфер"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource InnerCard}" Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource ElevatedBrush}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="140">
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding BuilderGeneratedArgsPreview}" TextWrapping="Wrap" FontSize="11" />
                                </ScrollViewer>
                            </Border>
                            <!-- Чипы аргументов для наглядности -->
                            <WrapPanel Margin="0,0,0,12">
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,4,4" Visibility="{Binding BuilderHasArgs, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding BuilderDesyncMode, StringFormat='desync={0}'}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></Border>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" Margin="0,0,4,4"><TextBlock Text="{Binding BuilderSplitPos, StringFormat='split-pos={0}'}" FontSize="10"/></Border>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" Margin="0,0,4,4"><TextBlock Text="{Binding BuilderFakeSni, StringFormat='sni={0}'}" FontSize="10"/></Border>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" Margin="0,0,4,4"><TextBlock Text="{Binding BuilderTtl, StringFormat='ttl={0}'}" FontSize="10"/></Border>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource ElevatedBrush}" Margin="0,0,4,4"><TextBlock Text="{Binding BuilderFooling, StringFormat='fooling={0}'}" FontSize="10"/></Border>
                            </WrapPanel>

                            <TextBlock Style="{StaticResource SectionText}" Text="ДЕЙСТВИЯ И ТЕСТИРОВАНИЕ" />
                            <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" Text="Протестируйте параметры без сохранения — временный winws проверит контрольные адреса, затем восстановит прежний обход."/>
                            <WrapPanel Margin="0,8,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Content="Протестировать параметры"
                                        Command="{Binding BuilderTestCommand}"
                                        ToolTip="Временно запустить процесс winws с этими параметрами и проверить соединение" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить в каталог" Margin="8,0,0,0"
                                        Command="{Binding BuilderSaveCommand}"
                                        ToolTip="Сохранить эти параметры как собственную стратегию в папку candidates" />
                                <Button Style="{StaticResource GhostButton}" Content="Применить сейчас" Margin="8,0,0,0"
                                        Command="{Binding BuilderApplyCommand}"
                                        ToolTip="Сохранить и сразу запустить постоянный обход с этими параметрами" />
                            </WrapPanel>

                            <!-- Статус тестирования конструктора -->
                            <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="8"
                                    Background="{Binding BuilderTestStatusKey, Converter={StaticResource SoftSeverityBrush}}"
                                    Visibility="{Binding BuilderTestStatus, Converter={StaticResource StringToVis}}">
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding BuilderTestStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ============================== ВКЛАДКА 3: УМНЫЙ АВТОПОДБОР ============================== -->
        <Grid Grid.Row="4" Visibility="{Binding IsAutoTunerTabVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Описание и панель управления автоподбором -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource TitleText}" Text="🧠 Глубокий интеллектуальный автоподбор DPI-стратегий" FontWeight="Bold" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Автономный движок последовательно синтезирует и тестирует передовые комбинации обхода (split2, sniext, disoob, fake sni, badsum, md5sig, multisplit) в изолированном тестовом контуре с замером RTT и процента успешных ответов контрольных ресурсов." />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="🚀 Запустить глубокий автоподбор"
                                    Command="{Binding StartSmartAutoTuningCommand}"
                                    Visibility="{Binding IsAutoTuningRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                    ToolTip="Запустить многопроходное тестирование комбинаций и генерацию оптимальной стратегии" />
                            <Button Style="{StaticResource DangerButton}"
                                    Content="🛑 Остановить"
                                    Command="{Binding CancelSmartAutoTuningCommand}"
                                    Visibility="{Binding IsAutoTuningRunning, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Остановить тестирование текущей очереди гипотез" />
                            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Content="⚡ Применить найденный оптимум"
                                    Command="{Binding ApplyWinnerStrategyCommand}"
                                    Visibility="{Binding HasWinnerCandidate, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Сделать найденную оптимальную стратегию основной и запустить постоянный обход" />
                        </WrapPanel>
                    </Grid>

                    <!-- Статус и шкала выполнения -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding AutoTuningStatusText}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                       Text="{Binding AutoTuningProgressPercentText}" FontWeight="Bold" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Height="8"
                                     Value="{Binding AutoTuningProgressValue, Mode=OneWay}"
                                     Maximum="{Binding AutoTuningProgressMaximum, Mode=OneWay}"
                                     BorderThickness="0" Background="{DynamicResource ElevatedBrush}" Foreground="{DynamicResource AccentBrush}" />
                    </Grid>

                    <!-- Баннер победителя (если найден) -->
                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="14,12" CornerRadius="8"
                            Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                            Visibility="{Binding HasWinnerCandidate, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding WinnerCandidateTitle}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding WinnerCandidate.Summary}" Margin="0,2,0,4" />
                                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                                           Text="{Binding WinnerCandidate.ArgumentsPreview}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="Установить и запустить"
                                    Command="{Binding ApplyWinnerStrategyCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Список протестированных гипотез с баллами -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionText}" Text="РЕЗУЛЬТАТЫ ПРОВЕРКИ ГИПОТЕЗ И МЕТРИКИ ЭФФЕКТИВНОСТИ" />
                    </Grid>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding AutoTuningResults}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8"
                                        Background="{DynamicResource ElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Бейдж статуса -->
                                        <Border Grid.Column="0" Margin="0,0,12,0" Padding="8,4" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{Binding StatusSeverity, Converter={StaticResource SoftSeverityBrush}}">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11"
                                                       Foreground="{Binding StatusSeverity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>

                                        <!-- Описание гипотезы и параметры -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding HypothesisTitle}" />
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Text="{Binding DetailsText}" Margin="0,2,0,2" />
                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding ArgumentsPreview}" />
                                        </StackPanel>

                                        <!-- Счёт и задержка -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding ScoreText}" FontWeight="Bold" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding RttText}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== ВКЛАДКА 4: ПУЛ TLS SNI ФЕЙКОВ ============================== -->
        <Grid Grid.Row="3" Visibility="{Binding IsSniPoolTabVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Верхняя панель: Выбор и автоподбор SNI -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource SectionText}" Text="ПУЛ TLS SNI ФЕЙКОВ И РОТАЦИЯ ПРОТИВ ТСПУ" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="Winws десинхронизирует TLS-трафик, подставляя доверенный SNI в фейковый ClientHello. Выберите домен с наивысшим доверием у вашего провайдера или запустите автоподбор." TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource PrimaryButton}" Content="⚡ Подобрать лучший SNI"
                                    Command="{Binding AutoSelectBestSniCommand}"
                                    ToolTip="Провести параллельное TLS-тестирование всех SNI и выбрать самый быстрый и стабильный" />
                            <Button Style="{StaticResource SecondaryButton}" Content="🔄 Сменить SNI" Margin="8,0,0,0"
                                    Command="{Binding RotateToNextSniCommand}"
                                    ToolTip="Переключить на следующий домен из пула высокой надежности" />
                        </WrapPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource SectionText}" Text="АКТИВНЫЙ TLS SNI ФЕЙК" />
                            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                      ItemsSource="{Binding SniCandidates}"
                                      SelectedItem="{Binding SelectedSniCandidate, Mode=TwoWay}"
                                      ToolTip="Выберите домен, который будет отправляться ТСПУ в фейковом TLS ClientHello">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource SectionText}" Text="АВТОМАТИЧЕСКАЯ РОТАЦИЯ" />
                            <CheckBox Style="{StaticResource CheckBoxApp}" Content="Ротировать SNI при падении качества связи"
                                      IsChecked="{Binding AutoSniRotationEnabled, Mode=TwoWay}" Margin="0,6,0,0"
                                      ToolTip="При обнаружении сбоев или блокировок автоматически переключаться на следующий резервный SNI" />
                        </StackPanel>
                    </Grid>

                    <!-- Статус тестирования SNI -->
                    <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8"
                            Background="{DynamicResource ElevatedBrush}"
                            Visibility="{Binding IsTestingSniPool, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding SniTestingStatusText}" FontWeight="SemiBold" />
                            <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Список результатов тестирования SNI -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionText}" Text="РЕЗУЛЬТАТЫ ПРОВЕРКИ ДОМЕНОВ И ЗАДЕРЖКА TLS HANDSHAKE" Margin="0,0,0,10" />

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding SniTestResults}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                                        Background="{DynamicResource ElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Margin="0,0,12,0" Padding="8,4" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{Binding StatusKey, Converter={StaticResource SoftSeverityBrush}}">
                                            <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="11"
                                                       Foreground="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Domain}" />
                                            <TextBlock Style="{StaticResource DimText}" FontSize="11" Text="{Binding Details}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{Binding StatusKey, Converter={StaticResource SeverityBrush}}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== ВКЛАДКА 5: КОНТРОЛЬНЫЕ АДРЕСА ============================== -->
        <Grid Grid.Row="3" Visibility="{Binding IsTargetsTabVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Заголовок и форма добавления нового контрольного адреса -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionText}" Text="КОНТРОЛЬНЫЕ СЕРВИСЫ И ЭНДПОИНТЫ ДЛЯ ПРОВЕРКИ" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Эти ресурсы проверяются при тестировании любой стратегии. Добавьте свои любимые сервисы, игры или сайты для точной оценки." Margin="0,2,0,10" />
                        <Border Style="{StaticResource InnerCard}" Margin="0,0,0,10" Padding="12,10">
                            <StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Расширять проверку целями из utils/targets.txt (Flowseal)" IsChecked="{Binding UseTargetsTxtForStrategyTest, Mode=TwoWay}" ToolTip="Если включено — к базовым 8 добавляются HTTP-цели из utils/targets.txt движка (Discord, YouTube, Google, Cloudflare из remotes, как в zapret.ps1)" />
                                <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,6,0,0" Text="{Binding TargetsTxtStatusText}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,4,0,0" Text="{Binding EffectiveTargetCountText}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Style="{StaticResource DimText}" FontSize="10" Margin="0,4,0,0" Text="Путь: utils/targets.txt в папке движка; PING-only строки пропускаются, берутся только https://." Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,4,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SearchBox}" Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Название (например, Twitch, Spotify, Notion, Discord Voice)" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Text="{Binding NewTargetUrl, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="URL или хост (например, https://twitch.tv или https://open.spotify.com)" Margin="6,0,6,0" />
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Добавить адрес" Margin="6,0,0,0"
                                    Command="{Binding AddTargetCommand}" ToolTip="Добавить сайт в список контрольных проверок" />
                        </Grid>
                    </StackPanel>

                    <!-- Список всех контрольных адресов -->
                    <TextBlock Grid.Row="1" Style="{StaticResource SectionText}" Text="СПИСОК АКТИВНЫХ АДРЕСОВ" Margin="0,6,0,6" />
                    <ListBox Grid.Row="2" Style="{StaticResource PlainListBox}" Background="Transparent"
                             ItemsSource="{Binding TargetEndpoints}"
                             ItemContainerStyle="{StaticResource CompactRowItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="8,7" Margin="0,0,0,0" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Style="{StaticResource CheckBoxApp}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  Command="{Binding DataContext.ToggleTargetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <WrapPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Style="{StaticResource DimText}" Text=" • встроенный" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}" Opacity="0.7"
                                                           Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding Url}" FontSize="11" Margin="0,1,0,0" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <WrapPanel Grid.Column="2" VerticalAlignment="Center"
                                                   Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                                    FontFamily="{DynamicResource IconFont}" FontSize="11"
                                                    Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Удалить этот контрольный адрес" Opacity="0.6" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
