<UserControl x:Class="ZapretGui.Views.StrategiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly" Padding="0,0,4,0">
    <Grid Margin="24,20,20,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource DisplayText}" Text="Стратегии" />
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Список формируется автоматически из .bat файлов движка — новые стратегии появляются без обновления GUI" />
                <TextBlock Style="{StaticResource DimText}" Text="{Binding ProviderContextText}" Margin="0,5,0,0"
                           ToolTip="Контекст провайдера берётся только из настроек пользователя; endpoint из DPI-suite не используется как ISP" />
            </StackPanel>
            <WrapPanel Grid.Column="1" MaxWidth="500" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource PrimaryButton}" Content="Проверить все стратегии" Command="{Binding TestAllCommand}"
                        ToolTip="Последовательно запустить каждую стратегию и проверить YouTube, Discord и GitHub" />
                <Button Style="{StaticResource DangerButton}" Content="Остановить проверку" Margin="8,0,0,0"
                        Command="{Binding CancelTestCommand}"
                        Visibility="{Binding IsTestingAll, Converter={StaticResource BoolToVis}}"
                        ToolTip="Остановить перебор стратегий и не менять текущую стратегию" />
                <Button Style="{StaticResource SecondaryButton}" Content="Обновить список" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                        ToolTip="Перечитать .bat файлы движка и обновить список стратегий" />
                <Button Style="{StaticResource GhostButton}" Content="Открыть папку" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                        ToolTip="Открыть папку движка в проводнике" />
            </WrapPanel>
        </Grid>

        <!-- Панель поиска и фильтров -->
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Поиск по названию стратегии и параметрам winws.exe" />
                <TextBlock Style="{StaticResource DimText}" Text="Поиск по названию или параметрам…" Margin="13,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
            </Grid>

            <ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" MinWidth="140" MaxWidth="220" Margin="12,0,0,0"
                      ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex, Mode=TwoWay}"
                      ToolTip="Фильтр по группе стратегий: FAKE TLS AUTO, ALT, SIMPLE FAKE, базовая, экспериментальные" />

            <ToggleButton Grid.Column="2" Style="{StaticResource ChipToggle}" Margin="12,0,0,0"
                          Content="Только рекомендуемые" IsChecked="{Binding OnlyRecommended, Mode=TwoWay}"
                          ToolTip="Показать только рекомендуемые стратегии (проверенные, стабильные)" />

            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Content="Выбрать рекомендуемую"
                    Command="{Binding UseRecommendedCommand}"
                    ToolTip="Выбрать рекомендуемую стратегию (обычно general FAKE TLS AUTO)" />
        </Grid>

        <Border Grid.Row="2" Margin="0,0,0,12" Padding="14,10"
                CornerRadius="9" Background="{Binding TestSummaryKey, Converter={StaticResource SoftSeverityBrush}}"
                Visibility="{Binding TestProgressVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Visibility="{Binding IsTestingAll, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding TestProgressText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding TestProgressPercentText}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                </Grid>
                <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding TestProgressValue}" Maximum="{Binding TestProgressMaximum}"
                             IsIndeterminate="{Binding TestProgressIndeterminate}" Margin="0,7,0,5"
                             Visibility="{Binding IsTestingAll, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding TestSummary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Список и детали. Блоки выстроены вертикально, чтобы страница
             прокручивалась только по вертикали на узком окне. -->
        <StackPanel Grid.Row="3">
            <StackPanel>
                <TextBlock Style="{StaticResource DimText}" Text="{Binding CountText}" Margin="2,0,0,0" />
                <ListBox Style="{StaticResource PlainListBox}" Margin="0,8,0,0" Background="Transparent"
                         ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         MouseDoubleClick="StrategyList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="StrategyList_PreviewMouseRightButtonDown"
                         ItemContainerStyle="{StaticResource RowItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Проверить выбранную стратегию" Click="TestStrategyMenuItem_Click" />
                            <MenuItem Header="Сделать основной стратегией" Click="SetDefaultMenuItem_Click" />
                            <MenuItem Header="Скопировать параметры" Click="CopyStrategyArgsMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding Category}" />
                                        </Border>
                                    </WrapPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Badge}"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource DimText}" Text="рекомендуется"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <WrapPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Применить" Padding="10,5"
                                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Остановить текущий обход и запустить эту стратегию" />
                                        <Button Style="{StaticResource GhostButton}" Content="Проверить" Padding="10,5" Margin="6,0,0,0"
                                                Command="{Binding DataContext.TestStrategyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Временно проверить эту стратегию и затем восстановить прежнее состояние" />
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding TestStatusText}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding TestStatusKey, Converter={StaticResource SeverityBrush}}" />
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding Description}" Margin="0,6,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Детали выбранной стратегии -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" VerticalAlignment="Top">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="560">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="ВЫБРАННАЯ СТРАТЕГИЯ" />
                        <TextBlock Style="{StaticResource TitleText}" Text="{Binding Selected.Name, FallbackValue=Ничего не выбрано}" />
                        <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedDescription}" Margin="0,6,0,0" />

                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedCategory}" />
                        </Border>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Style="{StaticResource SectionText}" Text="ПАРАМЕТРЫ WINWS.EXE" />
                        <Border Style="{StaticResource InnerCard}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="180">
                                <TextBlock Style="{StaticResource MonoText}" Text="{Binding SelectedArgs}" TextWrapping="Wrap" ToolTip="{Binding SelectedArgs}" />
                            </ScrollViewer>
                        </Border>

                        <TextBlock Style="{StaticResource SectionText}" Text="НОРМАЛИЗОВАННЫЕ ПРИЗНАКИ" Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding SelectedFeatures}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Собрать предпросмотр кандидата" Margin="0,12,0,0"
                                Command="{Binding BuildCandidatePreviewCommand}"
                                ToolTip="Создать черновик на основе аргументов выбранной стратегии; обход не запускается" />
                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Собрать набор вариантов"
                                    Command="{Binding GenerateCandidatesCommand}"
                                    ToolTip="Собрать до 16 вариантов из параметров существующих стратегий; запуск не выполняется" />
                            <Button Style="{StaticResource GhostButton}" Content="Отменить" Margin="6,0,0,0"
                                    Command="{Binding CancelCandidateGenerationCommand}"
                                    Visibility="{Binding IsGeneratingCandidates, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Остановить сбор вариантов" />
                        </WrapPanel>
                        <Border Style="{StaticResource InnerCard}" Margin="0,8,0,0"
                                Visibility="{Binding CandidateGenerationVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="НАБОР КАНДИДАТОВ" />
                                <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="6" Background="{DynamicResource ElevatedBrush}"
                                        Visibility="{Binding IsGeneratingCandidates, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource BodyText}" Text="Анализирую параметры и формирую набор вариантов…" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding CandidateGenerationText}" TextWrapping="Wrap" />
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding GeneratedCandidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Divider}" Padding="0,7,0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" TextWrapping="Wrap" />
                                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding MutationDescription}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Просмотр" Padding="10,5"
                                                                Command="{Binding DataContext.PreviewGeneratedCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Показать аргументы и признаки этого кандидата" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Проверить варианты"
                                            Command="{Binding EvaluateCandidatesCommand}"
                                            ToolTip="Два раза проверить каждый вариант с восстановлением прежнего состояния обхода" />
                                    <Button Style="{StaticResource GhostButton}" Content="Отменить проверку" Margin="6,0,0,0"
                                            Command="{Binding CancelCandidateEvaluationCommand}"
                                            Visibility="{Binding IsEvaluatingCandidates, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Остановить проверку после текущей пробы" />
                                    <Button Style="{StaticResource GhostButton}" Content="Экспорт отчёта" Margin="6,0,0,0"
                                            Command="{Binding ExportCandidateReportCommand}"
                                            ToolTip="Сохранить JSON с кандидатами, признаками, score, причинами отказа и историей проверок" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InnerCard}" Margin="0,8,0,0"
                                Visibility="{Binding CandidateEvaluationVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="РЕЗУЛЬТАТЫ ПРОВЕРКИ" />
                                <Grid Visibility="{Binding CandidateEvaluationProgressVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding CandidateEvaluationText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding CandidateEvaluationProgressPercentText}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                </Grid>
                                <ProgressBar Style="{StaticResource ThinProgress}" Height="6" Margin="0,2,0,8"
                                             Value="{Binding CandidateEvaluationProgressValue}"
                                             Maximum="{Binding CandidateEvaluationProgressMaximum}"
                                             IsIndeterminate="False"
                                             Visibility="{Binding CandidateEvaluationProgressVisible, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding CandidateEvaluationText}" TextWrapping="Wrap"
                                           Visibility="{Binding CandidateEvaluationProgressVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding CandidateEvaluationView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Divider}" Padding="0,7,0,7">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding MutationDescription}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding StatusText}" Margin="0,4,0,0" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding AttemptsText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding ChecksText, StringFormat=проверки: {0}}" Margin="0,2,0,0" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding AverageElapsedText, StringFormat=среднее время: {0}}" Margin="0,2,0,0" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding StabilityText, StringFormat=стабильность: {0}}" Margin="0,2,0,0" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding ScoreBreakdownText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding ScoreText, StringFormat=итоговый score: {0}}" Margin="0,2,0,0" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding FailureReasonsText, StringFormat=причины отклонения: {0}}"
                                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InnerCard}" Margin="0,8,0,0"
                                Visibility="{Binding EvaluationHistoryVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="ИСТОРИЯ ПОДБОРА" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="История хранится только в профиле пользователя и используется как осторожная эвристика для последующего порядка проверки." TextWrapping="Wrap" />
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding EvaluationHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Divider}" Padding="0,7,0,7">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding CandidateName}" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding SourceStrategy, StringFormat=источник: {0}}" Margin="0,2,0,0" />
                                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding MutationDescription}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding FeaturesSummary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding ProviderText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding ResultSummaryText}" Margin="0,2,0,0" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding AverageElapsedText, StringFormat=среднее: {0}}" Margin="0,2,0,0" />
                                                        <TextBlock Style="{StaticResource DimText}"
                                                                   Text="{Binding CompletedAtText, StringFormat=проверено: {0}}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InnerCard}" Margin="0,8,0,0"
                                Visibility="{Binding SavedCandidatesVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="СОХРАНЁННЫЕ КАНДИДАТЫ" />
                                <ItemsControl ItemsSource="{Binding SavedCandidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Divider}" Padding="0,7,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding SavedAtText}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource GhostButton}" Content="Просмотр" Padding="10,5"
                                                                Command="{Binding DataContext.PreviewSavedCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource GhostButton}" Content="Удалить" Padding="10,5" Margin="5,0,0,0"
                                                                Command="{Binding DataContext.DeleteSavedCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding PreviousStrategyText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Button Style="{StaticResource GhostButton}" Content="Вернуть предыдущую стратегию" Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RestorePreviousCommand}"
                                        Visibility="{Binding CanRestorePrevious, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Вернуть стратегию, которая была основной до назначения кандидата" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0"
                                Visibility="{Binding CandidatePreviewVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="ПРЕДПРОСМОТР КАНДИДАТА" />
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding CandidatePreviewName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding CandidatePreviewProvider}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding CandidatePreviewSummary}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding CandidateSaveStatusText}" Margin="0,6,0,0" />
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Сохранить отдельно" Padding="10,5"
                                            Command="{Binding SaveCandidateCommand}"
                                            ToolTip="Сохранить кандидата в профиль Zapret GUI без изменения оригинальных стратегий" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Запустить сохранённый" Padding="10,5" Margin="6,0,0,0"
                                            Command="{Binding RunSavedCandidateCommand}"
                                            Visibility="{Binding IsCandidatePreviewSaved, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Запустить сохранённый кандидат после отдельного подтверждения; основная стратегия не изменится" />
                                    <Button Style="{StaticResource GhostButton}" Content="Сделать основным" Padding="10,5" Margin="6,0,0,0"
                                            Command="{Binding MakeCandidatePrimaryCommand}"
                                            Visibility="{Binding IsCandidatePreviewSaved, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Назначить сохранённый кандидат основной стратегией без запуска и изменения службы" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource DimText}" Text="Параметры для будущего перебора:" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource MonoText}" Text="{Binding CandidatePreviewTunableArgs}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Style="{StaticResource DimText}" Text="Зафиксированные аргументы:" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource MonoText}" Text="{Binding CandidatePreviewFixedArgs}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="Признаки: " />
                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding CandidatePreviewFeatures}" TextWrapping="Wrap" />
                                </WrapPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="130" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding CandidatePreviewArgs}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource PrimaryButton}" Content="Применить и запустить стратегию" Margin="0,14,0,0"
                                Command="{Binding RunCommand}"
                                ToolTip="Остановить текущий обход и запустить выбранную стратегию" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Проверить эту стратегию" Margin="0,8,0,0"
                                Command="{Binding TestStrategyCommand}" CommandParameter="{Binding Selected}"
                                ToolTip="Временно запустить стратегию и проверить YouTube, Discord и GitHub, затем вернуть прежнее состояние" />
                        <TextBlock Style="{StaticResource DimText}" Text="{Binding Selected.TestResult.SummaryText}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding Selected.TestResult.SummaryText, Converter={StaticResource StringToVis}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Установить в службу" Margin="0,8,0,0"
                                Command="{Binding InstallServiceCommand}"
                                ToolTip="Установить эту стратегию в службу Windows zapret с автозапуском при включении компьютера" />
                        <Button Style="{StaticResource GhostButton}" Content="Сделать основной стратегией" Margin="0,8,0,0"
                                Command="{Binding SetDefaultCommand}"
                                ToolTip="Сделать стратегией по умолчанию — её будет запускать круглая кнопка на странице «Обзор»" />
                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Открыть .bat" Command="{Binding OpenBatCommand}"
                                    ToolTip="Открыть .bat файл стратегии в блокноте" />
                            <Button Style="{StaticResource GhostButton}" Content="Скопировать команду" Margin="6,0,0,0"
                                    Command="{Binding CopyArgsCommand}"
                                    ToolTip="Скопировать полную командную строку winws.exe в буфер обмена" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedPath}" Margin="0,12,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPath}" />

                        <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0"
                                Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Message}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Подсказка, если движка нет -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" VerticalAlignment="Top"
                    Visibility="{Binding IsEngineMissing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                               Text="Движок не установлен" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Скачайте сборку со страницы «Обновления» или укажите путь к уже распакованной папке в настройках — тогда здесь появится список стратегий." />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
