<UserControl x:Class="ZapretGui.Views.StrategiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ZapretGui.Views.Controls"
             Background="Transparent">
    <Grid Margin="24,20,20,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок и главные действия -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource DisplayText}" Text="Стратегии и автоподбор" />
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Интеллектуальный подбор параметров winws, визуальный конструктор и проверка на контрольных ресурсах" />
            </StackPanel>
            <WrapPanel Grid.Column="1" MaxWidth="500" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource PrimaryButton}" Content="Проверить все" Command="{Binding TestAllCommand}"
                        ToolTip="Последовательно запустить каждую стратегию и проверить YouTube, Discord, GitHub и пользовательские адреса" />
                <Button Style="{StaticResource DangerButton}" Content="Остановить" Margin="8,0,0,0"
                        Command="{Binding CancelTestCommand}"
                        Visibility="{Binding IsTestingAll, Converter={StaticResource BoolToVis}}"
                        ToolTip="Остановить перебор стратегий" />
                <Button Style="{StaticResource SecondaryButton}" Content="Обновить" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                        ToolTip="Перечитать .bat файлы движка и сохранённые стратегии" />
                <Button Style="{StaticResource GhostButton}" Content="Папка .bat" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"
                        ToolTip="Открыть папку движка в проводнике" />
            </WrapPanel>
        </Grid>

        <!-- Интеллектуальная рекомендация для текущей сети -->
        <Border Grid.Row="1" Margin="0,12,0,4" Padding="14,10" CornerRadius="9"
                Background="{DynamicResource AccentSoftBrush}"
                Visibility="{Binding HasBestRecommendation, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Dot}" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding BestStrategyRecommendationText}" FontWeight="Bold" />
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="ЛИДЕР СЕТИ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding BestStrategyDetailsText}" Margin="16,2,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="Применить лидер" Padding="10,4" FontSize="11.5"
                            Command="{Binding ApplyBestRecommendedCommand}"
                            ToolTip="Запустить рекомендованную для вашей сети стратегию" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Переключатель подвкладок раздела (Каталог / Конструктор / Контрольные адреса) -->
        <Grid Grid.Row="2" Margin="0,8,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:SegmentedControl ItemsSource="{Binding SubTabs}"
                                       SelectedIndex="{Binding SelectedSubTabIndex, Mode=TwoWay}"
                                       MinWidth="460" />
        </Grid>

        <!-- ============================== ВКЛАДКА 1: КАТАЛОГ СТРАТЕГИЙ ============================== -->
        <Grid Grid.Row="3" Visibility="{Binding IsCatalogTabVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Поиск и фильтры каталога -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по названию стратегии и параметрам winws.exe" />
                    <TextBlock Style="{StaticResource DimText}" Text="Поиск по названию или параметрам…" Margin="13,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
                </Grid>

                <ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" MinWidth="140" MaxWidth="220" Margin="10,0,0,0"
                          ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex, Mode=TwoWay}"
                          ToolTip="Фильтр по группе стратегий: FAKE TLS AUTO, ALT, SIMPLE FAKE, базовая, автоконструктор" />

                <ToggleButton Grid.Column="2" Style="{StaticResource ChipToggle}" Margin="10,0,0,0"
                              Content="Только рекомендуемые" IsChecked="{Binding OnlyRecommended, Mode=TwoWay}"
                              ToolTip="Показать только рекомендуемые стратегии" />

                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Content="Рекомендуемая"
                        Command="{Binding UseRecommendedCommand}"
                        ToolTip="Выбрать рекомендуемую стратегию" />
            </Grid>

            <!-- Панель пакетного тестирования -->
            <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,8"
                    CornerRadius="9" Background="{Binding TestSummaryKey, Converter={StaticResource SoftSeverityBrush}}"
                    Visibility="{Binding TestProgressVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Visibility="{Binding IsTestingAll, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding TestProgressText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding TestProgressPercentText}" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ThinProgress}"
                                 Value="{Binding TestProgressValue, Mode=OneWay}"
                                 Maximum="{Binding TestProgressMaximum, Mode=OneWay}"
                                 Margin="0,6,0,4"
                                 Visibility="{Binding IsTestingAll, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding TestSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Двухколоночный мастер-детейл вид каталога -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" MinWidth="380" />
                    <ColumnDefinition Width="9*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ КОЛОНКА: Компактный список всех стратегий -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="6,2,6,6">
                            <TextBlock Style="{StaticResource SectionText}" Text="ВСЕ СТРАТЕГИИ" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource DimText}" Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" Background="Transparent"
                                 ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 MouseDoubleClick="StrategyList_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="StrategyList_PreviewMouseRightButtonDown"
                                 ItemContainerStyle="{StaticResource CompactRowItemStyle}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Проверить выбранную стратегию" Click="TestStrategyMenuItem_Click" />
                                    <MenuItem Header="Сделать основной стратегией" Click="SetDefaultMenuItem_Click" />
                                    <MenuItem Header="Скопировать параметры" Click="CopyStrategyArgsMenuItem_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Верхняя строка элемента: имя, категория, бейджи, кнопки -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Dot}" Margin="0,0,7,0"
                                                        Background="{Binding TestStatusKey, Converter={StaticResource SeverityBrush}}" />
                                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource DimText}" Text="{Binding Category}" FontSize="10.5" />
                                                </Border>
                                            </WrapPanel>

                                            <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource DimText}" Text="рекомендуется"
                                                           Foreground="{DynamicResource AccentBrush}" FontSize="10.5" />
                                            </Border>

                                            <WrapPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource DimText}" Text="{Binding TestStatusText}" Margin="0,0,8,0"
                                                           VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{Binding TestStatusKey, Converter={StaticResource SeverityBrush}}" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="Применить" Padding="8,3" FontSize="11"
                                                        Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Остановить текущий обход и запустить эту стратегию" />
                                                <Button Style="{StaticResource GhostButton}" Content="Тест" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.TestStrategyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Временно проверить эту стратегию и восстановить прежнее состояние" />
                                            </WrapPanel>
                                        </Grid>

                                        <!-- Нижняя строка: краткое описание -->
                                        <TextBlock Grid.Row="1" Style="{StaticResource DimText}" Text="{Binding Description}"
                                                   FontSize="11" Margin="14,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ПРАВАЯ КОЛОНКА: Детали выбранной стратегии и история -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly" Margin="6,0,0,0" Padding="0,0,2,0">
                    <StackPanel>
                        <!-- Карточка выбранной стратегии -->
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionText}" Text="ВЫБРАННАЯ СТРАТЕГИЯ" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TitleText}" Text="{Binding Selected.Name, FallbackValue=Ничего не выбрано}"
                                               FontSize="17" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedCategory}" />
                                    </Border>
                                </Grid>

                                <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedDescription}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                <!-- Кнопки управления стратегией -->
                                <Button Style="{StaticResource PrimaryButton}" Content="Применить и запустить стратегию" Margin="0,10,0,0"
                                        Command="{Binding RunCommand}"
                                        ToolTip="Остановить текущий обход и запустить выбранную стратегию" />

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Проверить эту стратегию" Margin="0,0,3,0"
                                            Command="{Binding TestStrategyCommand}" CommandParameter="{Binding Selected}"
                                            ToolTip="Временно запустить стратегию и проверить YouTube, Discord и адреса" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Установить в службу" Margin="3,0,0,0"
                                            Command="{Binding InstallServiceCommand}"
                                            ToolTip="Установить эту стратегию в службу Windows zapret с автозапуском" />
                                </Grid>

                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="Сделать основной"
                                            Command="{Binding SetDefaultCommand}"
                                            ToolTip="Сделать стратегией по умолчанию для запуска с кнопки питания" />
                                    <Button Style="{StaticResource GhostButton}" Content="Открыть .bat" Margin="6,0,0,0"
                                            Command="{Binding OpenBatCommand}" ToolTip="Открыть .bat файл стратегии в блокноте" />
                                    <Button Style="{StaticResource GhostButton}" Content="Скопировать" Margin="6,0,0,0"
                                            Command="{Binding CopyArgsCommand}" ToolTip="Скопировать строку аргументов winws.exe" />
                                </WrapPanel>

                                <TextBlock Style="{StaticResource DimText}" Text="{Binding Selected.TestResult.SummaryText}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Visibility="{Binding Selected.TestResult.SummaryText, Converter={StaticResource StringToVis}}" />

                                <!-- Параметры winws.exe -->
                                <TextBlock Style="{StaticResource SectionText}" Text="ПАРАМЕТРЫ WINWS.EXE" Margin="0,10,0,0" />
                                <Border Style="{StaticResource InnerCard}" Padding="8,6">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                        <TextBlock Style="{StaticResource MonoText}" Text="{Binding SelectedArgs}" TextWrapping="Wrap" ToolTip="{Binding SelectedArgs}" FontSize="11" />
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Style="{StaticResource SectionText}" Text="НОРМАЛИЗОВАННЫЕ ПРИЗНАКИ" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding SelectedFeatures}" TextWrapping="Wrap" FontSize="11.5" />
                                <TextBlock Style="{StaticResource DimText}" Text="{Binding SelectedPath}" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPath}" FontSize="10.5" />

                                <Border Style="{StaticResource InnerCard}" Margin="0,8,0,0"
                                        Visibility="{Binding MessageVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Message}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- История проверок стратегий -->
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SectionText}" Text="ИСТОРИЯ ПРОВЕРОК" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding EvaluationHistoryCountText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource GhostButton}" Content="Очистить" Padding="8,3" FontSize="11"
                                                Command="{Binding ClearHistoryCommand}" ToolTip="Очистить сохранённую историю проверок" />
                                    </WrapPanel>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding EvaluationHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource InnerCard}" Margin="0,3,0,0" Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding ResultSummaryText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource DimText}" Text="{Binding CompletedAtText}" FontSize="10.5" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================== ВКЛАДКА 2: КОНСТРУКТОР ПАРАМЕТРОВ ============================== -->
        <Grid Grid.Row="3" Visibility="{Binding IsBuilderTabVisible, Converter={StaticResource BoolToVis}}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*" MinWidth="360" />
                        <ColumnDefinition Width="10*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВАЯ КОЛОНКА: Форма настройки параметров -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="ВИЗУАЛЬНЫЙ КОНСТРУКТОР WINWS" />
                            <TextBlock Style="{StaticResource MutedText}" Text="Тонкая ручная настройка параметров обхода DPI и генерация аргументов в реальном времени" Margin="0,2,0,12" />

                            <!-- Название стратегии -->
                            <TextBlock Style="{StaticResource DimText}" Text="НАЗВАНИЕ СТРАТЕГИИ" />
                            <TextBox Style="{StaticResource SearchBox}" Text="{Binding BuilderStrategyName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,10" ToolTip="Имя стратегии для сохранения в каталог" />

                            <!-- Режим расщепления и Split Pos -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="РЕЖИМ DPI-DESYNC" />
                                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                              ItemsSource="{Binding BuilderDesyncModes}" SelectedItem="{Binding BuilderDesyncMode, Mode=TwoWay}"
                                              ToolTip="Метод расщепления пакетов (split2, disorder2, fake...)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="ПОЗИЦИЯ SPLIT-POS" />
                                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                              ItemsSource="{Binding BuilderSplitPositions}" SelectedItem="{Binding BuilderSplitPos, Mode=TwoWay}"
                                              ToolTip="Позиция разделения (midsld - середина SNI, 1, 2, 3...)" />
                                </StackPanel>
                            </Grid>

                            <!-- Fake TLS SNI и TTL -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="ПОДДЕЛЬНЫЙ SNI (FAKE TLS)" />
                                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                              ItemsSource="{Binding BuilderFakeSnis}" SelectedItem="{Binding BuilderFakeSni, Mode=TwoWay}"
                                              ToolTip="Доменное имя, подставляемое в первый фейковый пакет" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource DimText}" Text="TTL (ВРЕМЯ ЖИЗНИ ПАКЕТА)" />
                                    <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,0"
                                              ItemsSource="{Binding BuilderTtls}" SelectedItem="{Binding BuilderTtl, Mode=TwoWay}"
                                              ToolTip="Значение TTL для фейкового пакета (auto или фиксированное число)" />
                                </StackPanel>
                            </Grid>

                            <!-- Fooling метод -->
                            <TextBlock Style="{StaticResource DimText}" Text="FOOLING (МЕТОД ИСКАЖЕНИЯ)" />
                            <ComboBox Style="{StaticResource AppComboBox}" Margin="0,4,0,10"
                                      ItemsSource="{Binding BuilderFoolings}" SelectedItem="{Binding BuilderFooling, Mode=TwoWay}"
                                      ToolTip="Способ сделать фейковый пакет незаметным для сервера (badsum, badseq...)" />

                            <!-- Чекбоксы дополнительных опций -->
                            <TextBlock Style="{StaticResource SectionText}" Text="ДОПОЛНИТЕЛЬНЫЕ МОДУЛИ" Margin="0,6,0,6" />
                            <CheckBox Style="{StaticResource CheckBoxApp}" Content="Игровой UDP фильтр (порты 50000-65535, голос Discord)"
                                      IsChecked="{Binding BuilderUseGameUdp, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,3,0,6" />
                            <CheckBox Style="{StaticResource CheckBoxApp}" Content="Включить multisplit seqovl"
                                      IsChecked="{Binding BuilderUseMultisplit, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,3,0,6" />
                            <CheckBox Style="{StaticResource CheckBoxApp}" Content="Применять списки hostlist (list-general.txt)"
                                      IsChecked="{Binding BuilderUseHostlist, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,3,0,6" />
                            <CheckBox Style="{StaticResource CheckBoxApp}" Content="Применять IP-фильтры ipset (ipset-all.txt)"
                                      IsChecked="{Binding BuilderUseIpSet, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,3,0,6" />
                        </StackPanel>
                    </Border>

                    <!-- ПРАВАЯ КОЛОНКА: Предпросмотр аргументов, тест и сохранение -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionText}" Text="СГЕНЕРИРОВАННЫЕ АРГУМЕНТЫ WINWS" />
                            <Border Style="{StaticResource InnerCard}" Padding="10,8" Margin="0,6,0,12" Background="{DynamicResource ElevatedBrush}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="140">
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding BuilderGeneratedArgsPreview}" TextWrapping="Wrap" FontSize="11" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Style="{StaticResource SectionText}" Text="ДЕЙСТВИЯ И ТЕСТИРОВАНИЕ" />
                            <WrapPanel Margin="0,8,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Content="Протестировать параметры"
                                        Command="{Binding BuilderTestCommand}"
                                        ToolTip="Временно запустить процесс winws с этими параметрами и проверить соединение" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить в каталог" Margin="8,0,0,0"
                                        Command="{Binding BuilderSaveCommand}"
                                        ToolTip="Сохранить эти параметры как собственную стратегию" />
                                <Button Style="{StaticResource GhostButton}" Content="Применить сейчас" Margin="8,0,0,0"
                                        Command="{Binding BuilderApplyCommand}"
                                        ToolTip="Сохранить и сразу запустить постоянный обход с этими параметрами" />
                            </WrapPanel>

                            <!-- Статус тестирования конструктора -->
                            <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="8"
                                    Background="{Binding BuilderTestStatusKey, Converter={StaticResource SoftSeverityBrush}}"
                                    Visibility="{Binding BuilderTestStatus, Converter={StaticResource StringToVis}}">
                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding BuilderTestStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ============================== ВКЛАДКА 3: КОНТРОЛЬНЫЕ АДРЕСА ============================== -->
        <Grid Grid.Row="3" Visibility="{Binding IsTargetsTabVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Заголовок и форма добавления нового контрольного адреса -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionText}" Text="КОНТРОЛЬНЫЕ СЕРВИСЫ И ЭНДПОИНТЫ ДЛЯ ПРОВЕРКИ" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Эти ресурсы проверяются при тестировании любой стратегии. Добавьте свои любимые сервисы, игры или сайты для точной оценки." Margin="0,2,0,10" />

                        <Grid Margin="0,4,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SearchBox}" Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Название (например, Twitch, Spotify, Notion, Discord Voice)" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Text="{Binding NewTargetUrl, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="URL или хост (например, https://twitch.tv или https://open.spotify.com)" Margin="6,0,6,0" />
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Добавить адрес" Margin="6,0,0,0"
                                    Command="{Binding AddTargetCommand}" ToolTip="Добавить сайт в список контрольных проверок" />
                        </Grid>
                    </StackPanel>

                    <!-- Список всех контрольных адресов -->
                    <TextBlock Grid.Row="1" Style="{StaticResource SectionText}" Text="СПИСОК АКТИВНЫХ АДРЕСОВ" Margin="0,6,0,6" />
                    <ListBox Grid.Row="2" Style="{StaticResource PlainListBox}" Background="Transparent"
                             ItemsSource="{Binding TargetEndpoints}"
                             ItemContainerStyle="{StaticResource CompactRowItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}" Margin="0,3,0,3" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Style="{StaticResource CheckBoxApp}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  Command="{Binding DataContext.ToggleTargetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <WrapPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                        Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource DimText}" Text="встроенный" FontSize="10" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource DimText}" Text="{Binding Url}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <WrapPanel Grid.Column="2" VerticalAlignment="Center"
                                                   Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                                    FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                    Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Удалить этот контрольный адрес" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
