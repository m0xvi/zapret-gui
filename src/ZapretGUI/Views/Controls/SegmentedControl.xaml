<UserControl x:Class="ZapretGui.Views.Controls.SegmentedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZapretGui.Views.Controls">
    <Border Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="11" Padding="3">
        <ListBox x:Name="SegmentList" Style="{StaticResource PlainListBox}" Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=local:SegmentedControl}}"
                 SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=local:SegmentedControl}, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource SegmentItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Border>
</UserControl>
