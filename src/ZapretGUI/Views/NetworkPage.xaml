<UserControl x:Class="ZapretGui.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,24" CanContentScroll="False">
        <StackPanel Margin="24,20,20,32" MaxWidth="980">

            <!-- Заголовок -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource DisplayText}" Text="Под мою сеть" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Шесть шагов под вашего провайдера: проверяем каждый и говорим, что поправить." />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{DynamicResource InfoSoftBrush}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource DimText}" Text="{Binding NetworkName, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" />
                </Border>
            </Grid>

            <!-- В «Простом» сценарий не нужен: там одна кнопка -->
            <Border Style="{StaticResource NoticeInfo}" Margin="{DynamicResource CardGap}"
                    Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Сценарий «под мою сеть» — для режима «Эксперт»" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="В «Простом» обход настраивается одной кнопкой на «Главной». Здесь — проверка сети по шагам и точечные правки." />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Content="Включить режим «Эксперт»" Command="{Binding EnableExpertModeCommand}" />
                </Grid>
            </Border>

            <StackPanel Visibility="{Binding IsExpertMode, Converter={StaticResource BoolToVis}}">

                <!-- ============ ШАГИ ============ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionText}" Text="ПРОВЕРКА ПО ШАГАМ" />
                            <Button Style="{StaticResource HelpHint}" VerticalAlignment="Center"
                                    ToolTip="Порядок из docs/SETUP_ORDER.md, шаги 5–6: перехват → порты → таймстемпы → DNS → стек IP. Провайдер и ASN — первый шаг: с ними подбор способа обхода приоритизирует гипотезы."
                                    AutomationProperties.Name="Подсказка: ПРОВЕРКА ПО ШАГАМ" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerCard}" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource Badge}" Width="26" Height="26" Padding="0"
                                                    Background="{Binding Key, Converter={StaticResource SoftSeverityBrush}}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding NumberText}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{Binding Key, Converter={StaticResource SeverityBrush}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WhatText}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,1,0,0" Opacity="0.85" />
                                                <TextBlock Text="{Binding ValueText}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Foreground="{Binding Key, Converter={StaticResource SeverityBrush}}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource CompactGhostButton}" Content="Поправить"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Section, Converter={StaticResource StringToVis}}"
                                                    Command="{Binding DataContext.OpenStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Section}"
                                                    AutomationProperties.Name="Поправить шаг" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Проверить всё по шагам" Command="{Binding CheckAllCommand}"
                                    ToolTip="Пройти шесть проверок подряд и показать, что требует внимания. Ничего в системе не меняет." />
                            <Button Style="{StaticResource GhostButton}" Content="Рабочий стол настройщика →" Margin="8,0,0,0"
                                    Command="{Binding OpenWorkbenchCommand}"
                                    ToolTip="Правка способа обхода, SNI, ipset, DNS и флагов — на рабочем столе (одно место для всех значений)" />
                            <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" Width="120" Margin="12,8,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{Binding StatusKey, Converter={StaticResource SeverityBrush}}"
                                   Text="{Binding StatusText, Mode=OneWay}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- ============ ПРОВАЙДЕР И ASN ============ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionText}" Text="ПРОВАЙДЕР И ASN" />
                            <Button Style="{StaticResource HelpHint}" VerticalAlignment="Center"
                                    ToolTip="Определяется по внешнему IP. Запрос идёт к сервисам ipwho.is → ipinfo.io → api.ipify.org по очереди: если сеть режет один, пробуется следующий. Если ничего не открылось — введите вручную, это тоже полноценный источник."
                                    AutomationProperties.Name="Подсказка: ПРОВАЙДЕР И ASN" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource DimText}" Text="Провайдер" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,5,0,0" Text="{Binding ProviderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Имя провайдера" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource DimText}" Text="ASN" />
                                <TextBox Style="{StaticResource InputBox}" Margin="0,5,0,0" Text="{Binding ProviderAsn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ASN провайдера" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="Определить" Command="{Binding DetectProviderCommand}"
                                        ToolTip="Спросить у внешних сервисов, кто ваш провайдер и какой у него ASN" />
                                <Button Style="{StaticResource GhostButton}" Content="Сохранить" Margin="8,0,0,0" Command="{Binding SaveProviderCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ProviderSourceText, Mode=OneWay}" />
                        <Border Style="{StaticResource NoticeSuccess}" Margin="0,8,0,0"
                                Visibility="{Binding HasDetected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Text="{Binding DetectedText, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ ТАЙМСТЕМПЫ ============ -->
                <Border Style="{StaticResource Card}" Margin="{DynamicResource CardGap}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionText}" Text="TCP-ТАЙМСТЕМПЫ" />
                            <Button Style="{StaticResource HelpHint}" VerticalAlignment="Center"
                                    ToolTip="Метки времени TCP помогают обходу на части провайдеров. Windows иногда оставляет их выключенными — кнопка включает их через netsh и сразу перепроверяет результат."
                                    AutomationProperties.Name="Подсказка: TCP-ТАЙМСТЕМПЫ" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource DimText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Состояние показано в шаге 4 выше. Если там «выключены» — нажмите «Включить»: приложение выполнит netsh, дождётся ответа и перечитает состояние." />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="Включить и проверить" Command="{Binding FixTimestampsCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Обновить проверки" Margin="8,0,0,0" Command="{Binding CheckAllCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
