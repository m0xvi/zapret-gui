<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ ТЁМНАЯ ТЕМА ============================ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <CornerRadius x:Key="CardRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlRadius">9</CornerRadius>

    <!-- Фон -->
    <SolidColorBrush x:Key="BgBrush" Color="#0F1116" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#14171F" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#14171F" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A1E28" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#202633" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#232833" />
    <SolidColorBrush x:Key="BorderBrush" Color="#272E3A" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#343D4D" />

    <!-- Текст -->
    <SolidColorBrush x:Key="TextBrush" Color="#EAEDF3" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#98A2B3" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#6B7484" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="#0F1116" />

    <!-- Акцент -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DF6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6699F8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3E7BE0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1C2A44" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Статусы -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DD68C" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#16301F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B445" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#332718" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F2555A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#381E21" />
    <SolidColorBrush x:Key="InfoBrush" Color="#5FA8FF" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#1C2A44" />
    <SolidColorBrush x:Key="MutedBrush" Color="#7C8698" />

    <!-- Прочее -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#39424F" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4A5563" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2A3550" />
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#232833" />
    <SolidColorBrush x:Key="WindowCloseHoverBrush" Color="#E1443C" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#000000" />
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.5</sys:Double>
</ResourceDictionary>
